                "testReadWithSorting",
                "testCreate",
                "testUpdate",
                "testDelete",
                "testGetItems",
                "testUpdateitems",
                "testDeleteitem"
            ]
        },
        {
            "test": "SuppliersTest.cls",
            "cases": [
                "testRead",
                "testReadWithFilter",
                "testReadWithSorting",
                "testCreate",
                "testUpdate",
                "testDelete",
                "testGetSuppliers",
                "testUpdateSuppliers",
