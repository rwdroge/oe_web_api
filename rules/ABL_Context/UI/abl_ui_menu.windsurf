# ABL UI Menu Reference
# Menu components and management for ABL UI

[metadata]
name = "ABL UI Menu Reference"
version = "1.0.0"
description = "Reference for ABL UI menus and menu items"
category = "ui"

[syntax_elements]
# ABL UI menu elements

"MENU" = {
  type = "container",
  description = "Container for menu items",
  syntax = "DEFINE MENU menu-name [options]",
  example = "DEFINE MENU mMain MENUBAR."
}

"DEFINE MENU" = {
  type = "statement",
  description = "Defines a menu object",
  syntax = "DEFINE MENU menu-name [options]",
  example = "DEFINE MENU mFile."
}

"MENU-ITEM" = {
  type = "element",
  description = "An item in a menu",
  syntax = "MENU-ITEM item-name [options]",
  example = "MENU-ITEM miOpen LABEL \"&Open\"."
}

"SUB-MENU" = {
  type = "element",
  description = "A submenu within a menu",
  syntax = "SUB-MENU item-name [options]",
  example = "SUB-MENU smRecent LABEL \"Recent Files\"."
}

"RULE" = {
  type = "element",
  description = "A separator line in a menu",
  syntax = "RULE",
  example = "RULE"
}

"MENUBAR" = {
  type = "attribute",
  description = "Specifies a menu as a menubar",
  syntax = "MENUBAR",
  example = "DEFINE MENU mMain MENUBAR."
}

"LABEL" = {
  type = "attribute",
  description = "Sets the display label for a menu item",
  syntax = "LABEL \"text\"",
  example = "LABEL \"&Open\""
}

"ACCELERATOR" = {
  type = "attribute",
  description = "Sets a keyboard shortcut for a menu item",
  syntax = "ACCELERATOR \"key\"",
  example = "ACCELERATOR \"CTRL-O\""
}

"TOGGLE-BOX" = {
  type = "attribute",
  description = "Shows a toggle box next to a menu item",
  syntax = "TOGGLE-BOX",
  example = "TOGGLE-BOX"
}

"RADIO-BOX" = {
  type = "attribute",
  description = "Shows a radio button next to a menu item",
  syntax = "RADIO-BOX",
  example = "RADIO-BOX"
}

"CHECKED" = {
  type = "attribute",
  description = "Sets a toggle or radio box item as checked",
  syntax = "CHECKED",
  example = "TOGGLE-BOX CHECKED"
}

"SENSITIVE" = {
  type = "property",
  description = "Controls if a menu item is enabled",
  syntax = "SENSITIVE",
  example = "miSave:SENSITIVE = FALSE."
}

"APPLY" = {
  type = "statement",
  description = "Triggers a menu event",
  syntax = "APPLY \"CHOOSE\" TO menu-item",
  example = "APPLY \"CHOOSE\" TO miOpen."
}

"ON CHOOSE" = {
  type = "event",
  description = "Handles menu item selection",
  syntax = "ON CHOOSE OF menu-item DO: ... END.",
  example = "ON CHOOSE OF miOpen DO: RUN OpenFile. END."
}

[best_practices]
# Best practices for ABL UI menus

"menu_organization" = {
  title = "Menu Organization Best Practices",
  description = """
When organizing menus, follow these best practices:

1. Group related commands in the same menu
2. Use standard menu names (File, Edit, View, etc.)
3. Use hierarchical menus for complex applications
4. Provide keyboard accelerators for common operations
5. Use consistent menu structure across your application

```abl
/* Good practice - well-organized menu structure */
DEFINE MENU mMain MENUBAR.

/* File Menu */
MENU-ITEM miFile LABEL "&File" SUB-MENU mFile.
DEFINE MENU mFile.
MENU-ITEM miNew LABEL "&New" ACCELERATOR "CTRL-N".
MENU-ITEM miOpen LABEL "&Open..." ACCELERATOR "CTRL-O".
MENU-ITEM miSave LABEL "&Save" ACCELERATOR "CTRL-S".
MENU-ITEM miSaveAs LABEL "Save &As...".
RULE.
MENU-ITEM miPrint LABEL "&Print..." ACCELERATOR "CTRL-P".
RULE.
MENU-ITEM miExit LABEL "E&xit" ACCELERATOR "ALT-F4".

/* Edit Menu */
MENU-ITEM miEdit LABEL "&Edit" SUB-MENU mEdit.
DEFINE MENU mEdit.
MENU-ITEM miUndo LABEL "&Undo" ACCELERATOR "CTRL-Z".
MENU-ITEM miRedo LABEL "&Redo" ACCELERATOR "CTRL-Y".
RULE.
MENU-ITEM miCut LABEL "Cu&t" ACCELERATOR "CTRL-X".
MENU-ITEM miCopy LABEL "&Copy" ACCELERATOR "CTRL-C".
MENU-ITEM miPaste LABEL "&Paste" ACCELERATOR "CTRL-V".
MENU-ITEM miDelete LABEL "&Delete" ACCELERATOR "DELETE".
RULE.
MENU-ITEM miSelectAll LABEL "Select &All" ACCELERATOR "CTRL-A".

/* View Menu */
MENU-ITEM miView LABEL "&View" SUB-MENU mView.
DEFINE MENU mView.
MENU-ITEM miZoomIn LABEL "Zoom &In" ACCELERATOR "CTRL-+".
MENU-ITEM miZoomOut LABEL "Zoom &Out" ACCELERATOR "CTRL--".
MENU-ITEM miZoomReset LABEL "&Reset Zoom" ACCELERATOR "CTRL-0".
RULE.
MENU-ITEM miToolbar LABEL "&Toolbar" TOGGLE-BOX CHECKED.
MENU-ITEM miStatusBar LABEL "&Status Bar" TOGGLE-BOX CHECKED.
```
"""
}

"menu_usability" = {
  title = "Menu Usability Best Practices",
  description = """
When designing menus for usability, follow these best practices:

1. Use consistent naming and placement
2. Add access keys (using &) for keyboard navigation
3. Group items logically with separators (RULE)
4. Disable (rather than hide) items that are temporarily unavailable
5. Use accelerators for commonly used functions

```abl
/* Good practice - usable menu design */
/* Define a procedure to update menu sensitivity */
PROCEDURE UpdateMenuState:
    DEFINE INPUT PARAMETER plFileOpen AS LOGICAL NO-UNDO.
    DEFINE INPUT PARAMETER plHasSelection AS LOGICAL NO-UNDO.
    DEFINE INPUT PARAMETER plCanUndo AS LOGICAL NO-UNDO.
    DEFINE INPUT PARAMETER plCanRedo AS LOGICAL NO-UNDO.
    
    /* File menu items */
    miSave:SENSITIVE = plFileOpen.
    miSaveAs:SENSITIVE = plFileOpen.
    miPrint:SENSITIVE = plFileOpen.
    
    /* Edit menu items */
    miUndo:SENSITIVE = plCanUndo.
    miRedo:SENSITIVE = plCanRedo.
    miCut:SENSITIVE = plHasSelection.
    miCopy:SENSITIVE = plHasSelection.
    miDelete:SENSITIVE = plHasSelection.
    
    /* Keep menu items visible but disabled when not applicable */
END PROCEDURE.

/* Example use */
RUN UpdateMenuState(TRUE, FALSE, TRUE, FALSE).
```
"""
}

"menu_integration" = {
  title = "Menu Integration Best Practices",
  description = """
When integrating menus with your application, follow these best practices:

1. Associate menus with appropriate windows and frames
2. Handle menu events consistently
3. Keep menu state in sync with application state
4. Provide visual feedback for menu operations
5. Consider context menus for context-specific actions

```abl
/* Good practice - context menu implementation */
PROCEDURE SetupContextMenus:
    /* Define a context menu for text editing */
    DEFINE MENU mTextContext.
    MENU-ITEM miContextCut LABEL "Cu&t" ACCELERATOR "CTRL-X".
    MENU-ITEM miContextCopy LABEL "&Copy" ACCELERATOR "CTRL-C".
    MENU-ITEM miContextPaste LABEL "&Paste" ACCELERATOR "CTRL-V".
    RULE.
    MENU-ITEM miContextSelectAll LABEL "Select &All" ACCELERATOR "CTRL-A".
    
    /* Define a context menu for list items */
    DEFINE MENU mListContext.
    MENU-ITEM miListNew LABEL "&New..." ACCELERATOR "INS".
    MENU-ITEM miListEdit LABEL "&Edit..." ACCELERATOR "ENTER".
    MENU-ITEM miListDelete LABEL "&Delete" ACCELERATOR "DEL".
    
    /* Assign context menu to widgets */
    edText:POPUP-MENU = mTextContext.
    lstItems:POPUP-MENU = mListContext.
    
    /* Handle context menu events */
    ON CHOOSE OF miContextCut DO:
        /* Cut text */
        RUN CutText(edText:HANDLE).
    END.
    
    ON CHOOSE OF miContextCopy DO:
        /* Copy text */
        RUN CopyText(edText:HANDLE).
    END.
    
    ON CHOOSE OF miListEdit DO:
        /* Edit selected item */
        RUN EditSelectedItem(lstItems:HANDLE).
    END.
END PROCEDURE.
```
"""
}

[examples]
# Examples of ABL UI menus

"basic_menu_example" = {
  title = "Basic Menu Example",
  description = "Example of a basic menu system in ABL",
  code = """
/* Basic menu example */
PROCEDURE BasicMenus:
    DEFINE VARIABLE wMainWindow AS HANDLE NO-UNDO.
    
    /* Create a window */
    CREATE WINDOW wMainWindow
        ASSIGN
            TITLE = "Menu Example"
            HEIGHT = 30
            WIDTH = 80.
    
    /* Define the main menu bar */
    DEFINE MENU mMain MENUBAR.
    
    /* Define File menu */
    MENU-ITEM miFile LABEL "&File" SUB-MENU mFile.
    DEFINE MENU mFile.
    MENU-ITEM miNew LABEL "&New" ACCELERATOR "CTRL-N".
    MENU-ITEM miOpen LABEL "&Open..." ACCELERATOR "CTRL-O".
    MENU-ITEM miSave LABEL "&Save" ACCELERATOR "CTRL-S".
    RULE.
    MENU-ITEM miExit LABEL "E&xit" ACCELERATOR "ALT-F4".
    
    /* Define Edit menu */
    MENU-ITEM miEdit LABEL "&Edit" SUB-MENU mEdit.
    DEFINE MENU mEdit.
    MENU-ITEM miCut LABEL "Cu&t" ACCELERATOR "CTRL-X".
    MENU-ITEM miCopy LABEL "&Copy" ACCELERATOR "CTRL-C".
    MENU-ITEM miPaste LABEL "&Paste" ACCELERATOR "CTRL-V".
    
    /* Define Help menu */
    MENU-ITEM miHelp LABEL "&Help" SUB-MENU mHelp.
    DEFINE MENU mHelp.
    MENU-ITEM miAbout LABEL "&About".
    
    /* Assign menu to window */
    wMainWindow:MENU = mMain.
    
    /* Handle menu events */
    ON CHOOSE OF miNew DO:
        MESSAGE "New command selected."
            VIEW-AS ALERT-BOX INFO.
    END.
    
    ON CHOOSE OF miOpen DO:
        MESSAGE "Open command selected."
            VIEW-AS ALERT-BOX INFO.
    END.
    
    ON CHOOSE OF miSave DO:
        MESSAGE "Save command selected."
            VIEW-AS ALERT-BOX INFO.
    END.
    
    ON CHOOSE OF miExit DO:
        APPLY "CLOSE" TO wMainWindow.
    END.
    
    ON CHOOSE OF miCut DO:
        MESSAGE "Cut command selected."
            VIEW-AS ALERT-BOX INFO.
    END.
    
    ON CHOOSE OF miCopy DO:
        MESSAGE "Copy command selected."
            VIEW-AS ALERT-BOX INFO.
    END.
    
    ON CHOOSE OF miPaste DO:
        MESSAGE "Paste command selected."
            VIEW-AS ALERT-BOX INFO.
    END.
    
    ON CHOOSE OF miAbout DO:
        MESSAGE "Menu Example App~nVersion 1.0~n(C) 2023"
            VIEW-AS ALERT-BOX INFO.
    END.
    
    /* Display window */
    wMainWindow:VISIBLE = TRUE.
    
    /* Wait for window close */
    WAIT-FOR "WINDOW-CLOSE" OF wMainWindow.
END PROCEDURE.

/* Usage */
RUN BasicMenus.
"""
}

"context_menu_example" = {
  title = "Context Menu Example",
  description = "Example of context (popup) menus in ABL",
  code = """
/* Context menu example */
PROCEDURE ContextMenus:
    /* Define variables */
    DEFINE VARIABLE edText AS CHARACTER VIEW-AS EDITOR.
    DEFINE VARIABLE lstItems AS CHARACTER VIEW-AS SELECTION-LIST MULTIPLE.
    
    /* Define frame */
    DEFINE FRAME frContextMenu
        HEADER "Context Menu Example"
        SKIP(1)
        "Text Editor (right-click for menu):" VIEW-AS TEXT SKIP(0)
        edText VIEW-AS EDITOR
            SIZE 60 BY 10
            SCROLLBAR-VERTICAL
            SCROLLBAR-HORIZONTAL SKIP(1)
        "List (right-click for menu):" VIEW-AS TEXT SKIP(0)
        lstItems VIEW-AS SELECTION-LIST
            MULTIPLE
            SORT
            SIZE 60 BY 10 SKIP(1)
        btnClose LABEL "Close" SIZE 10 BY 1
        WITH CENTERED
        SIZE 70 BY 25.
    
    /* Define editor context menu */
    DEFINE MENU mEditorContext.
    MENU-ITEM miEdCut LABEL "Cu&t" ACCELERATOR "CTRL-X".
    MENU-ITEM miEdCopy LABEL "&Copy" ACCELERATOR "CTRL-C".
    MENU-ITEM miEdPaste LABEL "&Paste" ACCELERATOR "CTRL-V".
    RULE.
    MENU-ITEM miEdSelectAll LABEL "Select &All" ACCELERATOR "CTRL-A".
    RULE.
    MENU-ITEM miEdUppercase LABEL "UPPERCASE".
    MENU-ITEM miEdLowercase LABEL "lowercase".
    
    /* Define list context menu */
    DEFINE MENU mListContext.
    MENU-ITEM miListAdd LABEL "&Add Item..." ACCELERATOR "INS".
    MENU-ITEM miListRemove LABEL "&Remove Item" ACCELERATOR "DEL".
    RULE.
    MENU-ITEM miListClear LABEL "Clear &All".
    RULE.
    MENU-ITEM miListSort LABEL "&Sort" SUB-MENU mSort.
    
    /* Define sort submenu */
    DEFINE MENU mSort.
    MENU-ITEM miSortAsc LABEL "&Ascending" RADIO-BOX CHECKED.
    MENU-ITEM miSortDesc LABEL "&Descending" RADIO-BOX.
    
    /* Assign context menus */
    edText:POPUP-MENU = mEditorContext.
    lstItems:POPUP-MENU = mListContext.
    
    /* Editor context menu events */
    ON CHOOSE OF miEdCut DO:
        MESSAGE "Cut text"
            VIEW-AS ALERT-BOX INFO.
    END.
    
    ON CHOOSE OF miEdCopy DO:
        MESSAGE "Copy text"
            VIEW-AS ALERT-BOX INFO.
    END.
    
    ON CHOOSE OF miEdPaste DO:
        MESSAGE "Paste text"
            VIEW-AS ALERT-BOX INFO.
    END.
    
    ON CHOOSE OF miEdSelectAll DO:
        /* Select all text */
        edText:SET-SELECTION(1, 1, edText:NUM-LINES, 
                            LENGTH(edText:TEXT-LINE(edText:NUM-LINES)) + 1).
    END.
    
    ON CHOOSE OF miEdUppercase DO:
        /* Convert selection to uppercase */
        DEFINE VARIABLE cSelection AS CHARACTER NO-UNDO.
        
        cSelection = edText:SELECTION-TEXT.
        IF cSelection > "" THEN
            edText:REPLACE-SELECTION-TEXT(CAPS(cSelection)).
    END.
    
    ON CHOOSE OF miEdLowercase DO:
        /* Convert selection to lowercase */
        DEFINE VARIABLE cSelection AS CHARACTER NO-UNDO.
        
        cSelection = edText:SELECTION-TEXT.
        IF cSelection > "" THEN
            edText:REPLACE-SELECTION-TEXT(LC(cSelection)).
    END.
    
    /* List context menu events */
    ON CHOOSE OF miListAdd DO:
        DEFINE VARIABLE cNewItem AS CHARACTER NO-UNDO.
        
        /* Prompt for new item */
        cNewItem = "".
        MESSAGE "Enter new item:"
            UPDATE cNewItem
            VIEW-AS ALERT-BOX QUESTION.
        
        IF cNewItem > "" THEN
            lstItems:ADD-ITEM(cNewItem).
    END.
    
    ON CHOOSE OF miListRemove DO:
        DEFINE VARIABLE cSelected AS CHARACTER NO-UNDO.
        DEFINE VARIABLE iItem AS INTEGER NO-UNDO.
        
        /* Get selected items */
        cSelected = lstItems:SELECTED-ITEMS.
        
        IF cSelected = "" THEN DO:
            MESSAGE "No items selected."
                VIEW-AS ALERT-BOX INFO.
            RETURN.
        END.
        
        /* Remove selected items */
        DO iItem = NUM-ENTRIES(cSelected) TO 1 BY -1:
            lstItems:DELETE-ITEM(lstItems:LOOKUP(ENTRY(iItem, cSelected))).
        END.
    END.
    
    ON CHOOSE OF miListClear DO:
        /* Clear all items */
        lstItems:LIST-ITEMS = "".
    END.
    
    ON CHOOSE OF miSortAsc DO:
        /* Sort ascending */
        DEFINE VARIABLE cItems AS CHARACTER NO-UNDO.
        DEFINE VARIABLE iItem AS INTEGER NO-UNDO.
        DEFINE VARIABLE cItem AS CHARACTER NO-UNDO.
        DEFINE VARIABLE cSorted AS CHARACTER NO-UNDO.
        
        /* Get items */
        cItems = lstItems:LIST-ITEMS.
        
        /* Sort items */
        DO iItem = 1 TO NUM-ENTRIES(cItems):
            cItem = ENTRY(iItem, cItems).
            
            /* Find position in sorted list */
            DEFINE VARIABLE iPos AS INTEGER INITIAL 1 NO-UNDO.
            DEFINE VARIABLE lAdded AS LOGICAL INITIAL FALSE NO-UNDO.
            
            DO WHILE iPos <= NUM-ENTRIES(cSorted) AND NOT lAdded:
                IF cItem < ENTRY(iPos, cSorted) THEN DO:
                    /* Insert at this position */
                    IF iPos = 1 THEN
                        cSorted = cItem + "," + cSorted.
                    ELSE IF iPos > NUM-ENTRIES(cSorted) THEN
                        cSorted = cSorted + "," + cItem.
                    ELSE
                        cSorted = SUBSTRING(cSorted, 1, R-INDEX(cSorted, ",", iPos - 1)) +
                                 cItem + "," +
                                 SUBSTRING(cSorted, R-INDEX(cSorted, ",", iPos - 1) + 1).
                    
                    lAdded = TRUE.
                END.
                
                iPos = iPos + 1.
            END.
            
            /* Add to end if not added */
            IF NOT lAdded THEN
                cSorted = (IF cSorted = "" THEN "" ELSE cSorted + ",") + cItem.
        END.
        
        /* Update list */
        lstItems:LIST-ITEMS = cSorted.
        
        /* Update menu */
        miSortAsc:CHECKED = TRUE.
        miSortDesc:CHECKED = FALSE.
    END.
    
    ON CHOOSE OF miSortDesc DO:
        /* Sort descending */
        DEFINE VARIABLE cItems AS CHARACTER NO-UNDO.
        DEFINE VARIABLE iItem AS INTEGER NO-UNDO.
        DEFINE VARIABLE cItem AS CHARACTER NO-UNDO.
        DEFINE VARIABLE cSorted AS CHARACTER NO-UNDO.
        
        /* Get items */
        cItems = lstItems:LIST-ITEMS.
        
        /* Sort items */
        DO iItem = 1 TO NUM-ENTRIES(cItems):
            cItem = ENTRY(iItem, cItems).
            
            /* Find position in sorted list */
            DEFINE VARIABLE iPos AS INTEGER INITIAL 1 NO-UNDO.
            DEFINE VARIABLE lAdded AS LOGICAL INITIAL FALSE NO-UNDO.
            
            DO WHILE iPos <= NUM-ENTRIES(cSorted) AND NOT lAdded:
                IF cItem > ENTRY(iPos, cSorted) THEN DO:
                    /* Insert at this position */
                    IF iPos = 1 THEN
                        cSorted = cItem + "," + cSorted.
                    ELSE IF iPos > NUM-ENTRIES(cSorted) THEN
                        cSorted = cSorted + "," + cItem.
                    ELSE
                        cSorted = SUBSTRING(cSorted, 1, R-INDEX(cSorted, ",", iPos - 1)) +
                                 cItem + "," +
                                 SUBSTRING(cSorted, R-INDEX(cSorted, ",", iPos - 1) + 1).
                    
                    lAdded = TRUE.
                END.
                
                iPos = iPos + 1.
            END.
            
            /* Add to end if not added */
            IF NOT lAdded THEN
                cSorted = (IF cSorted = "" THEN "" ELSE cSorted + ",") + cItem.
        END.
        
        /* Update list */
        lstItems:LIST-ITEMS = cSorted.
        
        /* Update menu */
        miSortAsc:CHECKED = FALSE.
        miSortDesc:CHECKED = TRUE.
    END.
    
    /* Close button */
    ON CHOOSE OF btnClose DO:
        APPLY "CLOSE" TO FRAME frContextMenu.
    END.
    
    /* Set initial values */
    edText:SCREEN-VALUE = "This is a sample text.~n" +
                        "Right-click to see the context menu.~n~n" +
                        "Select some text to enable more options.".
    
    lstItems:LIST-ITEMS = "Apple,Banana,Cherry,Date,Elderberry," +
                        "Fig,Grape,Honeydew,Kiwi,Lemon".
    
    /* Display and enable */
    DISPLAY edText lstItems WITH FRAME frContextMenu.
    ENABLE edText lstItems btnClose WITH FRAME frContextMenu.
    
    /* Wait for frame close */
    WAIT-FOR CLOSE OF FRAME frContextMenu.
END PROCEDURE.

/* Usage */
RUN ContextMenus.
"""
}
