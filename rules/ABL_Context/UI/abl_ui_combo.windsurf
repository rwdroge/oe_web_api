# ABL UI Combo-Box Reference
# Combo-box widget for ABL UI

[metadata]
name = "ABL UI Combo-Box Reference"
version = "1.0.0"
description = "Reference for ABL UI combo-box widget and best practices"
category = "ui"

[syntax_elements]
# ABL UI combo-box elements

"COMBO-BOX" = {
  type = "widget",
  description = "Drop-down list widget with optional input field",
  syntax = "field VIEW-AS COMBO-BOX [options]",
  example = "Customer.State VIEW-AS COMBO-BOX."
}

"LIST-ITEMS" = {
  type = "attribute",
  description = "Defines the items in a combo-box",
  syntax = "LIST-ITEMS \"item1\", \"item2\", ...",
  example = "LIST-ITEMS \"CA\", \"NY\", \"TX\", \"FL\""
}

"INNER-LINES" = {
  type = "attribute",
  description = "Specifies the number of visible items in the drop-down list",
  syntax = "INNER-LINES lines",
  example = "INNER-LINES 5"
}

"DROP-DOWN" = {
  type = "attribute",
  description = "Creates a drop-down combo-box",
  syntax = "DROP-DOWN",
  example = "VIEW-AS COMBO-BOX DROP-DOWN"
}

"DROP-DOWN-LIST" = {
  type = "attribute",
  description = "Creates a drop-down list without an input field",
  syntax = "DROP-DOWN-LIST",
  example = "VIEW-AS COMBO-BOX DROP-DOWN-LIST"
}

"SORT" = {
  type = "attribute",
  description = "Sorts the items in a combo-box",
  syntax = "SORT",
  example = "VIEW-AS COMBO-BOX SORT"
}

"SIZE" = {
  type = "attribute",
  description = "Specifies the size of a combo-box",
  syntax = "SIZE width BY height",
  example = "VIEW-AS COMBO-BOX SIZE 30 BY 1"
}

"TOOLTIP" = {
  type = "attribute",
  description = "Adds a tooltip to a combo-box",
  syntax = "TOOLTIP \"tooltip\"",
  example = "VIEW-AS COMBO-BOX TOOLTIP \"Select a state\""
}

"SENSITIVE" = {
  type = "attribute",
  description = "Makes a combo-box sensitive to user interaction",
  syntax = "SENSITIVE",
  example = "VIEW-AS COMBO-BOX SENSITIVE"
}

"SCREEN-VALUE" = {
  type = "property",
  description = "Gets or sets the screen value of a combo-box",
  syntax = "widget-handle:SCREEN-VALUE",
  example = "var character cState = cmbState:SCREEN-VALUE."
}

"VALUE-CHANGED" = {
  type = "event",
  description = "Event triggered when a combo-box value changes",
  syntax = "ON VALUE-CHANGED OF widget DO:\n    statements\nEND.",
  example = "ON VALUE-CHANGED OF cmbState DO:\n    MESSAGE \"State changed\".\nEND."
}

"ADD-ITEM" = {
  type = "method",
  description = "Adds an item to a combo-box",
  syntax = "widget-handle:ADD-ITEM(\"item\"[, position])",
  example = "cmbState:ADD-ITEM(\"CA\")."
}

"DELETE-ITEM" = {
  type = "method",
  description = "Deletes an item from a combo-box",
  syntax = "widget-handle:DELETE-ITEM(position)",
  example = "cmbState:DELETE-ITEM(1)."
}

"NUM-ITEMS" = {
  type = "property",
  description = "Gets the number of items in a combo-box",
  syntax = "widget-handle:NUM-ITEMS",
  example = "var integer iCount = cmbState:NUM-ITEMS."
}

"FIND-ITEM" = {
  type = "method",
  description = "Finds an item in a combo-box",
  syntax = "widget-handle:FIND-ITEM(\"item\")",
  example = "var integer iPos = cmbState:FIND-ITEM(\"CA\")."
}

"LIST-ITEM-PAIRS" = {
  type = "attribute",
  description = "Defines item-value pairs in a combo-box",
  syntax = "LIST-ITEM-PAIRS \"label1\", \"value1\", \"label2\", \"value2\", ...",
  example = "LIST-ITEM-PAIRS \"California\", \"CA\", \"New York\", \"NY\""
}

[best_practices]
# Best practices for ABL UI combo-boxes

"combo_naming" = {
  title = "Combo-Box Naming Conventions",
  description = """
When naming combo-box widgets, follow these best practices:

1. Use the 'cmb' prefix for combo-box widgets
2. Use descriptive names that indicate the combo-box's purpose
3. Use consistent naming conventions across the application
4. Follow camelCase or PascalCase naming

```abl
/* Good practice */
DEFINE VARIABLE cmbState AS CHARACTER VIEW-AS COMBO-BOX.
DEFINE VARIABLE cmbCountry AS CHARACTER VIEW-AS COMBO-BOX.
DEFINE VARIABLE cmbCategory AS CHARACTER VIEW-AS COMBO-BOX.
```
"""
}

"combo_layout" = {
  title = "Combo-Box Layout Best Practices",
  description = """
When laying out combo-box widgets, follow these best practices:

1. Use consistent sizing for similar combo-boxes
2. Use DROP-DOWN for editable combo-boxes
3. Use DROP-DOWN-LIST for selection-only combo-boxes
4. Set appropriate INNER-LINES based on the number of items
5. Use SORT for alphabetical lists

```abl
/* Good practice */
DEFINE VARIABLE cmbState AS CHARACTER 
    VIEW-AS COMBO-BOX 
    DROP-DOWN-LIST
    INNER-LINES 10
    SORT
    LIST-ITEMS "AL", "AK", "AZ", "AR", "CA", "CO", "CT"
    SIZE 30 BY 1.
```
"""
}

"combo_data" = {
  title = "Combo-Box Data Best Practices",
  description = """
When populating combo-box widgets, follow these best practices:

1. Use LIST-ITEMS for simple lists
2. Use LIST-ITEM-PAIRS for label-value pairs
3. Use ADD-ITEM for dynamic population
4. Sort items for better usability
5. Include a default or blank item when appropriate

```abl
/* Static list with labels and values */
DEFINE VARIABLE cmbPayment AS CHARACTER
    VIEW-AS COMBO-BOX
    DROP-DOWN-LIST
    INNER-LINES 5
    LIST-ITEM-PAIRS 
        "Credit Card", "CC",
        "Debit Card", "DC",
        "PayPal", "PP",
        "Bank Transfer", "BT",
        "Cash", "CA"
    SIZE 30 BY 1.

/* Dynamic population */
PROCEDURE PopulateCustomers:
    DEFINE VARIABLE cmbCustomer AS CHARACTER VIEW-AS COMBO-BOX.
    
    /* Clear existing items */
    DO WHILE cmbCustomer:NUM-ITEMS > 0:
        cmbCustomer:DELETE-ITEM(1).
    END.
    
    /* Add blank item */
    cmbCustomer:ADD-ITEM("-- Select Customer --").
    
    /* Add customers from database */
    FOR EACH Customer NO-LOCK:
        cmbCustomer:ADD-ITEM(Customer.Name + " (" + STRING(Customer.CustNum) + ")").
    END.
END PROCEDURE.
```
"""
}

"combo_behavior" = {
  title = "Combo-Box Behavior Best Practices",
  description = """
When defining combo-box behavior, follow these best practices:

1. Use ON VALUE-CHANGED for immediate actions
2. Set appropriate default values
3. Validate user input for editable combo-boxes
4. Use TOOLTIP for additional information
5. Enable/disable combo-boxes based on context

```abl
/* Good practice */
DEFINE VARIABLE cmbState AS CHARACTER
    VIEW-AS COMBO-BOX
    DROP-DOWN-LIST
    INNER-LINES 10
    SORT
    LIST-ITEMS "AL", "AK", "AZ", "AR", "CA", "CO", "CT"
    TOOLTIP "Select a state"
    SIZE 30 BY 1.

/* Combo-box behavior */
ON VALUE-CHANGED OF cmbState DO:
    var character cState = cmbState:SCREEN-VALUE.
    
    /* Load cities for selected state */
    RUN LoadCities(cState).
END.
```
"""
}

[examples]
# Examples of ABL UI combo-boxes

"basic_combo_example" = {
  title = "Basic Combo-Box Example",
  description = "Example of basic combo-box usage in ABL",
  code = """
/* Basic combo-box example */
PROCEDURE BasicCombo:
    /* Define variables */
    DEFINE VARIABLE cmbState AS CHARACTER NO-UNDO.
    DEFINE VARIABLE cmbPayment AS CHARACTER NO-UNDO.
    
    /* Define frame */
    DEFINE FRAME frCombo
        HEADER "Combo-Box Example"
        SKIP(1)
        "State:" VIEW-AS TEXT SKIP(0)
        cmbState VIEW-AS COMBO-BOX
            DROP-DOWN-LIST
            INNER-LINES 10
            SORT
            LIST-ITEMS "AL", "AK", "AZ", "AR", "CA", "CO", "CT", "DE", "FL", "GA"
            SIZE 30 BY 1 SKIP(1)
        "Payment Method:" VIEW-AS TEXT SKIP(0)
        cmbPayment VIEW-AS COMBO-BOX
            DROP-DOWN-LIST
            INNER-LINES 5
            LIST-ITEM-PAIRS 
                "Credit Card", "CC",
                "Debit Card", "DC",
                "PayPal", "PP",
                "Bank Transfer", "BT",
                "Cash", "CA"
            SIZE 30 BY 1 SKIP(1)
        btnOK LABEL "OK" SIZE 10 BY 1
        WITH CENTERED
        SIZE 50 BY 10.
    
    /* Button trigger */
    ON CHOOSE OF btnOK DO:
        var character cState = cmbState:SCREEN-VALUE.
        var character cPayment = cmbPayment:SCREEN-VALUE.
        var character cPaymentDesc = "".
        
        /* Get payment description */
        CASE cPayment:
            WHEN "CC" THEN cPaymentDesc = "Credit Card".
            WHEN "DC" THEN cPaymentDesc = "Debit Card".
            WHEN "PP" THEN cPaymentDesc = "PayPal".
            WHEN "BT" THEN cPaymentDesc = "Bank Transfer".
            WHEN "CA" THEN cPaymentDesc = "Cash".
        END CASE.
        
        MESSAGE "State: " + cState + "~nPayment Method: " + cPaymentDesc
            VIEW-AS ALERT-BOX INFO.
    END.
    
    /* Display frame */
    DISPLAY WITH FRAME frCombo.
    
    /* Initialize values */
    cmbState:SCREEN-VALUE = "CA".
    cmbPayment:SCREEN-VALUE = "CC".
    
    /* Enable fields */
    ENABLE cmbState cmbPayment btnOK WITH FRAME frCombo.
    
    /* Wait for button click */
    WAIT-FOR CHOOSE OF btnOK.
END PROCEDURE.

/* Usage */
RUN BasicCombo.
"""
}

"dependent_combo_example" = {
  title = "Dependent Combo-Box Example",
  description = "Example of dependent combo-boxes in ABL",
  code = """
/* Dependent combo-box example */
PROCEDURE DependentCombo:
    /* Define variables */
    DEFINE VARIABLE cmbCountry AS CHARACTER NO-UNDO.
    DEFINE VARIABLE cmbState AS CHARACTER NO-UNDO.
    
    /* Define frame */
    DEFINE FRAME frLocation
        HEADER "Location Selection"
        SKIP(1)
        "Country:" VIEW-AS TEXT SKIP(0)
        cmbCountry VIEW-AS COMBO-BOX
            DROP-DOWN-LIST
            INNER-LINES 5
            SORT
            LIST-ITEMS "USA", "Canada", "Mexico"
            SIZE 30 BY 1 SKIP(1)
        "State/Province:" VIEW-AS TEXT SKIP(0)
        cmbState VIEW-AS COMBO-BOX
            DROP-DOWN-LIST
            INNER-LINES 10
            SORT
            SIZE 30 BY 1 SKIP(1)
        btnOK LABEL "OK" SIZE 10 BY 1
        WITH CENTERED
        SIZE 50 BY 10.
    
    /* Update states based on country */
    PROCEDURE UpdateStates:
        DEFINE INPUT PARAMETER pcCountry AS CHARACTER NO-UNDO.
        
        /* Clear existing items */
        DO WHILE cmbState:NUM-ITEMS > 0:
            cmbState:DELETE-ITEM(1).
        END.
        
        /* Add states/provinces based on country */
        CASE pcCountry:
            WHEN "USA" THEN DO:
                cmbState:ADD-ITEM("Alabama").
                cmbState:ADD-ITEM("Alaska").
                cmbState:ADD-ITEM("Arizona").
                cmbState:ADD-ITEM("Arkansas").
                cmbState:ADD-ITEM("California").
                cmbState:ADD-ITEM("Colorado").
            END.
            WHEN "Canada" THEN DO:
                cmbState:ADD-ITEM("Alberta").
                cmbState:ADD-ITEM("British Columbia").
                cmbState:ADD-ITEM("Manitoba").
                cmbState:ADD-ITEM("New Brunswick").
                cmbState:ADD-ITEM("Ontario").
                cmbState:ADD-ITEM("Quebec").
            END.
            WHEN "Mexico" THEN DO:
                cmbState:ADD-ITEM("Baja California").
                cmbState:ADD-ITEM("Chihuahua").
                cmbState:ADD-ITEM("Jalisco").
                cmbState:ADD-ITEM("Mexico City").
                cmbState:ADD-ITEM("Oaxaca").
                cmbState:ADD-ITEM("Yucatan").
            END.
        END CASE.
        
        /* Select first item */
        IF cmbState:NUM-ITEMS > 0 THEN
            cmbState:SCREEN-VALUE = cmbState:ENTRY(1).
    END PROCEDURE.
    
    /* Country trigger */
    ON VALUE-CHANGED OF cmbCountry DO:
        var character cCountry = cmbCountry:SCREEN-VALUE.
        RUN UpdateStates(cCountry).
    END.
    
    /* Button trigger */
    ON CHOOSE OF btnOK DO:
        var character cCountry = cmbCountry:SCREEN-VALUE.
        var character cState = cmbState:SCREEN-VALUE.
        
        MESSAGE "Country: " + cCountry + "~nState/Province: " + cState
            VIEW-AS ALERT-BOX INFO.
    END.
    
    /* Display frame */
    DISPLAY WITH FRAME frLocation.
    
    /* Initialize values */
    cmbCountry:SCREEN-VALUE = "USA".
    RUN UpdateStates("USA").
    
    /* Enable fields */
    ENABLE cmbCountry cmbState btnOK WITH FRAME frLocation.
    
    /* Wait for button click */
    WAIT-FOR CHOOSE OF btnOK.
END PROCEDURE.

/* Usage */
RUN DependentCombo.
"""
}

"dynamic_combo_example" = {
  title = "Dynamic Combo-Box Example",
  description = "Example of dynamically populating a combo-box in ABL",
  code = """
/* Dynamic combo-box example */
PROCEDURE DynamicCombo:
    /* Define variables */
    DEFINE VARIABLE cmbCustomer AS CHARACTER NO-UNDO.
    DEFINE VARIABLE edFilter AS CHARACTER NO-UNDO.
    
    /* Define frame */
    DEFINE FRAME frCustomer
        HEADER "Customer Selection"
        SKIP(1)
        "Filter:" VIEW-AS TEXT SKIP(0)
        edFilter VIEW-AS FILL-IN SIZE 30 BY 1 SKIP(1)
        "Customer:" VIEW-AS TEXT SKIP(0)
        cmbCustomer VIEW-AS COMBO-BOX
            DROP-DOWN-LIST
            INNER-LINES 10
            SORT
            SIZE 40 BY 1 SKIP(1)
        btnSelect LABEL "Select" SIZE 10 BY 1
        WITH CENTERED
        SIZE 60 BY 10.
    
    /* Populate customers based on filter */
    PROCEDURE PopulateCustomers:
        DEFINE INPUT PARAMETER pcFilter AS CHARACTER NO-UNDO.
        
        /* Clear existing items */
        DO WHILE cmbCustomer:NUM-ITEMS > 0:
            cmbCustomer:DELETE-ITEM(1).
        END.
        
        /* Add customers (simulated database) */
        IF pcFilter = "" OR INDEX("ACME CORP", pcFilter) > 0 THEN
            cmbCustomer:ADD-ITEM("ACME Corp").
        
        IF pcFilter = "" OR INDEX("AJAX INDUSTRIES", pcFilter) > 0 THEN
            cmbCustomer:ADD-ITEM("Ajax Industries").
        
        IF pcFilter = "" OR INDEX("BEST SYSTEMS", pcFilter) > 0 THEN
            cmbCustomer:ADD-ITEM("Best Systems").
        
        IF pcFilter = "" OR INDEX("CENTRAL SERVICES", pcFilter) > 0 THEN
            cmbCustomer:ADD-ITEM("Central Services").
        
        IF pcFilter = "" OR INDEX("DYNAMIC SOLUTIONS", pcFilter) > 0 THEN
            cmbCustomer:ADD-ITEM("Dynamic Solutions").
        
        IF pcFilter = "" OR INDEX("EASTERN ENTERPRISES", pcFilter) > 0 THEN
            cmbCustomer:ADD-ITEM("Eastern Enterprises").
        
        /* Select first item if available */
        IF cmbCustomer:NUM-ITEMS > 0 THEN
            cmbCustomer:SCREEN-VALUE = cmbCustomer:ENTRY(1).
        ELSE
            cmbCustomer:SCREEN-VALUE = "".
    END PROCEDURE.
    
    /* Filter trigger */
    ON VALUE-CHANGED OF edFilter DO:
        var character cFilter = CAPS(edFilter:SCREEN-VALUE).
        RUN PopulateCustomers(cFilter).
    END.
    
    /* Button trigger */
    ON CHOOSE OF btnSelect DO:
        var character cCustomer = cmbCustomer:SCREEN-VALUE.
        
        IF cCustomer <> "" THEN
            MESSAGE "Selected Customer: " + cCustomer
                VIEW-AS ALERT-BOX INFO.
        ELSE
            MESSAGE "No customer selected"
                VIEW-AS ALERT-BOX WARNING.
    END.
    
    /* Display frame */
    DISPLAY WITH FRAME frCustomer.
    
    /* Initialize customers */
    RUN PopulateCustomers("").
    
    /* Enable fields */
    ENABLE edFilter cmbCustomer btnSelect WITH FRAME frCustomer.
    
    /* Wait for button click */
    WAIT-FOR CHOOSE OF btnSelect.
END PROCEDURE.

/* Usage */
RUN DynamicCombo.
"""
}
