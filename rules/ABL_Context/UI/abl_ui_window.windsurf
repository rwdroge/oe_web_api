# ABL UI Window Reference
# Window components and management for ABL UI

[metadata]
name = "ABL UI Window Reference"
version = "1.0.0"
description = "Reference for ABL UI windows and window management"
category = "ui"

[syntax_elements]
# ABL UI window elements

"WINDOW" = {
  type = "container",
  description = "Top-level UI container",
  syntax = "DEFINE WINDOW window-name [options]",
  example = "DEFINE WINDOW wMain TITLE \"Main Window\"."
}

"DEFINE WINDOW" = {
  type = "statement",
  description = "Defines a window object",
  syntax = "DEFINE WINDOW window-name [options]",
  example = "DEFINE WINDOW wMain SIZE 80 BY 25."
}

"CREATE WINDOW" = {
  type = "statement",
  description = "Creates a window object dynamically",
  syntax = "CREATE WINDOW window-handle ASSIGN options",
  example = "CREATE WINDOW hWindow ASSIGN TITLE = \"Dynamic Window\"."
}

"CURRENT-WINDOW" = {
  type = "property",
  description = "Gets or refers to the current window",
  syntax = "CURRENT-WINDOW[:property]",
  example = "CURRENT-WINDOW:WIDTH = 80."
}

"TITLE" = {
  type = "attribute",
  description = "Sets the window title",
  syntax = "TITLE \"title\"",
  example = "TITLE \"Customer Management\""
}

"MAX-WIDTH" = {
  type = "attribute",
  description = "Sets the maximum window width",
  syntax = "MAX-WIDTH width",
  example = "MAX-WIDTH 100"
}

"MIN-WIDTH" = {
  type = "attribute",
  description = "Sets the minimum window width",
  syntax = "MIN-WIDTH width",
  example = "MIN-WIDTH 40"
}

"MAX-HEIGHT" = {
  type = "attribute",
  description = "Sets the maximum window height",
  syntax = "MAX-HEIGHT height",
  example = "MAX-HEIGHT 40"
}

"MIN-HEIGHT" = {
  type = "attribute",
  description = "Sets the minimum window height",
  syntax = "MIN-HEIGHT height",
  example = "MIN-HEIGHT 10"
}

"RESIZABLE" = {
  type = "attribute",
  description = "Makes a window resizable",
  syntax = "RESIZABLE",
  example = "RESIZABLE"
}

"NOT-RESIZABLE" = {
  type = "attribute",
  description = "Makes a window not resizable",
  syntax = "NOT-RESIZABLE",
  example = "NOT-RESIZABLE"
}

"STATUS-AREA" = {
  type = "attribute",
  description = "Adds a status area to a window",
  syntax = "STATUS-AREA",
  example = "STATUS-AREA"
}

"NO-STATUS-AREA" = {
  type = "attribute",
  description = "Removes the status area from a window",
  syntax = "NO-STATUS-AREA",
  example = "NO-STATUS-AREA"
}

"MESSAGE-AREA" = {
  type = "attribute",
  description = "Adds a message area to a window",
  syntax = "MESSAGE-AREA",
  example = "MESSAGE-AREA"
}

"NO-MESSAGE-AREA" = {
  type = "attribute",
  description = "Removes the message area from a window",
  syntax = "NO-MESSAGE-AREA",
  example = "NO-MESSAGE-AREA"
}

"MAXIMIZE" = {
  type = "attribute",
  description = "Maximizes a window",
  syntax = "MAXIMIZE",
  example = "MAXIMIZE"
}

"MINIMIZE" = {
  type = "attribute",
  description = "Minimizes a window",
  syntax = "MINIMIZE",
  example = "MINIMIZE"
}

"CENTERED" = {
  type = "attribute",
  description = "Centers a window on the screen",
  syntax = "CENTERED",
  example = "CENTERED"
}

"SYSTEM-MENU" = {
  type = "attribute",
  description = "Adds a system menu to a window",
  syntax = "SYSTEM-MENU",
  example = "SYSTEM-MENU"
}

"NO-SYSTEM-MENU" = {
  type = "attribute",
  description = "Removes the system menu from a window",
  syntax = "NO-SYSTEM-MENU",
  example = "NO-SYSTEM-MENU"
}

"VISIBLE" = {
  type = "property",
  description = "Controls window visibility",
  syntax = "handle:VISIBLE",
  example = "wMain:VISIBLE = TRUE."
}

"X" = {
  type = "property",
  description = "Gets or sets the horizontal position",
  syntax = "handle:X",
  example = "wMain:X = 100."
}

"Y" = {
  type = "property",
  description = "Gets or sets the vertical position",
  syntax = "handle:Y",
  example = "wMain:Y = 50."
}

"WIDTH" = {
  type = "property",
  description = "Gets or sets the window width",
  syntax = "handle:WIDTH",
  example = "wMain:WIDTH = 80."
}

"HEIGHT" = {
  type = "property",
  description = "Gets or sets the window height",
  syntax = "handle:HEIGHT",
  example = "wMain:HEIGHT = 25."
}

"TITLE" = {
  type = "property",
  description = "Gets or sets the window title",
  syntax = "handle:TITLE",
  example = "wMain:TITLE = \"Updated Title\"."
}

"STATUS" = {
  type = "property",
  description = "Gets or sets the status area text",
  syntax = "handle:STATUS",
  example = "wMain:STATUS = \"Ready\"."
}

"MESSAGE" = {
  type = "property",
  description = "Gets or sets the message area text",
  syntax = "handle:MESSAGE",
  example = "wMain:MESSAGE = \"Processing...\"."
}

"CENTER" = {
  type = "method",
  description = "Centers a window on the screen",
  syntax = "handle:CENTER()",
  example = "wMain:CENTER()."
}

"MAXIMIZE" = {
  type = "method",
  description = "Maximizes a window",
  syntax = "handle:MAXIMIZE()",
  example = "wMain:MAXIMIZE()."
}

"MINIMIZE" = {
  type = "method",
  description = "Minimizes a window",
  syntax = "handle:MINIMIZE()",
  example = "wMain:MINIMIZE()."
}

"RESTORE" = {
  type = "method",
  description = "Restores a window to normal state",
  syntax = "handle:RESTORE()",
  example = "wMain:RESTORE()."
}

"MOVE" = {
  type = "method",
  description = "Moves a window to a new position",
  syntax = "handle:MOVE(x, y)",
  example = "wMain:MOVE(100, 50)."
}

"RESIZE" = {
  type = "method",
  description = "Resizes a window",
  syntax = "handle:RESIZE(width, height)",
  example = "wMain:RESIZE(80, 25)."
}

"WINDOW-STATE" = {
  type = "property",
  description = "Gets the window state",
  syntax = "handle:WINDOW-STATE",
  example = "iState = wMain:WINDOW-STATE."
}

[best_practices]
# Best practices for ABL UI windows

"window_usage" = {
  title = "Window Usage Best Practices",
  description = """
When using windows, follow these best practices:

1. Create a consistent window hierarchy for your application
2. Use descriptive window titles
3. Set appropriate window sizes for content
4. Consider screen resolution when designing windows
5. Provide status information in status areas

```abl
/* Good practice - main application window */
DEFINE WINDOW wMain
    TITLE "Customer Management System"
    SIZE 100 BY 30
    STATUS-AREA
    MESSAGE-AREA
    RESIZABLE
    MAX-WIDTH 120
    MIN-WIDTH 80
    MAX-HEIGHT 40
    MIN-HEIGHT 20
    CENTERED
    SYSTEM-MENU.
```
"""
}

"window_management" = {
  title = "Window Management Best Practices",
  description = """
When managing windows, follow these best practices:

1. Use a consistent window hierarchy
2. Handle window events appropriately
3. Update status information regularly
4. Consider modal vs. non-modal windows
5. Clean up window resources when no longer needed

```abl
/* Good practice - window management */
PROCEDURE InitializeWindows:
    /* Define main window */
    DEFINE WINDOW wMain
        TITLE "Main Application"
        SIZE 100 BY 30
        STATUS-AREA
        MESSAGE-AREA
        RESIZABLE
        CENTERED
        SYSTEM-MENU.
    
    /* Define child window */
    DEFINE WINDOW wDetails
        TITLE "Details"
        SIZE 80 BY 20
        STATUS-AREA
        RESIZABLE
        SYSTEM-MENU.
    
    /* Set main window as current */
    wMain:VISIBLE = TRUE.
    
    /* Handle window events */
    ON WINDOW-CLOSE OF wMain
        APPLY "EXIT" TO SELF.
    
    ON WINDOW-CLOSE OF wDetails
        HIDE WINDOW wDetails.
    
    /* Set initial status */
    wMain:STATUS = "Ready".
END PROCEDURE.

/* Usage */
RUN InitializeWindows.
```
"""
}

"window_hierarchy" = {
  title = "Window Hierarchy Best Practices",
  description = """
When organizing window hierarchies, follow these best practices:

1. Use a main window as the application container
2. Create child windows for specific tasks
3. Consider modal dialogs for immediate attention
4. Maintain a logical window organization
5. Clean up window resources when closing

```abl
/* Good practice - window hierarchy */
PROCEDURE SetupWindowHierarchy:
    /* Define main window */
    DEFINE WINDOW wMain
        TITLE "Document Editor"
        SIZE 100 BY 30
        STATUS-AREA
        MESSAGE-AREA
        RESIZABLE
        MENU-BAR mMainMenu
        CENTERED
        SYSTEM-MENU.
    
    /* Define dialog windows */
    DEFINE WINDOW wPreferences
        TITLE "Preferences"
        SIZE 60 BY 20
        NOT-RESIZABLE
        CENTERED
        SYSTEM-MENU.
    
    DEFINE WINDOW wFind
        TITLE "Find"
        SIZE 40 BY 10
        NOT-RESIZABLE
        CENTERED
        SYSTEM-MENU.
    
    /* Define document window */
    DEFINE WINDOW wDocument
        TITLE "Untitled"
        SIZE 80 BY 25
        RESIZABLE
        SYSTEM-MENU.
    
    /* Handle window events */
    ON WINDOW-CLOSE OF wMain
        APPLY "EXIT" TO SELF.
    
    ON WINDOW-CLOSE OF wPreferences
        HIDE WINDOW wPreferences.
    
    ON WINDOW-CLOSE OF wFind
        HIDE WINDOW wFind.
    
    ON WINDOW-CLOSE OF wDocument DO:
        IF lDocumentModified THEN DO:
            MESSAGE "Document has been modified. Save changes?"
                UPDATE lSave
                VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO-CANCEL.
            
            CASE lSave:
                WHEN TRUE THEN
                    RUN SaveDocument.
                WHEN FALSE THEN
                    HIDE WINDOW wDocument.
                OTHERWISE
                    RETURN.
            END CASE.
        END ELSE
            HIDE WINDOW wDocument.
    END.
    
    /* Set main window as current */
    wMain:VISIBLE = TRUE.
END PROCEDURE.
```
"""
}

[examples]
# Examples of ABL UI windows

"basic_window_example" = {
  title = "Basic Window Example",
  description = "Example of a basic window in ABL",
  code = """
/* Basic window example */
PROCEDURE BasicWindow:
    /* Define window */
    DEFINE WINDOW wBasic
        TITLE "Basic Window Example"
        SIZE 80 BY 25
        STATUS-AREA
        MESSAGE-AREA
        RESIZABLE
        CENTERED
        SYSTEM-MENU.
    
    /* Define frame */
    DEFINE FRAME frMain
        HEADER "Main Content"
        SKIP(1)
        "This is a simple window example." SKIP
        "Windows are containers for frames and widgets." SKIP(1)
        btnClose LABEL "Close" SIZE 12 BY 1
        WITH CENTERED
        SIZE 70 BY 15.
    
    /* Handle close button */
    ON CHOOSE OF btnClose DO:
        APPLY "CLOSE" TO WINDOW wBasic.
    END.
    
    /* Window events */
    ON WINDOW-CLOSE OF wBasic
        APPLY "CLOSE" TO WINDOW wBasic.
    
    /* Show window */
    wBasic:VISIBLE = TRUE.
    
    /* Update status */
    wBasic:STATUS = "Ready".
    
    /* Display and enable frame */
    DISPLAY "This is a simple window example."
            "Windows are containers for frames and widgets."
            WITH FRAME frMain.
    ENABLE btnClose WITH FRAME frMain.
    
    /* Wait for window close */
    WAIT-FOR "WINDOW-CLOSE" OF wBasic.
END PROCEDURE.

/* Usage */
RUN BasicWindow.
"""
}

"multi_window_example" = {
  title = "Multiple Window Example",
  description = "Example of using multiple windows in ABL",
  code = """
/* Multiple windows example */
PROCEDURE MultiWindow:
    /* Define main window */
    DEFINE WINDOW wMain
        TITLE "Main Window"
        SIZE 80 BY 25
        STATUS-AREA
        MESSAGE-AREA
        RESIZABLE
        CENTERED
        SYSTEM-MENU.
    
    /* Define child window */
    DEFINE WINDOW wChild
        TITLE "Child Window"
        SIZE 60 BY 15
        STATUS-AREA
        RESIZABLE
        SYSTEM-MENU.
    
    /* Define main frame */
    DEFINE FRAME frMain
        HEADER "Multiple Windows Example"
        SKIP(1)
        "This demonstrates using multiple windows in ABL." SKIP(1)
        "Main window serves as the primary application container." SKIP(1)
        "Child windows provide additional functionality." SKIP(2)
        btnOpenChild LABEL "Open Child Window" SIZE 20 BY 1 SKIP(1)
        btnClose LABEL "Close Application" SIZE 20 BY 1
        WITH CENTERED
        SIZE 70 BY 20.
    
    /* Define child frame */
    DEFINE FRAME frChild
        HEADER "Child Window Content"
        SKIP(1)
        "This is a child window." SKIP(1)
        "Child windows can be used for dialogs, tools, etc." SKIP(2)
        btnClose LABEL "Close" SIZE 12 BY 1
        WITH CENTERED
        SIZE 50 BY 10.
    
    /* Button events */
    ON CHOOSE OF btnOpenChild DO:
        /* Update and show child window */
        wChild:X = wMain:X + 50.
        wChild:Y = wMain:Y + 50.
        wChild:VISIBLE = TRUE.
        
        /* Display and enable child frame */
        DISPLAY "This is a child window."
                "Child windows can be used for dialogs, tools, etc."
                WITH FRAME frChild.
        ENABLE btnClose WITH FRAME frChild.
    END.
    
    ON CHOOSE OF btnClose IN FRAME frMain DO:
        APPLY "CLOSE" TO WINDOW wMain.
    END.
    
    ON CHOOSE OF btnClose IN FRAME frChild DO:
        HIDE WINDOW wChild.
    END.
    
    /* Window events */
    ON WINDOW-CLOSE OF wMain DO:
        /* Clean up all windows */
        HIDE WINDOW wChild NO-ERROR.
        APPLY "CLOSE" TO WINDOW wMain.
    END.
    
    ON WINDOW-CLOSE OF wChild DO:
        HIDE WINDOW wChild.
    END.
    
    /* Show main window */
    wMain:VISIBLE = TRUE.
    
    /* Update status */
    wMain:STATUS = "Ready".
    
    /* Display and enable main frame */
    DISPLAY "This demonstrates using multiple windows in ABL."
            "Main window serves as the primary application container."
            "Child windows provide additional functionality."
            WITH FRAME frMain.
    ENABLE btnOpenChild btnClose WITH FRAME frMain.
    
    /* Wait for window close */
    WAIT-FOR "WINDOW-CLOSE" OF wMain.
END PROCEDURE.

/* Usage */
RUN MultiWindow.
"""
}

"dynamic_window_example" = {
  title = "Dynamic Window Example",
  description = "Example of creating windows dynamically in ABL",
  code = """
/* Dynamic window example */
PROCEDURE DynamicWindow:
    /* Define variables */
    DEFINE VARIABLE hWindow AS HANDLE NO-UNDO.
    DEFINE VARIABLE hFrame AS HANDLE NO-UNDO.
    DEFINE VARIABLE hText AS HANDLE NO-UNDO.
    DEFINE VARIABLE hButton AS HANDLE NO-UNDO.
    DEFINE VARIABLE iWindowCount AS INTEGER INITIAL 0 NO-UNDO.
    
    /* Create main window */
    CREATE WINDOW hWindow
        ASSIGN
            TITLE = "Dynamic Window Example"
            WIDTH = 80
            HEIGHT = 25
            STATUS-AREA = TRUE
            MESSAGE-AREA = TRUE
            RESIZABLE = TRUE
            CENTERED = TRUE
            SYSTEM-MENU = TRUE
            VISIBLE = TRUE.
    
    /* Create main frame */
    CREATE FRAME hFrame
        ASSIGN
            WINDOW = hWindow
            TITLE = "Dynamic Windows"
            WIDTH = 70
            HEIGHT = 20
            CENTERED = TRUE.
    
    /* Create text widget */
    CREATE TEXT hText
        ASSIGN
            FRAME = hFrame
            ROW = 3
            COLUMN = 5
            WIDTH = 60
            FORMAT = "X(60)"
            SCREEN-VALUE = "This demonstrates creating windows dynamically.".
    
    /* Create button */
    CREATE BUTTON hButton
        ASSIGN
            FRAME = hFrame
            LABEL = "Create New Window"
            ROW = 6
            COLUMN = 5
            WIDTH = 25
            HEIGHT = 1.
    
    /* Create close button */
    CREATE BUTTON hCloseBtn
        ASSIGN
            FRAME = hFrame
            LABEL = "Close"
            ROW = 8
            COLUMN = 5
            WIDTH = 25
            HEIGHT = 1.
    
    /* Handle button events */
    ON CHOOSE OF hButton DO:
        RUN CreateDynamicWindow.
    END.
    
    ON CHOOSE OF hCloseBtn DO:
        APPLY "CLOSE" TO hWindow.
    END.
    
    /* Handle window events */
    ON WINDOW-CLOSE OF hWindow DO:
        /* Clean up */
        DELETE OBJECT hButton NO-ERROR.
        DELETE OBJECT hCloseBtn NO-ERROR.
        DELETE OBJECT hText NO-ERROR.
        DELETE OBJECT hFrame NO-ERROR.
        DELETE OBJECT hWindow NO-ERROR.
    END.
    
    /* Create dynamic window */
    PROCEDURE CreateDynamicWindow:
        DEFINE VARIABLE hDynWindow AS HANDLE NO-UNDO.
        DEFINE VARIABLE hDynFrame AS HANDLE NO-UNDO.
        DEFINE VARIABLE hDynText AS HANDLE NO-UNDO.
        DEFINE VARIABLE hDynButton AS HANDLE NO-UNDO.
        
        /* Increment count */
        iWindowCount = iWindowCount + 1.
        
        /* Create dynamic window */
        CREATE WINDOW hDynWindow
            ASSIGN
                TITLE = "Dynamic Window " + STRING(iWindowCount)
                WIDTH = 60
                HEIGHT = 15
                STATUS-AREA = TRUE
                RESIZABLE = TRUE
                X = hWindow:X + (iWindowCount * 20)
                Y = hWindow:Y + (iWindowCount * 20)
                VISIBLE = TRUE.
        
        /* Create dynamic frame */
        CREATE FRAME hDynFrame
            ASSIGN
                WINDOW = hDynWindow
                TITLE = "Dynamic Content"
                WIDTH = 50
                HEIGHT = 10
                CENTERED = TRUE.
        
        /* Create dynamic text */
        CREATE TEXT hDynText
            ASSIGN
                FRAME = hDynFrame
                ROW = 3
                COLUMN = 5
                WIDTH = 40
                FORMAT = "X(40)"
                SCREEN-VALUE = "This is dynamic window " + STRING(iWindowCount).
        
        /* Create dynamic button */
        CREATE BUTTON hDynButton
            ASSIGN
                FRAME = hDynFrame
                LABEL = "Close"
                ROW = 5
                COLUMN = 5
                WIDTH = 15
                HEIGHT = 1.
        
        /* Handle button events */
        ON CHOOSE OF hDynButton DO:
            APPLY "CLOSE" TO hDynWindow.
        END.
        
        /* Handle window events */
        ON WINDOW-CLOSE OF hDynWindow DO:
            /* Clean up */
            DELETE OBJECT hDynButton NO-ERROR.
            DELETE OBJECT hDynText NO-ERROR.
            DELETE OBJECT hDynFrame NO-ERROR.
            DELETE OBJECT hDynWindow NO-ERROR.
        END.
        
        /* Update status */
        hDynWindow:STATUS = "Window ID: " + STRING(iWindowCount).
        
        /* Display frame */
        hDynFrame:VISIBLE = TRUE.
        
        /* Update main window status */
        hWindow:STATUS = "Created window: " + STRING(iWindowCount).
    END PROCEDURE.
    
    /* Display frame */
    hFrame:VISIBLE = TRUE.
    
    /* Wait for window close */
    WAIT-FOR "WINDOW-CLOSE" OF hWindow.
END PROCEDURE.

/* Usage */
RUN DynamicWindow.
"""
}
