# ABL UI Radio-Set Reference
# Radio-set widget for ABL UI

[metadata]
name = "ABL UI Radio-Set Reference"
version = "1.0.0"
description = "Reference for ABL UI radio-set widget and best practices"
category = "ui"

[syntax_elements]
# ABL UI radio-set elements

"RADIO-SET" = {
  type = "widget",
  description = "Widget for selecting one option from multiple choices",
  syntax = "field VIEW-AS RADIO-SET [options]",
  example = "Customer.Type VIEW-AS RADIO-SET."
}

"RADIO-BUTTONS" = {
  type = "attribute",
  description = "Defines the radio buttons in a radio set",
  syntax = "RADIO-BUTTONS \"label1\" value1, \"label2\" value2, ...",
  example = "RADIO-BUTTONS \"Personal\" 1, \"Business\" 2, \"Government\" 3"
}

"HORIZONTAL" = {
  type = "attribute",
  description = "Arranges radio buttons horizontally",
  syntax = "HORIZONTAL",
  example = "VIEW-AS RADIO-SET HORIZONTAL"
}

"VERTICAL" = {
  type = "attribute",
  description = "Arranges radio buttons vertically",
  syntax = "VERTICAL",
  example = "VIEW-AS RADIO-SET VERTICAL"
}

"SIZE" = {
  type = "attribute",
  description = "Specifies the size of a radio-set",
  syntax = "SIZE width BY height",
  example = "VIEW-AS RADIO-SET SIZE 30 BY 3"
}

"TOOLTIP" = {
  type = "attribute",
  description = "Adds a tooltip to a radio-set",
  syntax = "TOOLTIP \"tooltip\"",
  example = "VIEW-AS RADIO-SET TOOLTIP \"Select customer type\""
}

"SENSITIVE" = {
  type = "attribute",
  description = "Makes a radio-set sensitive to user interaction",
  syntax = "SENSITIVE",
  example = "VIEW-AS RADIO-SET SENSITIVE"
}

"SCREEN-VALUE" = {
  type = "property",
  description = "Gets or sets the screen value of a radio-set",
  syntax = "widget-handle:SCREEN-VALUE",
  example = "var character cType = radType:SCREEN-VALUE."
}

"VALUE-CHANGED" = {
  type = "event",
  description = "Event triggered when a radio-set value changes",
  syntax = "ON VALUE-CHANGED OF widget DO:\n    statements\nEND.",
  example = "ON VALUE-CHANGED OF radType DO:\n    MESSAGE \"Type changed\".\nEND."
}

[best_practices]
# Best practices for ABL UI radio-sets

"radio_naming" = {
  title = "Radio-Set Naming Conventions",
  description = """
When naming radio-set widgets, follow these best practices:

1. Use the 'rad' prefix for radio-set widgets
2. Use descriptive names that indicate the radio-set's purpose
3. Use consistent naming conventions across the application
4. Follow camelCase or PascalCase naming

```abl
/* Good practice */
DEFINE VARIABLE radGender AS CHARACTER INITIAL "M" 
    VIEW-AS RADIO-SET RADIO-BUTTONS "Male" "M", "Female" "F", "Other" "O".

DEFINE VARIABLE radPayment AS CHARACTER 
    VIEW-AS RADIO-SET RADIO-BUTTONS "Credit" "C", "Debit" "D", "Cash" "X".

DEFINE VARIABLE radPriority AS INTEGER INITIAL 2
    VIEW-AS RADIO-SET RADIO-BUTTONS "Low" 1, "Medium" 2, "High" 3.
```
"""
}

"radio_layout" = {
  title = "Radio-Set Layout Best Practices",
  description = """
When laying out radio-set widgets, follow these best practices:

1. Use clear and concise labels
2. Use VERTICAL for more than 3 options
3. Use HORIZONTAL for 2-3 options
4. Group related radio-sets together
5. Use consistent spacing and alignment

```abl
/* Good practice - vertical layout for many options */
DEFINE VARIABLE radCategory AS INTEGER
    VIEW-AS RADIO-SET VERTICAL
    RADIO-BUTTONS "Electronics" 1, 
                  "Clothing" 2, 
                  "Books" 3, 
                  "Home & Garden" 4, 
                  "Toys" 5
    SIZE 30 BY 8.

/* Good practice - horizontal layout for few options */
DEFINE VARIABLE radGender AS CHARACTER
    VIEW-AS RADIO-SET HORIZONTAL
    RADIO-BUTTONS "Male" "M", "Female" "F", "Other" "O"
    SIZE 40 BY 1.
```
"""
}

"radio_behavior" = {
  title = "Radio-Set Behavior Best Practices",
  description = """
When defining radio-set behavior, follow these best practices:

1. Use ON VALUE-CHANGED for immediate actions
2. Set appropriate INITIAL values
3. Use character or integer values based on needs
4. Use TOOLTIP for additional information
5. Enable/disable radio-sets based on context

```abl
/* Good practice */
DEFINE VARIABLE radShipping AS CHARACTER INITIAL "S"
    VIEW-AS RADIO-SET VERTICAL
    RADIO-BUTTONS "Standard" "S", "Express" "E", "Overnight" "O"
    TOOLTIP "Select shipping method"
    SIZE 30 BY 4.

/* Radio-set behavior */
ON VALUE-CHANGED OF radShipping DO:
    CASE radShipping:SCREEN-VALUE:
        WHEN "S" THEN lblCost:SCREEN-VALUE = "$5.00".
        WHEN "E" THEN lblCost:SCREEN-VALUE = "$15.00".
        WHEN "O" THEN lblCost:SCREEN-VALUE = "$25.00".
    END CASE.
END.
```
"""
}

[examples]
# Examples of ABL UI radio-sets

"basic_radio_example" = {
  title = "Basic Radio-Set Example",
  description = "Example of basic radio-set usage in ABL",
  code = """
/* Basic radio-set example */
PROCEDURE BasicRadio:
    /* Define variables */
    DEFINE VARIABLE radGender AS CHARACTER INITIAL "M" NO-UNDO.
    DEFINE VARIABLE radStatus AS CHARACTER INITIAL "A" NO-UNDO.
    
    /* Define frame */
    DEFINE FRAME frRadio
        HEADER "Radio-Set Example"
        SKIP(1)
        "Gender:" VIEW-AS TEXT SKIP(0)
        radGender VIEW-AS RADIO-SET HORIZONTAL
            RADIO-BUTTONS "Male" "M", "Female" "F", "Other" "O"
            SIZE 40 BY 1 SKIP(1)
        "Status:" VIEW-AS TEXT SKIP(0)
        radStatus VIEW-AS RADIO-SET VERTICAL
            RADIO-BUTTONS "Active" "A", "Inactive" "I", "Pending" "P"
            SIZE 30 BY 4 SKIP(1)
        btnOK LABEL "OK" SIZE 10 BY 1
        WITH CENTERED
        SIZE 50 BY 12.
    
    /* Button trigger */
    ON CHOOSE OF btnOK DO:
        var character cGender = radGender:SCREEN-VALUE.
        var character cStatus = radStatus:SCREEN-VALUE.
        
        MESSAGE "Gender: " + 
                (IF cGender = "M" THEN "Male" ELSE
                 IF cGender = "F" THEN "Female" ELSE "Other") + 
                "~nStatus: " + 
                (IF cStatus = "A" THEN "Active" ELSE
                 IF cStatus = "I" THEN "Inactive" ELSE "Pending")
            VIEW-AS ALERT-BOX INFO.
    END.
    
    /* Display frame */
    DISPLAY WITH FRAME frRadio.
    
    /* Enable fields */
    ENABLE radGender radStatus btnOK WITH FRAME frRadio.
    
    /* Wait for button click */
    WAIT-FOR CHOOSE OF btnOK.
END PROCEDURE.

/* Usage */
RUN BasicRadio.
"""
}

"dependent_radio_example" = {
  title = "Dependent Radio-Set Example",
  description = "Example of dependent radio-sets in ABL",
  code = """
/* Dependent radio-set example */
PROCEDURE DependentRadio:
    /* Define variables */
    DEFINE VARIABLE radPayment AS CHARACTER INITIAL "C" NO-UNDO.
    DEFINE VARIABLE radCreditCard AS CHARACTER INITIAL "V" NO-UNDO.
    
    /* Define frame */
    DEFINE FRAME frPayment
        HEADER "Payment Method"
        SKIP(1)
        "Payment Type:" VIEW-AS TEXT SKIP(0)
        radPayment VIEW-AS RADIO-SET VERTICAL
            RADIO-BUTTONS "Credit Card" "C", "Debit Card" "D", "Cash" "X"
            SIZE 30 BY 4 SKIP(1)
        "Credit Card Type:" VIEW-AS TEXT SKIP(0)
        radCreditCard VIEW-AS RADIO-SET HORIZONTAL
            RADIO-BUTTONS "Visa" "V", "MasterCard" "M", "Amex" "A"
            SIZE 40 BY 1 SKIP(1)
        btnOK LABEL "OK" SIZE 10 BY 1
        WITH CENTERED
        SIZE 50 BY 12.
    
    /* Payment type trigger */
    ON VALUE-CHANGED OF radPayment DO:
        IF radPayment:SCREEN-VALUE = "C" THEN
            radCreditCard:SENSITIVE = TRUE.
        ELSE
            radCreditCard:SENSITIVE = FALSE.
    END.
    
    /* Button trigger */
    ON CHOOSE OF btnOK DO:
        var character cPayment = radPayment:SCREEN-VALUE.
        var character cCreditCard = radCreditCard:SCREEN-VALUE.
        var character cPaymentDesc = 
            IF cPayment = "C" THEN "Credit Card" ELSE
            IF cPayment = "D" THEN "Debit Card" ELSE "Cash".
        var character cCardDesc = 
            IF cCreditCard = "V" THEN "Visa" ELSE
            IF cCreditCard = "M" THEN "MasterCard" ELSE "Amex".
        
        MESSAGE "Payment Method: " + cPaymentDesc + 
                (IF cPayment = "C" THEN "~nCard Type: " + cCardDesc ELSE "")
            VIEW-AS ALERT-BOX INFO.
    END.
    
    /* Display frame */
    DISPLAY WITH FRAME frPayment.
    
    /* Enable fields */
    ENABLE radPayment radCreditCard btnOK WITH FRAME frPayment.
    
    /* Wait for button click */
    WAIT-FOR CHOOSE OF btnOK.
END PROCEDURE.

/* Usage */
RUN DependentRadio.
"""
}

"dynamic_radio_example" = {
  title = "Dynamic Radio-Set Example",
  description = "Example of dynamically changing radio-set options in ABL",
  code = """
/* Dynamic radio-set example */
PROCEDURE DynamicRadio:
    /* Define variables */
    DEFINE VARIABLE radCategory AS INTEGER INITIAL 1 NO-UNDO.
    DEFINE VARIABLE radSubcategory AS INTEGER INITIAL 1 NO-UNDO.
    
    /* Define frame */
    DEFINE FRAME frCategories
        HEADER "Product Categories"
        SKIP(1)
        "Main Category:" VIEW-AS TEXT SKIP(0)
        radCategory VIEW-AS RADIO-SET VERTICAL
            RADIO-BUTTONS "Electronics" 1, "Clothing" 2, "Books" 3
            SIZE 30 BY 4 SKIP(1)
        "Subcategory:" VIEW-AS TEXT SKIP(0)
        radSubcategory VIEW-AS RADIO-SET VERTICAL
            SIZE 30 BY 5 SKIP(1)
        btnOK LABEL "OK" SIZE 10 BY 1
        WITH CENTERED
        SIZE 50 BY 15.
    
    /* Update subcategories based on main category */
    PROCEDURE UpdateSubcategories:
        DEFINE INPUT PARAMETER piCategory AS INTEGER NO-UNDO.
        
        /* Remove old radio buttons */
        radSubcategory:DELETE-RADIO-BUTTON(ALL).
        
        /* Add new radio buttons based on category */
        CASE piCategory:
            WHEN 1 THEN DO: /* Electronics */
                radSubcategory:ADD-RADIO-BUTTON("Computers", 1).
                radSubcategory:ADD-RADIO-BUTTON("Phones", 2).
                radSubcategory:ADD-RADIO-BUTTON("TVs", 3).
                radSubcategory:ADD-RADIO-BUTTON("Audio", 4).
            END.
            WHEN 2 THEN DO: /* Clothing */
                radSubcategory:ADD-RADIO-BUTTON("Men's", 1).
                radSubcategory:ADD-RADIO-BUTTON("Women's", 2).
                radSubcategory:ADD-RADIO-BUTTON("Children's", 3).
            END.
            WHEN 3 THEN DO: /* Books */
                radSubcategory:ADD-RADIO-BUTTON("Fiction", 1).
                radSubcategory:ADD-RADIO-BUTTON("Non-fiction", 2).
                radSubcategory:ADD-RADIO-BUTTON("Reference", 3).
                radSubcategory:ADD-RADIO-BUTTON("Textbooks", 4).
                radSubcategory:ADD-RADIO-BUTTON("Magazines", 5).
            END.
        END CASE.
        
        /* Set default value */
        radSubcategory:SCREEN-VALUE = "1".
    END PROCEDURE.
    
    /* Category trigger */
    ON VALUE-CHANGED OF radCategory DO:
        RUN UpdateSubcategories(INTEGER(radCategory:SCREEN-VALUE)).
    END.
    
    /* Button trigger */
    ON CHOOSE OF btnOK DO:
        var integer iCategory = INTEGER(radCategory:SCREEN-VALUE).
        var integer iSubcategory = INTEGER(radSubcategory:SCREEN-VALUE).
        var character cCategoryName = "".
        var character cSubcategoryName = "".
        
        /* Get category name */
        CASE iCategory:
            WHEN 1 THEN cCategoryName = "Electronics".
            WHEN 2 THEN cCategoryName = "Clothing".
            WHEN 3 THEN cCategoryName = "Books".
        END CASE.
        
        /* Get subcategory name */
        CASE iCategory:
            WHEN 1 THEN DO: /* Electronics */
                CASE iSubcategory:
                    WHEN 1 THEN cSubcategoryName = "Computers".
                    WHEN 2 THEN cSubcategoryName = "Phones".
                    WHEN 3 THEN cSubcategoryName = "TVs".
                    WHEN 4 THEN cSubcategoryName = "Audio".
                END CASE.
            END.
            WHEN 2 THEN DO: /* Clothing */
                CASE iSubcategory:
                    WHEN 1 THEN cSubcategoryName = "Men's".
                    WHEN 2 THEN cSubcategoryName = "Women's".
                    WHEN 3 THEN cSubcategoryName = "Children's".
                END CASE.
            END.
            WHEN 3 THEN DO: /* Books */
                CASE iSubcategory:
                    WHEN 1 THEN cSubcategoryName = "Fiction".
                    WHEN 2 THEN cSubcategoryName = "Non-fiction".
                    WHEN 3 THEN cSubcategoryName = "Reference".
                    WHEN 4 THEN cSubcategoryName = "Textbooks".
                    WHEN 5 THEN cSubcategoryName = "Magazines".
                END CASE.
            END.
        END CASE.
        
        MESSAGE "Category: " + cCategoryName + "~nSubcategory: " + cSubcategoryName
            VIEW-AS ALERT-BOX INFO.
    END.
    
    /* Display frame */
    DISPLAY WITH FRAME frCategories.
    
    /* Initialize subcategories */
    RUN UpdateSubcategories(1).
    
    /* Enable fields */
    ENABLE radCategory radSubcategory btnOK WITH FRAME frCategories.
    
    /* Wait for button click */
    WAIT-FOR CHOOSE OF btnOK.
END PROCEDURE.

/* Usage */
RUN DynamicRadio.
"""
}
