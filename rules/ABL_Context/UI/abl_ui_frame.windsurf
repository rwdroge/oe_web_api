# ABL UI Frame Reference
# Frames and form containers for ABL UI

[metadata]
name = "ABL UI Frame Reference"
version = "1.0.0"
description = "Reference for ABL UI frames and form containers"
category = "ui"

[syntax_elements]
# ABL UI frame elements

"FRAME" = {
  type = "container",
  description = "Container for UI widgets",
  syntax = "DEFINE FRAME frame-name [options]",
  example = "DEFINE FRAME frMain HEADER \"Main Form\"."
}

"DEFINE FRAME" = {
  type = "statement",
  description = "Defines a frame object",
  syntax = "DEFINE FRAME frame-name [options]",
  example = "DEFINE FRAME frMain SIZE 80 BY 25."
}

"WITH" = {
  type = "attribute",
  description = "Specifies frame attributes",
  syntax = "WITH [options]",
  example = "WITH CENTERED SIDE-LABELS"
}

"HEADER" = {
  type = "attribute",
  description = "Sets the frame title",
  syntax = "HEADER \"title\"",
  example = "HEADER \"Customer Information\""
}

"TITLE" = {
  type = "attribute",
  description = "Sets the frame title (alternative to HEADER)",
  syntax = "TITLE \"title\"",
  example = "TITLE \"Customer Information\""
}

"TITLE-BAR" = {
  type = "attribute",
  description = "Shows a title bar on the frame",
  syntax = "TITLE-BAR",
  example = "WITH TITLE-BAR"
}

"NO-BOX" = {
  type = "attribute",
  description = "Removes the frame border",
  syntax = "NO-BOX",
  example = "WITH NO-BOX"
}

"BOX" = {
  type = "attribute",
  description = "Shows a border around the frame",
  syntax = "BOX",
  example = "WITH BOX"
}

"OVERLAY" = {
  type = "attribute",
  description = "Allows frames to overlap",
  syntax = "OVERLAY",
  example = "WITH OVERLAY"
}

"NO-LABELS" = {
  type = "attribute",
  description = "Hides field labels",
  syntax = "NO-LABELS",
  example = "WITH NO-LABELS"
}

"SIDE-LABELS" = {
  type = "attribute",
  description = "Places labels to the side of fields",
  syntax = "SIDE-LABELS",
  example = "WITH SIDE-LABELS"
}

"TOP-ONLY" = {
  type = "attribute",
  description = "Places labels above fields",
  syntax = "TOP-ONLY",
  example = "WITH TOP-ONLY"
}

"DOWN" = {
  type = "attribute",
  description = "Moves the cursor or field down",
  syntax = "DOWN n",
  example = "DOWN 2"
}

"CENTERED" = {
  type = "attribute",
  description = "Centers the frame on screen",
  syntax = "CENTERED",
  example = "WITH CENTERED"
}

"COLUMN" = {
  type = "attribute",
  description = "Sets the column position",
  syntax = "COLUMN n",
  example = "COLUMN 10"
}

"ROW" = {
  type = "attribute",
  description = "Sets the row position",
  syntax = "ROW n",
  example = "ROW 5"
}

"SIZE" = {
  type = "attribute",
  description = "Sets the frame size",
  syntax = "SIZE width BY height",
  example = "SIZE 80 BY 25"
}

"VIEW-AS" = {
  type = "attribute",
  description = "Specifies how to display a field",
  syntax = "VIEW-AS widget-type [options]",
  example = "VIEW-AS FILL-IN SIZE 30 BY 1"
}

"SKIP" = {
  type = "layout",
  description = "Creates vertical space",
  syntax = "SKIP(lines)",
  example = "SKIP(1)"
}

"SPACE" = {
  type = "layout",
  description = "Creates horizontal space",
  syntax = "SPACE(columns)",
  example = "SPACE(5)"
}

"BGCOLOR" = {
  type = "property",
  description = "Sets the background color",
  syntax = "BGCOLOR color",
  example = "BGCOLOR 15"
}

"FGCOLOR" = {
  type = "property",
  description = "Sets the foreground color",
  syntax = "FGCOLOR color",
  example = "FGCOLOR 1"
}

"FONT" = {
  type = "property",
  description = "Sets the font",
  syntax = "FONT \"font-spec\"",
  example = "FONT \"MS Sans Serif, 10\""
}

"DISPLAY" = {
  type = "statement",
  description = "Displays fields in a frame",
  syntax = "DISPLAY field-list WITH FRAME frame-name",
  example = "DISPLAY cName cAddress WITH FRAME frCustomer."
}

"ENABLE" = {
  type = "statement",
  description = "Enables fields in a frame",
  syntax = "ENABLE field-list WITH FRAME frame-name",
  example = "ENABLE cName cAddress btnSave WITH FRAME frCustomer."
}

"DISABLE" = {
  type = "statement",
  description = "Disables fields in a frame",
  syntax = "DISABLE field-list WITH FRAME frame-name",
  example = "DISABLE btnSave WITH FRAME frCustomer."
}

"HIDE" = {
  type = "statement",
  description = "Hides frames or fields",
  syntax = "HIDE FRAME frame-name",
  example = "HIDE FRAME frDialog."
}

"VIEW" = {
  type = "statement",
  description = "Makes a frame visible",
  syntax = "VIEW FRAME frame-name",
  example = "VIEW FRAME frDialog."
}

"CURRENT-WINDOW" = {
  type = "property",
  description = "Gets or sets the current window",
  syntax = "CURRENT-WINDOW",
  example = "CURRENT-WINDOW:WIDTH = 100."
}

"WAIT-FOR" = {
  type = "statement",
  description = "Waits for user interaction",
  syntax = "WAIT-FOR event OF object",
  example = "WAIT-FOR CLOSE OF FRAME frMain."
}

[best_practices]
# Best practices for ABL UI frames

"frame_organization" = {
  title = "Frame Organization Best Practices",
  description = """
When organizing frames, follow these best practices:

1. Group related fields together in the same frame
2. Use consistent layouts across your application
3. Provide clear headers/titles for frames
4. Use consistent spacing between elements
5. Order fields in a logical manner

```abl
/* Good practice - well-organized frame */
DEFINE FRAME frCustomer
    HEADER "Customer Information"
    SKIP(1)
    cId     LABEL "ID"          COLON 15 FORMAT "X(10)" SKIP
    cName   LABEL "Name"        COLON 15 FORMAT "X(30)" SKIP
    cAddr   LABEL "Address"     COLON 15 FORMAT "X(40)" SKIP
    cPhone  LABEL "Phone"       COLON 15 FORMAT "X(15)" SKIP
    cEmail  LABEL "Email"       COLON 15 FORMAT "X(40)" SKIP(1)
    btnSave LABEL "Save"        AT COL 15 SIZE 12 BY 1
    btnCancel LABEL "Cancel"    AT COL 30 SIZE 12 BY 1
    WITH CENTERED
    SIZE 80 BY 12.
```
"""
}

"frame_navigation" = {
  title = "Frame Navigation Best Practices",
  description = """
When planning frame navigation, follow these best practices:

1. Use consistent tab order for fields
2. Group related actions together
3. Place common actions in consistent locations
4. Provide keyboard shortcuts for important functions
5. Consider user workflow when arranging controls

```abl
/* Good practice - organized navigation */
DEFINE FRAME frOrder
    HEADER "Order Entry"
    SKIP(1)
    /* Customer section */
    "Customer Information:" VIEW-AS TEXT SKIP
    custId     LABEL "ID"        FORMAT ">>>>>>9" SKIP
    custName   LABEL "Name"      FORMAT "X(30)" SKIP(1)
    
    /* Order section */
    "Order Details:" VIEW-AS TEXT SKIP
    orderId    LABEL "Order #"   FORMAT ">>>>>>9" SKIP
    orderDate  LABEL "Date"      FORMAT "99/99/9999" SKIP(1)
    
    /* Items section */
    "Order Items:" VIEW-AS TEXT SKIP
    SPACE(2) itemBrowse SKIP(1)
    
    /* Buttons - grouped by function */
    /* Navigation buttons */
    btnFirst LABEL "First" AT ROW 16 COL 10
    btnPrev  LABEL "Prev"  AT ROW 16 COL 20
    btnNext  LABEL "Next"  AT ROW 16 COL 30
    btnLast  LABEL "Last"  AT ROW 16 COL 40 SKIP(1)
    
    /* Action buttons */
    btnSave   LABEL "Save"   AT ROW 18 COL 10
    btnCancel LABEL "Cancel" AT ROW 18 COL 25
    btnDelete LABEL "Delete" AT ROW 18 COL 40
    
    WITH CENTERED
    SIZE 80 BY 20.

/* Set tab order explicitly */
DEFINE TAB-ORDER custId custName orderId orderDate
                 itemBrowse
                 btnFirst btnPrev btnNext btnLast
                 btnSave btnCancel btnDelete.
```
"""
}

"frame_design" = {
  title = "Frame Design Best Practices",
  description = """
When designing frames, follow these best practices:

1. Maintain consistency in layout and design
2. Use appropriate spacing and alignment
3. Choose appropriate control types for data
4. Consider screen real estate and resolution
5. Group related information using visual cues

```abl
/* Good practice - well-designed frame */
DEFINE FRAME frInvoice
    HEADER "Invoice Details"
    
    /* Group 1: Invoice Header */
    FRAME frHeader
        HEADER "Invoice Information"
        SKIP(1)
        invNum   LABEL "Invoice #"    COLON 15 FORMAT ">>>>>>9" SKIP
        invDate  LABEL "Date"         COLON 15 FORMAT "99/99/9999" SKIP
        custId   LABEL "Customer"     COLON 15 FORMAT ">>>>>>9" SKIP
        custName                      COLON 15 FORMAT "X(30)" SKIP
        WITH BOX
        SIZE 70 BY 8
    AT ROW 3 COL 5
    
    /* Group 2: Line Items */
    FRAME frItems
        HEADER "Line Items"
        SKIP(1)
        brItems /* Browse of items */
        WITH BOX
        SIZE 70 BY 12
    AT ROW 12 COL 5
    
    /* Group 3: Totals */
    FRAME frTotals
        SKIP(1)
        "Subtotal:"       VIEW-AS TEXT AT ROW 1 COL 40
        dSubtotal         AT ROW 1 COL 50 FORMAT ">>>,>>9.99" SKIP
        "Tax:"            VIEW-AS TEXT AT ROW 2 COL 40
        dTax              AT ROW 2 COL 50 FORMAT ">>>,>>9.99" SKIP
        "Total:"          VIEW-AS TEXT AT ROW 3 COL 40
        dTotal            AT ROW 3 COL 50 FORMAT ">>>,>>9.99" SKIP
        WITH BOX
        SIZE 70 BY 5
    AT ROW 25 COL 5
    
    /* Action buttons at bottom */
    btnPrint  LABEL "Print"  AT ROW 31 COL 20 SIZE 12 BY 1
    btnEmail  LABEL "Email"  AT ROW 31 COL 35 SIZE 12 BY 1
    btnClose  LABEL "Close"  AT ROW 31 COL 50 SIZE 12 BY 1
    
    WITH OVERLAY
    SIZE 80 BY 32.
```
"""
}

"frame_responsiveness" = {
  title = "Frame Responsiveness Best Practices",
  description = """
When designing responsive frames, follow these best practices:

1. Use relative positioning when possible
2. Consider different screen resolutions
3. Test frames on different displays
4. Avoid hard-coded positions for critical elements
5. Resize frames based on content where appropriate

```abl
/* Good practice - responsive frame design */
PROCEDURE ResponsiveFrame:
    DEFINE VARIABLE wWidth  AS INTEGER NO-UNDO.
    DEFINE VARIABLE wHeight AS INTEGER NO-UNDO.
    
    /* Get current window dimensions */
    wWidth  = CURRENT-WINDOW:WIDTH.
    wHeight = CURRENT-WINDOW:HEIGHT.
    
    /* Define frame based on window size */
    DEFINE FRAME frMain
        HEADER "Responsive Application"
        SKIP(1)
        
        /* Make content area scale with window */
        edContent VIEW-AS EDITOR
            SIZE (wWidth - 10) BY (wHeight - 10)
        AT ROW 3 COL 5
        
        /* Position buttons at bottom */
        btnOK LABEL "OK" AT ROW (wHeight - 3) COL (wWidth / 2 - 10)
            SIZE 10 BY 1
        btnCancel LABEL "Cancel" AT ROW (wHeight - 3) COL (wWidth / 2 + 2)
            SIZE 10 BY 1
            
        WITH OVERLAY NO-BOX
        SIZE wWidth BY wHeight.
    
    /* Handle window resize */
    ON WINDOW-RESIZED OF frMain DO:
        /* Update window dimensions */
        wWidth  = CURRENT-WINDOW:WIDTH.
        wHeight = CURRENT-WINDOW:HEIGHT.
        
        /* Adjust frame size */
        FRAME frMain:WIDTH  = wWidth.
        FRAME frMain:HEIGHT = wHeight.
        
        /* Adjust content area */
        edContent:WIDTH  = wWidth - 10.
        edContent:HEIGHT = wHeight - 10.
        
        /* Reposition buttons */
        btnOK:ROW = wHeight - 3.
        btnOK:COLUMN = wWidth / 2 - 10.
        
        btnCancel:ROW = wHeight - 3.
        btnCancel:COLUMN = wWidth / 2 + 2.
    END.
    
    /* Display and enable */
    DISPLAY edContent WITH FRAME frMain.
    ENABLE edContent btnOK btnCancel WITH FRAME frMain.
    
    /* Wait for frame close */
    WAIT-FOR CLOSE OF FRAME frMain.
END PROCEDURE.
```
"""
}

[examples]
# Examples of ABL UI frames

"basic_frame_example" = {
  title = "Basic Frame Example",
  description = "Example of a basic frame in ABL",
  code = """
/* Basic frame example */
PROCEDURE BasicFrame:
    /* Define variables */
    DEFINE VARIABLE cName AS CHARACTER NO-UNDO.
    DEFINE VARIABLE cEmail AS CHARACTER NO-UNDO.
    DEFINE VARIABLE iAge AS INTEGER NO-UNDO.
    
    /* Define frame */
    DEFINE FRAME frBasic
        HEADER "User Information"
        SKIP(1)
        "Name:" VIEW-AS TEXT SKIP(0)
        cName FORMAT "X(30)" SKIP(1)
        "Email:" VIEW-AS TEXT SKIP(0)
        cEmail FORMAT "X(50)" SKIP(1)
        "Age:" VIEW-AS TEXT SKIP(0)
        iAge SKIP(2)
        btnOK LABEL "OK" SIZE 12 BY 1
        btnCancel LABEL "Cancel" SIZE 12 BY 1
        WITH CENTERED
        SIZE 60 BY 12.
    
    /* Button events */
    ON CHOOSE OF btnOK DO:
        IF cName = "" THEN DO:
            MESSAGE "Please enter a name."
                VIEW-AS ALERT-BOX WARNING.
            RETURN.
        END.
        
        IF cEmail = "" THEN DO:
            MESSAGE "Please enter an email address."
                VIEW-AS ALERT-BOX WARNING.
            RETURN.
        END.
        
        IF iAge = 0 THEN DO:
            MESSAGE "Please enter age."
                VIEW-AS ALERT-BOX WARNING.
            RETURN.
        END.
        
        MESSAGE "User information saved."
            VIEW-AS ALERT-BOX INFO.
        
        APPLY "CLOSE" TO FRAME frBasic.
    END.
    
    ON CHOOSE OF btnCancel DO:
        APPLY "CLOSE" TO FRAME frBasic.
    END.
    
    /* Display and enable */
    DISPLAY cName cEmail iAge WITH FRAME frBasic.
    ENABLE cName cEmail iAge btnOK btnCancel WITH FRAME frBasic.
    
    /* Wait for frame close */
    WAIT-FOR CLOSE OF FRAME frBasic.
END PROCEDURE.

/* Usage */
RUN BasicFrame.
"""
}

"multi_frame_example" = {
  title = "Multiple Frames Example",
  description = "Example of using multiple frames in ABL",
  code = """
/* Multiple frames example */
PROCEDURE MultipleFrames:
    /* Define variables */
    DEFINE VARIABLE iStep AS INTEGER INITIAL 1 NO-UNDO.
    DEFINE VARIABLE cName AS CHARACTER NO-UNDO.
    DEFINE VARIABLE cAddress AS CHARACTER NO-UNDO.
    DEFINE VARIABLE cPhone AS CHARACTER NO-UNDO.
    DEFINE VARIABLE cCardType AS CHARACTER NO-UNDO.
    DEFINE VARIABLE cCardNumber AS CHARACTER NO-UNDO.
    DEFINE VARIABLE dAmount AS DECIMAL NO-UNDO.
    
    /* Define main frame */
    DEFINE FRAME frMain
        HEADER "Payment Wizard"
        SKIP(1)
        txtStep VIEW-AS TEXT SIZE 50 BY 1 SKIP(1)
        
        /* Step indicator frame */
        FRAME frSteps
            HEADER "Steps"
            SKIP(1)
            "1. Customer Information" VIEW-AS TEXT AT ROW 2 COL 2 SKIP(1)
            "2. Payment Information" VIEW-AS TEXT AT ROW 3 COL 2 SKIP(1)
            "3. Confirmation" VIEW-AS TEXT AT ROW 4 COL 2
            WITH BOX
            SIZE 30 BY 6
        AT ROW 5 COL 5
        
        /* Content frame - will hold step frames */
        FRAME frContent
            WITH BOX
            SIZE 60 BY 15
        AT ROW 5 COL 40
        
        /* Navigation buttons */
        btnBack LABEL "< Back" AT ROW 22 COL 40 SIZE 12 BY 1
        btnNext LABEL "Next >" AT ROW 22 COL 55 SIZE 12 BY 1
        btnCancel LABEL "Cancel" AT ROW 22 COL 70 SIZE 12 BY 1
        
        WITH CENTERED OVERLAY
        SIZE 110 BY 25.
    
    /* Define step 1 frame */
    DEFINE FRAME frStep1
        HEADER "Customer Information"
        SKIP(1)
        "Name:" VIEW-AS TEXT SKIP(0)
        cName FORMAT "X(30)" SKIP(1)
        "Address:" VIEW-AS TEXT SKIP(0)
        cAddress VIEW-AS EDITOR SIZE 40 BY 3 SCROLLBAR-VERTICAL SKIP(1)
        "Phone:" VIEW-AS TEXT SKIP(0)
        cPhone FORMAT "X(15)"
        WITH NO-BOX
        SIZE 58 BY 13.
    
    /* Define step 2 frame */
    DEFINE FRAME frStep2
        HEADER "Payment Information"
        SKIP(1)
        "Card Type:" VIEW-AS TEXT SKIP(0)
        cCardType VIEW-AS COMBO-BOX
            DROP-DOWN-LIST
            LIST-ITEMS "Visa", "MasterCard", "American Express" SKIP(1)
        "Card Number:" VIEW-AS TEXT SKIP(0)
        cCardNumber FORMAT "X(20)" SKIP(1)
        "Amount:" VIEW-AS TEXT SKIP(0)
        dAmount FORMAT ">>>,>>9.99"
        WITH NO-BOX
        SIZE 58 BY 13.
    
    /* Define step 3 frame */
    DEFINE FRAME frStep3
        HEADER "Confirmation"
        SKIP(1)
        "Please confirm your information:" VIEW-AS TEXT SKIP(2)
        "Name:" VIEW-AS TEXT AT ROW 5 COL 5
        txtName VIEW-AS TEXT AT ROW 5 COL 20 SIZE 35 BY 1 SKIP(1)
        "Address:" VIEW-AS TEXT AT ROW 6 COL 5
        txtAddress VIEW-AS TEXT AT ROW 6 COL 20 SIZE 35 BY 3 SKIP(1)
        "Phone:" VIEW-AS TEXT AT ROW 9 COL 5
        txtPhone VIEW-AS TEXT AT ROW 9 COL 20 SIZE 35 BY 1 SKIP(1)
        "Card Type:" VIEW-AS TEXT AT ROW 10 COL 5
        txtCardType VIEW-AS TEXT AT ROW 10 COL 20 SIZE 35 BY 1 SKIP(1)
        "Card Number:" VIEW-AS TEXT AT ROW 11 COL 5
        txtCardNumber VIEW-AS TEXT AT ROW 11 COL 20 SIZE 35 BY 1 SKIP(1)
        "Amount:" VIEW-AS TEXT AT ROW 12 COL 5
        txtAmount VIEW-AS TEXT AT ROW 12 COL 20 SIZE 35 BY 1
        WITH NO-BOX
        SIZE 58 BY 13.
    
    /* Update step text */
    PROCEDURE UpdateStep:
        CASE iStep:
            WHEN 1 THEN
                txtStep:SCREEN-VALUE = "Step 1 of 3: Enter customer information".
            WHEN 2 THEN
                txtStep:SCREEN-VALUE = "Step 2 of 3: Enter payment details".
            WHEN 3 THEN
                txtStep:SCREEN-VALUE = "Step 3 of 3: Confirm information".
        END CASE.
    END PROCEDURE.
    
    /* Show current step frame */
    PROCEDURE ShowStep:
        /* Hide all step frames */
        HIDE FRAME frStep1.
        HIDE FRAME frStep2.
        HIDE FRAME frStep3.
        
        /* Show current step frame */
        CASE iStep:
            WHEN 1 THEN DO:
                VIEW FRAME frStep1 IN FRAME frContent.
                ENABLE cName cAddress cPhone WITH FRAME frStep1.
                btnBack:SENSITIVE = FALSE.
                btnNext:SENSITIVE = TRUE.
            END.
            WHEN 2 THEN DO:
                VIEW FRAME frStep2 IN FRAME frContent.
                ENABLE cCardType cCardNumber dAmount WITH FRAME frStep2.
                btnBack:SENSITIVE = TRUE.
                btnNext:SENSITIVE = TRUE.
            END.
            WHEN 3 THEN DO:
                /* Update confirmation text */
                txtName:SCREEN-VALUE = cName.
                txtAddress:SCREEN-VALUE = cAddress.
                txtPhone:SCREEN-VALUE = cPhone.
                txtCardType:SCREEN-VALUE = cCardType.
                txtCardNumber:SCREEN-VALUE = SUBSTRING(cCardNumber, 1, 4) + 
                                           "********" + 
                                           SUBSTRING(cCardNumber, 
                                           LENGTH(cCardNumber) - 3).
                txtAmount:SCREEN-VALUE = STRING(dAmount).
                
                VIEW FRAME frStep3 IN FRAME frContent.
                btnBack:SENSITIVE = TRUE.
                btnNext:LABEL = "Finish".
            END.
        END CASE.
    END PROCEDURE.
    
    /* Button events */
    ON CHOOSE OF btnBack DO:
        iStep = iStep - 1.
        IF iStep < 1 THEN iStep = 1.
        
        RUN UpdateStep.
        RUN ShowStep.
    END.
    
    ON CHOOSE OF btnNext DO:
        /* Validate current step */
        CASE iStep:
            WHEN 1 THEN DO:
                IF cName = "" THEN DO:
                    MESSAGE "Please enter a name."
                        VIEW-AS ALERT-BOX WARNING.
                    RETURN.
                END.
                
                IF cAddress = "" THEN DO:
                    MESSAGE "Please enter an address."
                        VIEW-AS ALERT-BOX WARNING.
                    RETURN.
                END.
                
                IF cPhone = "" THEN DO:
                    MESSAGE "Please enter a phone number."
                        VIEW-AS ALERT-BOX WARNING.
                    RETURN.
                END.
            END.
            WHEN 2 THEN DO:
                IF cCardType = "" THEN DO:
                    MESSAGE "Please select a card type."
                        VIEW-AS ALERT-BOX WARNING.
                    RETURN.
                END.
                
                IF cCardNumber = "" OR LENGTH(cCardNumber) < 13 THEN DO:
                    MESSAGE "Please enter a valid card number."
                        VIEW-AS ALERT-BOX WARNING.
                    RETURN.
                END.
                
                IF dAmount <= 0 THEN DO:
                    MESSAGE "Please enter a valid amount."
                        VIEW-AS ALERT-BOX WARNING.
                    RETURN.
                END.
            END.
            WHEN 3 THEN DO:
                /* Process payment */
                MESSAGE "Payment processed successfully."
                    VIEW-AS ALERT-BOX INFO.
                APPLY "CLOSE" TO FRAME frMain.
                RETURN.
            END.
        END CASE.
        
        /* Move to next step */
        iStep = iStep + 1.
        IF iStep > 3 THEN iStep = 3.
        
        RUN UpdateStep.
        RUN ShowStep.
    END.
    
    ON CHOOSE OF btnCancel DO:
        MESSAGE "Are you sure you want to cancel?"
            UPDATE lCancel
            VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO.
        
        IF lCancel THEN
            APPLY "CLOSE" TO FRAME frMain.
    END.
    
    /* Initialize */
    cName = "".
    cAddress = "".
    cPhone = "".
    cCardType = "".
    cCardNumber = "".
    dAmount = 0.
    
    /* Display main frame */
    DISPLAY txtStep WITH FRAME frMain.
    ENABLE btnBack btnNext btnCancel WITH FRAME frMain.
    
    /* View frames */
    VIEW FRAME frSteps IN FRAME frMain.
    
    /* Show initial step */
    RUN UpdateStep.
    RUN ShowStep.
    
    /* Wait for frame close */
    WAIT-FOR CLOSE OF FRAME frMain.
END PROCEDURE.

/* Usage */
RUN MultipleFrames.
"""
}
