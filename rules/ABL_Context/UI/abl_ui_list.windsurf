# ABL UI List Reference
# List widgets and selection boxes for ABL UI

[metadata]
name = "ABL UI List Reference"
version = "1.0.0"
description = "Reference for ABL UI list widgets and selection boxes"
category = "ui"

[syntax_elements]
# ABL UI list elements

"LIST-BOX" = {
  type = "widget",
  description = "Multi-selection list box widget",
  syntax = "field VIEW-AS SELECTION-LIST [options]",
  example = "cItems VIEW-AS SELECTION-LIST SIZE 30 BY 10."
}

"COMBO-BOX" = {
  type = "widget",
  description = "Drop-down list with input field",
  syntax = "field VIEW-AS COMBO-BOX [options]",
  example = "cSelection VIEW-AS COMBO-BOX SIZE 30 BY 1."
}

"DROP-DOWN" = {
  type = "attribute",
  description = "Creates a drop-down list",
  syntax = "DROP-DOWN",
  example = "VIEW-AS COMBO-BOX DROP-DOWN"
}

"DROP-DOWN-LIST" = {
  type = "attribute",
  description = "Creates a drop-down list without editing",
  syntax = "DROP-DOWN-LIST",
  example = "VIEW-AS COMBO-BOX DROP-DOWN-LIST"
}

"SINGLE" = {
  type = "attribute",
  description = "Single selection for list boxes",
  syntax = "SINGLE",
  example = "VIEW-AS SELECTION-LIST SINGLE"
}

"MULTIPLE" = {
  type = "attribute",
  description = "Multiple selection for list boxes",
  syntax = "MULTIPLE",
  example = "VIEW-AS SELECTION-LIST MULTIPLE"
}

"INNER-LINES" = {
  type = "attribute",
  description = "Number of visible lines in a list box",
  syntax = "INNER-LINES lines",
  example = "INNER-LINES 5"
}

"INNER-CHARS" = {
  type = "attribute",
  description = "Width of list box in characters",
  syntax = "INNER-CHARS chars",
  example = "INNER-CHARS 30"
}

"SORT" = {
  type = "attribute",
  description = "Sorts list items",
  syntax = "SORT",
  example = "VIEW-AS SELECTION-LIST SORT"
}

"LIST-ITEMS" = {
  type = "property",
  description = "Gets or sets the list items",
  syntax = "widget-handle:LIST-ITEMS",
  example = "lstItems:LIST-ITEMS = \"Item1,Item2,Item3\"."
}

"NUM-ITEMS" = {
  type = "property",
  description = "Gets the number of items in a list",
  syntax = "widget-handle:NUM-ITEMS",
  example = "iCount = lstItems:NUM-ITEMS."
}

"SELECTED-ITEMS" = {
  type = "property",
  description = "Gets the selected items in a list",
  syntax = "widget-handle:SELECTED-ITEMS",
  example = "cSelected = lstItems:SELECTED-ITEMS."
}

"ADD-ITEM" = {
  type = "method",
  description = "Adds an item to a list",
  syntax = "widget-handle:ADD-ITEM(item[, index])",
  example = "lstItems:ADD-ITEM(\"New Item\")."
}

"DELETE-ITEM" = {
  type = "method",
  description = "Deletes an item from a list",
  syntax = "widget-handle:DELETE-ITEM(index)",
  example = "lstItems:DELETE-ITEM(5)."
}

"INSERT-ITEM" = {
  type = "method",
  description = "Inserts an item in a list",
  syntax = "widget-handle:INSERT-ITEM(item, index)",
  example = "lstItems:INSERT-ITEM(\"New Item\", 3)."
}

"REPLACE-ITEM" = {
  type = "method",
  description = "Replaces an item in a list",
  syntax = "widget-handle:REPLACE-ITEM(item, index)",
  example = "lstItems:REPLACE-ITEM(\"Updated Item\", 3)."
}

"FIND-ITEM" = {
  type = "method",
  description = "Finds an item in a list",
  syntax = "widget-handle:FIND-ITEM(item)",
  example = "iIndex = lstItems:FIND-ITEM(\"Item1\")."
}

"SELECT-ITEM" = {
  type = "method",
  description = "Selects an item in a list",
  syntax = "widget-handle:SELECT-ITEM(index)",
  example = "lstItems:SELECT-ITEM(3)."
}

"DESELECT-ITEM" = {
  type = "method",
  description = "Deselects an item in a list",
  syntax = "widget-handle:DESELECT-ITEM(index)",
  example = "lstItems:DESELECT-ITEM(3)."
}

"SCREEN-VALUE" = {
  type = "property",
  description = "Gets or sets the selected value",
  syntax = "widget-handle:SCREEN-VALUE",
  example = "cValue = cmbItems:SCREEN-VALUE."
}

"DELIMITER" = {
  type = "property",
  description = "Gets or sets the delimiter for list items",
  syntax = "widget-handle:DELIMITER",
  example = "lstItems:DELIMITER = \",\"."
}

[best_practices]
# Best practices for ABL UI lists

"list_usage" = {
  title = "List Widget Usage Best Practices",
  description = """
When using list widgets, follow these best practices:

1. Choose the appropriate list type based on requirements:
   - Use SELECTION-LIST for multiple selections
   - Use COMBO-BOX with DROP-DOWN for editable drop-downs
   - Use COMBO-BOX with DROP-DOWN-LIST for non-editable drop-downs

2. Set appropriate SIZE or INNER-LINES/INNER-CHARS for visibility
3. Use SORT for alphabetized lists when order is not important
4. Always specify SINGLE or MULTIPLE for SELECTION-LIST widgets
5. Provide clear labels for list widgets

```abl
/* Good practice - selection list */
DEFINE VARIABLE lstItems AS CHARACTER
    VIEW-AS SELECTION-LIST
    MULTIPLE
    SORT
    INNER-LINES 5
    INNER-CHARS 30.

/* Good practice - combo box */
DEFINE VARIABLE cmbStates AS CHARACTER
    VIEW-AS COMBO-BOX
    DROP-DOWN-LIST
    INNER-LINES 10
    INNER-CHARS 30.
```
"""
}

"list_performance" = {
  title = "List Performance Best Practices",
  description = """
When working with large lists, follow these best practices:

1. Limit the number of items loaded at once
2. Consider paging for very large lists
3. Use efficient list population methods
4. Defer UI updates until all items are loaded
5. Use DELIMITER property for efficient bulk updates

```abl
/* Good practice - efficient list population */
PROCEDURE PopulateList:
    DEFINE INPUT PARAMETER plstItems AS HANDLE NO-UNDO.
    DEFINE VARIABLE iTotalItems AS INTEGER NO-UNDO.
    DEFINE VARIABLE iItem AS INTEGER NO-UNDO.
    DEFINE VARIABLE cItems AS CHARACTER NO-UNDO.
    
    /* Disable list during population */
    plstItems:SENSITIVE = FALSE.
    
    /* Clear existing items */
    plstItems:LIST-ITEMS = "".
    
    /* Set delimiter */
    plstItems:DELIMITER = CHR(10).
    
    /* Build item list */
    iTotalItems = 1000.
    cItems = "".
    
    DO iItem = 1 TO iTotalItems:
        /* Add comma except for first item */
        IF iItem > 1 THEN
            cItems = cItems + CHR(10).
        
        /* Add item */
        cItems = cItems + "Item " + STRING(iItem).
    END.
    
    /* Bulk update */
    plstItems:LIST-ITEMS = cItems.
    
    /* Enable list */
    plstItems:SENSITIVE = TRUE.
END PROCEDURE.
```
"""
}

"list_ui_integration" = {
  title = "List UI Integration Best Practices",
  description = """
When integrating lists into your UI, follow these best practices:

1. Provide relevant actions for working with list items
2. Show list status (e.g., number of items, selected count)
3. Consider filtering mechanisms for large lists
4. Group related lists and controls
5. Use appropriate event handlers for list interactions

```abl
/* Good practice - integrated list with controls */
PROCEDURE IntegratedList:
    /* Define variables */
    DEFINE VARIABLE lstItems AS CHARACTER VIEW-AS SELECTION-LIST MULTIPLE.
    DEFINE VARIABLE edFilter AS CHARACTER VIEW-AS FILL-IN.
    DEFINE VARIABLE lModified AS LOGICAL INITIAL FALSE NO-UNDO.
    
    /* Define frame */
    DEFINE FRAME frList
        HEADER "Item Manager"
        SKIP(1)
        "Filter:" VIEW-AS TEXT SKIP(0)
        edFilter LABEL "Filter:" SIZE 30 BY 1 SKIP(1)
        "Items:" VIEW-AS TEXT 
        lstItems VIEW-AS SELECTION-LIST
            MULTIPLE
            SORT
            SIZE 40 BY 10
            SCROLLBAR-VERTICAL
            SCROLLBAR-HORIZONTAL SKIP(1)
        txtStatus VIEW-AS TEXT SIZE 40 BY 1 SKIP(1)
        btnAdd LABEL "Add..." SIZE 10 BY 1
        btnEdit LABEL "Edit..." SIZE 10 BY 1
        btnDelete LABEL "Delete" SIZE 10 BY 1
        btnClear LABEL "Clear" SIZE 10 BY 1
        WITH CENTERED
        SIZE 60 BY 18.
    
    /* Filter event */
    ON VALUE-CHANGED OF edFilter DO:
        RUN ApplyFilter.
    END.
    
    /* Add button */
    ON CHOOSE OF btnAdd DO:
        RUN AddItem.
    END.
    
    /* Edit button */
    ON CHOOSE OF btnEdit DO:
        RUN EditItem.
    END.
    
    /* Delete button */
    ON CHOOSE OF btnDelete DO:
        RUN DeleteItems.
    END.
    
    /* Clear button */
    ON CHOOSE OF btnClear DO:
        RUN ClearList.
    END.
    
    /* Selection changed */
    ON VALUE-CHANGED OF lstItems DO:
        RUN UpdateStatus.
    END.
    
    /* Apply filter */
    PROCEDURE ApplyFilter:
        DEFINE VARIABLE cFilter AS CHARACTER NO-UNDO.
        DEFINE VARIABLE cFullList AS CHARACTER NO-UNDO.
        DEFINE VARIABLE cFilteredList AS CHARACTER NO-UNDO.
        DEFINE VARIABLE iItem AS INTEGER NO-UNDO.
        DEFINE VARIABLE cItem AS CHARACTER NO-UNDO.
        
        /* Get filter */
        cFilter = edFilter:SCREEN-VALUE.
        
        /* If no filter, restore full list */
        IF cFilter = "" THEN DO:
            RUN LoadItems.
            RETURN.
        END.
        
        /* Get original items */
        cFullList = lstItems:PRIVATE-DATA.
        
        /* Apply filter */
        DO iItem = 1 TO NUM-ENTRIES(cFullList):
            cItem = ENTRY(iItem, cFullList).
            
            /* Check if item matches filter */
            IF cItem MATCHES "*" + cFilter + "*" THEN
                cFilteredList = cFilteredList + 
                    (IF cFilteredList = "" THEN "" ELSE ",") + cItem.
        END.
        
        /* Update list */
        lstItems:DELIMITER = ",".
        lstItems:LIST-ITEMS = cFilteredList.
        
        /* Update status */
        RUN UpdateStatus.
    END PROCEDURE.
    
    /* Add item */
    PROCEDURE AddItem:
        DEFINE VARIABLE cNewItem AS CHARACTER NO-UNDO.
        DEFINE VARIABLE cItems AS CHARACTER NO-UNDO.
        
        /* Get new item */
        cNewItem = "".
        MESSAGE "Enter new item:"
            UPDATE cNewItem
            VIEW-AS ALERT-BOX QUESTION.
        
        IF cNewItem = "" THEN
            RETURN.
        
        /* Add to list */
        lstItems:ADD-ITEM(cNewItem).
        
        /* Update private data */
        cItems = lstItems:PRIVATE-DATA.
        IF cItems = "" THEN
            cItems = cNewItem.
        ELSE
            cItems = cItems + "," + cNewItem.
        
        lstItems:PRIVATE-DATA = cItems.
        
        /* Mark as modified */
        lModified = TRUE.
        
        /* Update status */
        RUN UpdateStatus.
    END PROCEDURE.
    
    /* Edit item */
    PROCEDURE EditItem:
        DEFINE VARIABLE cSelectedItem AS CHARACTER NO-UNDO.
        DEFINE VARIABLE iSelectedIndex AS INTEGER NO-UNDO.
        DEFINE VARIABLE cUpdatedItem AS CHARACTER NO-UNDO.
        DEFINE VARIABLE cItems AS CHARACTER NO-UNDO.
        
        /* Get selected item */
        cSelectedItem = lstItems:SCREEN-VALUE.
        iSelectedIndex = lstItems:LOOKUP(cSelectedItem).
        
        IF cSelectedItem = "" THEN DO:
            MESSAGE "Please select an item to edit."
                VIEW-AS ALERT-BOX INFO.
            RETURN.
        END.
        
        /* Get updated item */
        cUpdatedItem = cSelectedItem.
        MESSAGE "Update item:" + SKIP + cSelectedItem
            UPDATE cUpdatedItem
            VIEW-AS ALERT-BOX QUESTION.
        
        IF cUpdatedItem = "" OR cUpdatedItem = cSelectedItem THEN
            RETURN.
        
        /* Update list */
        lstItems:REPLACE-ITEM(cUpdatedItem, iSelectedIndex).
        
        /* Update private data */
        cItems = lstItems:PRIVATE-DATA.
        ENTRY(lstItems:LOOKUP(cUpdatedItem), cItems) = cUpdatedItem.
        lstItems:PRIVATE-DATA = cItems.
        
        /* Mark as modified */
        lModified = TRUE.
        
        /* Update status */
        RUN UpdateStatus.
    END PROCEDURE.
    
    /* Delete items */
    PROCEDURE DeleteItems:
        DEFINE VARIABLE cSelectedItems AS CHARACTER NO-UNDO.
        DEFINE VARIABLE iItem AS INTEGER NO-UNDO.
        DEFINE VARIABLE cItem AS CHARACTER NO-UNDO.
        DEFINE VARIABLE cItems AS CHARACTER NO-UNDO.
        DEFINE VARIABLE lConfirm AS LOGICAL NO-UNDO.
        
        /* Get selected items */
        cSelectedItems = lstItems:SELECTED-ITEMS.
        
        IF cSelectedItems = "" THEN DO:
            MESSAGE "Please select items to delete."
                VIEW-AS ALERT-BOX INFO.
            RETURN.
        END.
        
        /* Confirm deletion */
        lConfirm = FALSE.
        MESSAGE "Delete " + STRING(NUM-ENTRIES(cSelectedItems)) + " item(s)?"
            UPDATE lConfirm
            VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO.
        
        IF NOT lConfirm THEN
            RETURN.
        
        /* Get original items */
        cItems = lstItems:PRIVATE-DATA.
        
        /* Delete items */
        DO iItem = NUM-ENTRIES(cSelectedItems) TO 1 BY -1:
            cItem = ENTRY(iItem, cSelectedItems).
            
            /* Remove from private data */
            ENTRY(lstItems:LOOKUP(cItem), cItems) = "".
        END.
        
        /* Remove empty entries */
        DO WHILE INDEX(cItems, ",,") > 0:
            cItems = REPLACE(cItems, ",,", ",").
        END.
        
        /* Remove leading/trailing commas */
        IF cItems BEGINS "," THEN
            cItems = SUBSTRING(cItems, 2).
        
        IF cItems ENDS "," THEN
            cItems = SUBSTRING(cItems, 1, LENGTH(cItems) - 1).
        
        /* Update private data */
        lstItems:PRIVATE-DATA = cItems.
        
        /* Reload list */
        RUN LoadItems.
        
        /* Mark as modified */
        lModified = TRUE.
        
        /* Update status */
        RUN UpdateStatus.
    END PROCEDURE.
    
    /* Clear list */
    PROCEDURE ClearList:
        DEFINE VARIABLE lConfirm AS LOGICAL NO-UNDO.
        
        /* Confirm clear */
        lConfirm = FALSE.
        MESSAGE "Clear all items?"
            UPDATE lConfirm
            VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO.
        
        IF NOT lConfirm THEN
            RETURN.
        
        /* Clear list */
        lstItems:LIST-ITEMS = "".
        lstItems:PRIVATE-DATA = "".
        
        /* Mark as modified */
        lModified = TRUE.
        
        /* Update status */
        RUN UpdateStatus.
    END PROCEDURE.
    
    /* Update status */
    PROCEDURE UpdateStatus:
        DEFINE VARIABLE iTotal AS INTEGER NO-UNDO.
        DEFINE VARIABLE iSelected AS INTEGER NO-UNDO.
        
        /* Get counts */
        iTotal = lstItems:NUM-ITEMS.
        iSelected = NUM-ENTRIES(lstItems:SELECTED-ITEMS).
        
        /* Build status */
        txtStatus:SCREEN-VALUE = STRING(iTotal) + " items, " + 
            STRING(iSelected) + " selected" + 
            (IF lModified THEN " (modified)" ELSE "").
    END PROCEDURE.
    
    /* Load items */
    PROCEDURE LoadItems:
        DEFINE VARIABLE cItems AS CHARACTER NO-UNDO.
        
        /* Get items */
        cItems = lstItems:PRIVATE-DATA.
        
        /* Load items */
        lstItems:DELIMITER = ",".
        lstItems:LIST-ITEMS = cItems.
        
        /* Update status */
        RUN UpdateStatus.
    END PROCEDURE.
    
    /* Initialize */
    PROCEDURE Initialize:
        /* Sample items */
        DEFINE VARIABLE cItems AS CHARACTER INITIAL
            "Alabama,Alaska,Arizona,Arkansas,California,Colorado," +
            "Connecticut,Delaware,Florida,Georgia,Hawaii,Idaho," +
            "Illinois,Indiana,Iowa,Kansas,Kentucky,Louisiana," +
            "Maine,Maryland,Massachusetts,Michigan,Minnesota," +
            "Mississippi,Missouri,Montana,Nebraska,Nevada," +
            "New Hampshire,New Jersey,New Mexico,New York," +
            "North Carolina,North Dakota,Ohio,Oklahoma,Oregon," +
            "Pennsylvania,Rhode Island,South Carolina,South Dakota," +
            "Tennessee,Texas,Utah,Vermont,Virginia,Washington," +
            "West Virginia,Wisconsin,Wyoming" NO-UNDO.
        
        /* Store original items */
        lstItems:PRIVATE-DATA = cItems.
        
        /* Load items */
        RUN LoadItems.
    END PROCEDURE.
    
    /* Run initialization */
    RUN Initialize.
    
    /* Display and enable */
    DISPLAY edFilter lstItems txtStatus WITH FRAME frList.
    ENABLE edFilter lstItems btnAdd btnEdit btnDelete btnClear WITH FRAME frList.
    
    /* Wait for frame close */
    WAIT-FOR CLOSE OF FRAME frList.
END PROCEDURE.
```
"""
}

[examples]
# Examples of ABL UI lists

"basic_list_example" = {
  title = "Basic List Example",
  description = "Example of a basic selection list widget in ABL",
  code = """
/* Basic selection list example */
PROCEDURE BasicList:
    /* Define variables */
    DEFINE VARIABLE lstItems AS CHARACTER NO-UNDO.
    
    /* Define frame */
    DEFINE FRAME frList
        HEADER "Selection List Example"
        SKIP(1)
        "Select one or more items:" VIEW-AS TEXT SKIP(0)
        lstItems VIEW-AS SELECTION-LIST
            MULTIPLE
            SORT
            SIZE 30 BY 10
            SCROLLBAR-VERTICAL SKIP(1)
        btnClear LABEL "Clear Selection" SIZE 15 BY 1
        btnShow LABEL "Show Selection" SIZE 15 BY 1
        btnClose LABEL "Close" SIZE 15 BY 1
        WITH CENTERED
        SIZE 50 BY 15.
    
    /* Button events */
    ON CHOOSE OF btnClear DO:
        lstItems:SCREEN-VALUE = "".
    END.
    
    ON CHOOSE OF btnShow DO:
        MESSAGE "Selected items:~n" + lstItems:SCREEN-VALUE
            VIEW-AS ALERT-BOX INFO.
    END.
    
    ON CHOOSE OF btnClose DO:
        APPLY "CLOSE" TO FRAME frList.
    END.
    
    /* Set list items */
    lstItems:LIST-ITEMS = "Apple,Banana,Cherry,Date,Elderberry," +
                        "Fig,Grape,Honeydew,Kiwi,Lemon," +
                        "Mango,Nectarine,Orange,Peach,Quince," +
                        "Raspberry,Strawberry,Tangerine,Watermelon".
    
    /* Display and enable */
    DISPLAY lstItems WITH FRAME frList.
    ENABLE lstItems btnClear btnShow btnClose WITH FRAME frList.
    
    /* Wait for frame close */
    WAIT-FOR CLOSE OF FRAME frList.
END PROCEDURE.

/* Usage */
RUN BasicList.
"""
}

"combo_list_example" = {
  title = "Combo Box Example",
  description = "Example of a combo box widget in ABL",
  code = """
/* Combo box example */
PROCEDURE ComboBoxExample:
    /* Define variables */
    DEFINE VARIABLE cmbStates AS CHARACTER NO-UNDO.
    DEFINE VARIABLE cmbCities AS CHARACTER NO-UNDO.
    DEFINE VARIABLE cmbZipCodes AS CHARACTER NO-UNDO.
    
    /* Define frame */
    DEFINE FRAME frCombo
        HEADER "Address Selection"
        SKIP(1)
        "State:" VIEW-AS TEXT 
        cmbStates VIEW-AS COMBO-BOX
            DROP-DOWN-LIST
            SORT
            SIZE 20 BY 1 SKIP(1)
        "City:" VIEW-AS TEXT 
        cmbCities VIEW-AS COMBO-BOX
            DROP-DOWN-LIST
            SORT
            SIZE 20 BY 1 SKIP(1)
        "Zip Code:" VIEW-AS TEXT 
        cmbZipCodes VIEW-AS COMBO-BOX
            DROP-DOWN
            SIZE 10 BY 1 SKIP(2)
        btnOK LABEL "OK" SIZE 10 BY 1
        btnCancel LABEL "Cancel" SIZE 10 BY 1
        WITH CENTERED
        SIZE 40 BY 10.
    
    /* State selection */
    ON VALUE-CHANGED OF cmbStates DO:
        RUN PopulateCities.
    END.
    
    /* City selection */
    ON VALUE-CHANGED OF cmbCities DO:
        RUN PopulateZipCodes.
    END.
    
    /* Button events */
    ON CHOOSE OF btnOK DO:
        DEFINE VARIABLE cState AS CHARACTER NO-UNDO.
        DEFINE VARIABLE cCity AS CHARACTER NO-UNDO.
        DEFINE VARIABLE cZip AS CHARACTER NO-UNDO.
        
        cState = cmbStates:SCREEN-VALUE.
        cCity = cmbCities:SCREEN-VALUE.
        cZip = cmbZipCodes:SCREEN-VALUE.
        
        IF cState = "" OR cCity = "" OR cZip = "" THEN DO:
            MESSAGE "Please complete all selections"
                VIEW-AS ALERT-BOX ERROR.
            RETURN.
        END.
        
        MESSAGE "You selected:~n" +
                "State: " + cState + "~n" +
                "City: " + cCity + "~n" +
                "Zip Code: " + cZip
            VIEW-AS ALERT-BOX INFO.
        
        APPLY "CLOSE" TO FRAME frCombo.
    END.
    
    ON CHOOSE OF btnCancel DO:
        APPLY "CLOSE" TO FRAME frCombo.
    END.
    
    /* Populate cities */
    PROCEDURE PopulateCities:
        DEFINE VARIABLE cState AS CHARACTER NO-UNDO.
        
        cState = cmbStates:SCREEN-VALUE.
        cmbCities:LIST-ITEMS = "".
        cmbZipCodes:LIST-ITEMS = "".
        
        CASE cState:
            WHEN "California" THEN
                cmbCities:LIST-ITEMS = "Los Angeles,San Diego,San Francisco".
            WHEN "New York" THEN
                cmbCities:LIST-ITEMS = "Albany,Buffalo,New York".
            WHEN "Texas" THEN
                cmbCities:LIST-ITEMS = "Austin,Dallas,Houston".
            OTHERWISE
                cmbCities:LIST-ITEMS = "".
        END CASE.
    END PROCEDURE.
    
    /* Populate zip codes */
    PROCEDURE PopulateZipCodes:
        DEFINE VARIABLE cState AS CHARACTER NO-UNDO.
        DEFINE VARIABLE cCity AS CHARACTER NO-UNDO.
        
        cState = cmbStates:SCREEN-VALUE.
        cCity = cmbCities:SCREEN-VALUE.
        cmbZipCodes:LIST-ITEMS = "".
        
        IF cState = "California" THEN DO:
            CASE cCity:
                WHEN "Los Angeles" THEN
                    cmbZipCodes:LIST-ITEMS = "90001,90010,90020".
                WHEN "San Diego" THEN
                    cmbZipCodes:LIST-ITEMS = "92101,92111,92123".
                WHEN "San Francisco" THEN
                    cmbZipCodes:LIST-ITEMS = "94102,94110,94121".
            END CASE.
        END.
        ELSE IF cState = "New York" THEN DO:
            CASE cCity:
                WHEN "Albany" THEN
                    cmbZipCodes:LIST-ITEMS = "12201,12205,12210".
                WHEN "Buffalo" THEN
                    cmbZipCodes:LIST-ITEMS = "14201,14213,14222".
                WHEN "New York" THEN
                    cmbZipCodes:LIST-ITEMS = "10001,10016,10019".
            END CASE.
        END.
        ELSE IF cState = "Texas" THEN DO:
            CASE cCity:
                WHEN "Austin" THEN
                    cmbZipCodes:LIST-ITEMS = "78701,78704,78745".
                WHEN "Dallas" THEN
                    cmbZipCodes:LIST-ITEMS = "75201,75204,75206".
                WHEN "Houston" THEN
                    cmbZipCodes:LIST-ITEMS = "77001,77002,77027".
            END CASE.
        END.
    END PROCEDURE.
    
    /* Set states */
    cmbStates:LIST-ITEMS = "California,New York,Texas".
    
    /* Display and enable */
    DISPLAY cmbStates cmbCities cmbZipCodes WITH FRAME frCombo.
    ENABLE cmbStates cmbCities cmbZipCodes btnOK btnCancel WITH FRAME frCombo.
    
    /* Wait for frame close */
    WAIT-FOR CLOSE OF FRAME frCombo.
END PROCEDURE.

/* Usage */
RUN ComboBoxExample.
"""
}
