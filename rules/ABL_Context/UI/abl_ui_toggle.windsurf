# ABL UI Toggle-Box Reference
# Toggle-box widget for ABL UI

[metadata]
name = "ABL UI Toggle-Box Reference"
version = "1.0.0"
description = "Reference for ABL UI toggle-box widget and best practices"
category = "ui"

[syntax_elements]
# ABL UI toggle-box elements

"TOGGLE-BOX" = {
  type = "widget",
  description = "Checkbox widget for boolean values",
  syntax = "field VIEW-AS TOGGLE-BOX [options]",
  example = "Customer.Active VIEW-AS TOGGLE-BOX."
}

"LABEL" = {
  type = "attribute",
  description = "Specifies the label for a toggle-box",
  syntax = "LABEL \"label\"",
  example = "VIEW-AS TOGGLE-BOX LABEL \"Active\""
}

"CHECKED" = {
  type = "property",
  description = "Gets or sets the checked state of a toggle-box",
  syntax = "widget-handle:CHECKED",
  example = "var logical lActive = chkActive:CHECKED."
}

"VALUE-CHANGED" = {
  type = "event",
  description = "Event triggered when a toggle-box state changes",
  syntax = "ON VALUE-CHANGED OF widget DO:\n    statements\nEND.",
  example = "ON VALUE-CHANGED OF chkActive DO:\n    MESSAGE \"Active state changed\".\nEND."
}

"SENSITIVE" = {
  type = "attribute",
  description = "Makes a toggle-box sensitive to user interaction",
  syntax = "SENSITIVE",
  example = "VIEW-AS TOGGLE-BOX SENSITIVE"
}

"TOOLTIP" = {
  type = "attribute",
  description = "Adds a tooltip to a toggle-box",
  syntax = "TOOLTIP \"tooltip\"",
  example = "VIEW-AS TOGGLE-BOX TOOLTIP \"Check to activate\""
}

[best_practices]
# Best practices for ABL UI toggle-boxes

"toggle_naming" = {
  title = "Toggle-Box Naming Conventions",
  description = """
When naming toggle-box widgets, follow these best practices:

1. Use the 'chk' prefix for toggle-box widgets (short for 'checkbox')
2. Use descriptive names that indicate the toggle's purpose
3. Use consistent naming conventions across the application
4. Follow camelCase or PascalCase naming

```abl
/* Good practice */
DEFINE VARIABLE chkActive AS LOGICAL INITIAL TRUE VIEW-AS TOGGLE-BOX LABEL "Active".
DEFINE VARIABLE chkEmailNotify AS LOGICAL VIEW-AS TOGGLE-BOX LABEL "Email Notifications".
DEFINE VARIABLE chkAgreeTerms AS LOGICAL VIEW-AS TOGGLE-BOX LABEL "I agree to the terms".
```
"""
}

"toggle_layout" = {
  title = "Toggle-Box Layout Best Practices",
  description = """
When laying out toggle-box widgets, follow these best practices:

1. Use clear and concise labels
2. Group related toggles together
3. Use consistent spacing between toggles
4. Align toggles for readability
5. Use SKIP for vertical spacing

```abl
/* Good practice */
DEFINE FRAME frPreferences
    HEADER "User Preferences"
    SKIP(1)
    chkEmailNotify VIEW-AS TOGGLE-BOX LABEL "Email Notifications" SKIP(0)
    chkSmsNotify VIEW-AS TOGGLE-BOX LABEL "SMS Notifications" SKIP(0)
    chkPushNotify VIEW-AS TOGGLE-BOX LABEL "Push Notifications" SKIP(1)
    chkAutoSave VIEW-AS TOGGLE-BOX LABEL "Auto-save Documents" SKIP(0)
    chkDarkMode VIEW-AS TOGGLE-BOX LABEL "Dark Mode"
    WITH SIDE-LABELS
    SIZE 80 BY 10.
```
"""
}

"toggle_behavior" = {
  title = "Toggle-Box Behavior Best Practices",
  description = """
When defining toggle-box behavior, follow these best practices:

1. Use ON VALUE-CHANGED for immediate actions
2. Use logical variables to store toggle states
3. Initialize toggles with appropriate default values
4. Use TOOLTIP for additional information
5. Enable/disable toggles based on context

```abl
/* Good practice */
DEFINE VARIABLE chkAdvanced AS LOGICAL INITIAL FALSE 
    VIEW-AS TOGGLE-BOX LABEL "Advanced Options" 
    TOOLTIP "Show advanced options".

DEFINE VARIABLE chkOption1 AS LOGICAL INITIAL FALSE 
    VIEW-AS TOGGLE-BOX LABEL "Option 1" 
    TOOLTIP "Advanced option 1".

DEFINE VARIABLE chkOption2 AS LOGICAL INITIAL FALSE 
    VIEW-AS TOGGLE-BOX LABEL "Option 2" 
    TOOLTIP "Advanced option 2".

/* Toggle behavior */
ON VALUE-CHANGED OF chkAdvanced DO:
    IF chkAdvanced:CHECKED THEN DO:
        chkOption1:SENSITIVE = TRUE.
        chkOption2:SENSITIVE = TRUE.
    END.
    ELSE DO:
        chkOption1:SENSITIVE = FALSE.
        chkOption2:SENSITIVE = FALSE.
    END.
END.

/* Initialize */
chkOption1:SENSITIVE = FALSE.
chkOption2:SENSITIVE = FALSE.
```
"""
}

[examples]
# Examples of ABL UI toggle-boxes

"basic_toggle_example" = {
  title = "Basic Toggle-Box Example",
  description = "Example of basic toggle-box usage in ABL",
  code = """
/* Basic toggle-box example */
PROCEDURE BasicToggle:
    /* Define variables */
    DEFINE VARIABLE chkActive AS LOGICAL INITIAL TRUE NO-UNDO.
    DEFINE VARIABLE chkEmailNotify AS LOGICAL INITIAL TRUE NO-UNDO.
    DEFINE VARIABLE chkSmsNotify AS LOGICAL INITIAL FALSE NO-UNDO.
    
    /* Define frame */
    DEFINE FRAME frToggle
        HEADER "Toggle-Box Example"
        SKIP(1)
        chkActive VIEW-AS TOGGLE-BOX LABEL "Active Account" SKIP(0)
        chkEmailNotify VIEW-AS TOGGLE-BOX LABEL "Email Notifications" SKIP(0)
        chkSmsNotify VIEW-AS TOGGLE-BOX LABEL "SMS Notifications" SKIP(1)
        btnOK LABEL "OK" SIZE 10 BY 1
        WITH CENTERED
        SIZE 50 BY 10.
    
    /* Button trigger */
    ON CHOOSE OF btnOK DO:
        var logical lActive = chkActive:CHECKED.
        var logical lEmail = chkEmailNotify:CHECKED.
        var logical lSms = chkSmsNotify:CHECKED.
        
        MESSAGE "Active: " + STRING(lActive) + "~n" +
                "Email Notifications: " + STRING(lEmail) + "~n" +
                "SMS Notifications: " + STRING(lSms)
            VIEW-AS ALERT-BOX INFO.
    END.
    
    /* Display frame */
    DISPLAY WITH FRAME frToggle.
    
    /* Enable fields */
    ENABLE chkActive chkEmailNotify chkSmsNotify btnOK WITH FRAME frToggle.
    
    /* Wait for button click */
    WAIT-FOR CHOOSE OF btnOK.
END PROCEDURE.

/* Usage */
RUN BasicToggle.
"""
}

"dependent_toggle_example" = {
  title = "Dependent Toggle-Box Example",
  description = "Example of dependent toggle-boxes in ABL",
  code = """
/* Dependent toggle-box example */
PROCEDURE DependentToggle:
    /* Define variables */
    DEFINE VARIABLE chkAdvanced AS LOGICAL INITIAL FALSE NO-UNDO.
    DEFINE VARIABLE chkOption1 AS LOGICAL INITIAL FALSE NO-UNDO.
    DEFINE VARIABLE chkOption2 AS LOGICAL INITIAL FALSE NO-UNDO.
    DEFINE VARIABLE chkOption3 AS LOGICAL INITIAL FALSE NO-UNDO.
    
    /* Define frame */
    DEFINE FRAME frToggle
        HEADER "Advanced Options"
        SKIP(1)
        chkAdvanced VIEW-AS TOGGLE-BOX LABEL "Enable Advanced Options" SKIP(1)
        "   " VIEW-AS TEXT
        chkOption1 VIEW-AS TOGGLE-BOX LABEL "Advanced Option 1" SKIP(0)
        "   " VIEW-AS TEXT
        chkOption2 VIEW-AS TOGGLE-BOX LABEL "Advanced Option 2" SKIP(0)
        "   " VIEW-AS TEXT
        chkOption3 VIEW-AS TOGGLE-BOX LABEL "Advanced Option 3" SKIP(1)
        btnOK LABEL "OK" SIZE 10 BY 1
        WITH CENTERED
        SIZE 50 BY 12.
    
    /* Advanced options trigger */
    ON VALUE-CHANGED OF chkAdvanced DO:
        IF chkAdvanced:CHECKED THEN DO:
            chkOption1:SENSITIVE = TRUE.
            chkOption2:SENSITIVE = TRUE.
            chkOption3:SENSITIVE = TRUE.
        END.
        ELSE DO:
            chkOption1:SENSITIVE = FALSE.
            chkOption2:SENSITIVE = FALSE.
            chkOption3:SENSITIVE = FALSE.
            
            /* Reset values */
            chkOption1:CHECKED = FALSE.
            chkOption2:CHECKED = FALSE.
            chkOption3:CHECKED = FALSE.
        END.
    END.
    
    /* Button trigger */
    ON CHOOSE OF btnOK DO:
        var logical lAdvanced = chkAdvanced:CHECKED.
        var logical lOption1 = chkOption1:CHECKED.
        var logical lOption2 = chkOption2:CHECKED.
        var logical lOption3 = chkOption3:CHECKED.
        
        MESSAGE "Advanced Options: " + STRING(lAdvanced) + "~n" +
                "Option 1: " + STRING(lOption1) + "~n" +
                "Option 2: " + STRING(lOption2) + "~n" +
                "Option 3: " + STRING(lOption3)
            VIEW-AS ALERT-BOX INFO.
    END.
    
    /* Display frame */
    DISPLAY WITH FRAME frToggle.
    
    /* Initialize */
    chkOption1:SENSITIVE = FALSE.
    chkOption2:SENSITIVE = FALSE.
    chkOption3:SENSITIVE = FALSE.
    
    /* Enable fields */
    ENABLE chkAdvanced chkOption1 chkOption2 chkOption3 btnOK WITH FRAME frToggle.
    
    /* Wait for button click */
    WAIT-FOR CHOOSE OF btnOK.
END PROCEDURE.

/* Usage */
RUN DependentToggle.
"""
}

"toggle_validation_example" = {
  title = "Toggle-Box Validation Example",
  description = "Example of toggle-box validation in ABL",
  code = """
/* Toggle-box validation example */
PROCEDURE ToggleValidation:
    /* Define variables */
    DEFINE VARIABLE edName AS CHARACTER FORMAT "X(30)" NO-UNDO.
    DEFINE VARIABLE edEmail AS CHARACTER FORMAT "X(50)" NO-UNDO.
    DEFINE VARIABLE chkAgree AS LOGICAL INITIAL FALSE NO-UNDO.
    
    /* Define frame */
    DEFINE FRAME frRegistration
        HEADER "Registration Form"
        SKIP(1)
        "Name:" VIEW-AS TEXT SKIP(0)
        edName VIEW-AS FILL-IN SIZE 30 BY 1 SKIP(1)
        "Email:" VIEW-AS TEXT SKIP(0)
        edEmail VIEW-AS FILL-IN SIZE 30 BY 1 SKIP(1)
        chkAgree VIEW-AS TOGGLE-BOX 
            LABEL "I agree to the terms and conditions" SKIP(1)
        btnRegister LABEL "Register" SIZE 15 BY 1
        WITH CENTERED
        SIZE 60 BY 12.
    
    /* Agreement trigger */
    ON VALUE-CHANGED OF chkAgree DO:
        btnRegister:SENSITIVE = chkAgree:CHECKED.
    END.
    
    /* Button trigger */
    ON CHOOSE OF btnRegister DO:
        var character cName = edName:SCREEN-VALUE.
        var character cEmail = edEmail:SCREEN-VALUE.
        var logical lAgree = chkAgree:CHECKED.
        
        /* Validate */
        IF cName = "" THEN DO:
            APPLY "ERROR" TO edName.
            RETURN.
        END.
        
        IF cEmail = "" OR INDEX(cEmail, "@") = 0 THEN DO:
            APPLY "ERROR" TO edEmail.
            RETURN.
        END.
        
        IF NOT lAgree THEN DO:
            MESSAGE "You must agree to the terms and conditions"
                VIEW-AS ALERT-BOX ERROR.
            RETURN.
        END.
        
        /* Submit */
        MESSAGE "Registration successful"
            VIEW-AS ALERT-BOX INFO.
    END.
    
    /* Display frame */
    DISPLAY WITH FRAME frRegistration.
    
    /* Initialize */
    btnRegister:SENSITIVE = FALSE.
    
    /* Enable fields */
    ENABLE edName edEmail chkAgree btnRegister WITH FRAME frRegistration.
    
    /* Wait for button click */
    WAIT-FOR CHOOSE OF btnRegister.
END PROCEDURE.

/* Usage */
RUN ToggleValidation.
"""
}
