# ABL UI Basics Reference
# Basic UI concepts and elements for ABL

[metadata]
name = "ABL UI Basics Reference"
version = "1.0.0"
description = "Reference for basic ABL UI concepts, elements, and best practices"
category = "ui"

[syntax_elements]
# ABL UI basic elements

"DEFINE FRAME" = {
  type = "statement",
  description = "Define a frame for UI elements",
  syntax = "DEFINE FRAME frame-name\n    field1 field2 ...\n    WITH [options].",
  example = "DEFINE FRAME frCustomer\n    Customer.Name Customer.Address\n    WITH TITLE \"Customer Information\"."
}

"DISPLAY" = {
  type = "statement",
  description = "Display values in a frame",
  syntax = "DISPLAY [expression1] [expression2] ... [WITH FRAME frame-name].",
  example = "DISPLAY Customer.Name Customer.Address WITH FRAME frCustomer."
}

"VIEW-AS" = {
  type = "keyword",
  description = "Specifies how a field is displayed",
  syntax = "field VIEW-AS widget-type [options]",
  example = "Customer.Name VIEW-AS FILL-IN SIZE 30 BY 1."
}

"ENABLE" = {
  type = "statement",
  description = "Enable widgets for user interaction",
  syntax = "ENABLE widget1 widget2 ... WITH FRAME frame-name.",
  example = "ENABLE Customer.Name btnSave btnCancel WITH FRAME frCustomer."
}

"DISABLE" = {
  type = "statement",
  description = "Disable widgets for user interaction",
  syntax = "DISABLE widget1 widget2 ... WITH FRAME frame-name.",
  example = "DISABLE Customer.Name btnSave btnCancel WITH FRAME frCustomer."
}

"UPDATE" = {
  type = "statement",
  description = "Update values with user input",
  syntax = "UPDATE field1 field2 ... [WITH FRAME frame-name].",
  example = "UPDATE Customer.Name Customer.Address WITH FRAME frCustomer."
}

"WAIT-FOR" = {
  type = "statement",
  description = "Wait for an event",
  syntax = "WAIT-FOR event OF widget [OR event OF widget] ...",
  example = "WAIT-FOR CHOOSE OF btnSave OR CHOOSE OF btnCancel."
}

"APPLY" = {
  type = "statement",
  description = "Apply changes to fields",
  syntax = "APPLY \"message\" TO field1 field2 ...",
  example = "APPLY \"Changes will be saved\" TO Customer.Name Customer.Address."
}

"MESSAGE" = {
  type = "statement",
  description = "Display a message",
  syntax = "MESSAGE \"message\"\n    VIEW-AS ALERT-BOX [INFO | WARNING | ERROR | QUESTION].",
  example = "MESSAGE \"Operation completed successfully\"\n    VIEW-AS ALERT-BOX INFO."
}

"COLOR" = {
  type = "keyword",
  description = "Specifies colors for UI elements",
  syntax = "WITH [FRAME frame-name] COLOR [DISPLAY | PROMPT | INPUT] value",
  example = "DEFINE FRAME frCustomer\n    Customer.Name\n    WITH COLOR DISPLAY BLUE PROMPT RED."
}

"FONT" = {
  type = "keyword",
  description = "Specifies font for UI elements",
  syntax = "WITH [FRAME frame-name] FONT font-spec",
  example = "DEFINE FRAME frCustomer\n    Customer.Name\n    WITH FONT \"Arial, 12\"."
}

"SIZE" = {
  type = "keyword",
  description = "Specifies size for UI elements",
  syntax = "SIZE width BY height",
  example = "DEFINE FRAME frCustomer\n    Customer.Name\n    WITH SIZE 80 BY 10."
}

"TITLE" = {
  type = "keyword",
  description = "Specifies title for a frame",
  syntax = "WITH TITLE \"title\"",
  example = "DEFINE FRAME frCustomer\n    Customer.Name\n    WITH TITLE \"Customer Information\"."
}

"SIDE-LABELS" = {
  type = "keyword",
  description = "Positions labels to the side of fields",
  syntax = "WITH SIDE-LABELS",
  example = "DEFINE FRAME frCustomer\n    Customer.Name\n    WITH SIDE-LABELS."
}

"CENTERED" = {
  type = "keyword",
  description = "Centers a frame on the screen",
  syntax = "WITH CENTERED",
  example = "DEFINE FRAME frCustomer\n    Customer.Name\n    WITH CENTERED."
}

"COLUMN" = {
  type = "keyword",
  description = "Specifies column position for a field",
  syntax = "field COLUMN column-number",
  example = "DEFINE FRAME frCustomer\n    Customer.Name COLUMN 10\n    Customer.Address COLUMN 10."
}

"ROW" = {
  type = "keyword",
  description = "Specifies row position for a field",
  syntax = "field ROW row-number",
  example = "DEFINE FRAME frCustomer\n    Customer.Name ROW 2\n    Customer.Address ROW 3."
}

"SKIP" = {
  type = "keyword",
  description = "Skips rows in a frame",
  syntax = "SKIP [(lines)]",
  example = "DEFINE FRAME frCustomer\n    Customer.Name\n    SKIP(1)\n    Customer.Address."
}

"SPACE" = {
  type = "keyword",
  description = "Adds horizontal space in a frame",
  syntax = "SPACE [(columns)]",
  example = "DEFINE FRAME frCustomer\n    Customer.Name SPACE(2) Customer.Address."
}

"LABEL" = {
  type = "keyword",
  description = "Specifies a label for a field",
  syntax = "field LABEL \"label\"",
  example = "DEFINE FRAME frCustomer\n    Customer.Name LABEL \"Customer Name\"."
}

"COLON" = {
  type = "keyword",
  description = "Positions the colon for a field label",
  syntax = "field COLON column-number",
  example = "DEFINE FRAME frCustomer\n    Customer.Name LABEL \"Name\" COLON 15."
}

"FORMAT" = {
  type = "keyword",
  description = "Specifies display format for a field",
  syntax = "field FORMAT \"format\"",
  example = "DEFINE FRAME frCustomer\n    Order.Amount FORMAT \"$>>>,>>9.99\"."
}

"NO-LABEL" = {
  type = "keyword",
  description = "Suppresses label for a field",
  syntax = "field NO-LABEL",
  example = "DEFINE FRAME frCustomer\n    Customer.CustNum NO-LABEL."
}

"READ-ONLY" = {
  type = "keyword",
  description = "Makes a field read-only",
  syntax = "field VIEW-AS FILL-IN READ-ONLY",
  example = "DEFINE FRAME frCustomer\n    Customer.CustNum VIEW-AS FILL-IN READ-ONLY."
}

"TOOLTIP" = {
  type = "keyword",
  description = "Adds a tooltip to a field or widget",
  syntax = "field TOOLTIP \"tooltip\"",
  example = "DEFINE FRAME frCustomer\n    Customer.Name TOOLTIP \"Enter customer name\"."
}

"SENSITIVE" = {
  type = "keyword",
  description = "Makes a field or widget sensitive",
  syntax = "field SENSITIVE",
  example = "DEFINE FRAME frCustomer\n    Customer.Name SENSITIVE."
}

"NO-FOCUS" = {
  type = "keyword",
  description = "Prevents a field from receiving focus",
  syntax = "field NO-FOCUS",
  example = "DEFINE FRAME frCustomer\n    Customer.Status NO-FOCUS."
}

[best_practices]
# Best practices for ABL UI basics

"frame_best_practices" = {
  title = "Frame Best Practices",
  description = """
When defining frames, follow these best practices:

1. Use descriptive frame names with the 'fr' prefix
2. Group related fields in a single frame
3. Use consistent layout and formatting
4. Include titles for better usability
5. Use SIDE-LABELS for better readability
6. Use CENTERED for better positioning

```abl
/* Good practice */
DEFINE FRAME frCustomer
    HEADER "Customer Information"
    SKIP(1)
    Customer.CustNum LABEL "Customer ID" COLON 15 VIEW-AS FILL-IN READ-ONLY
    Customer.Name LABEL "Name" COLON 15
    Customer.Address LABEL "Address" COLON 15
    SKIP(1)
    btnSave btnCancel
    WITH CENTERED SIDE-LABELS
    SIZE 80 BY 10.
```
"""
}

"field_display_best_practices" = {
  title = "Field Display Best Practices",
  description = """
When displaying fields, follow these best practices:

1. Use consistent labels for fields
2. Align labels using COLON
3. Use appropriate VIEW-AS widgets
4. Group related fields together
5. Use READ-ONLY for display-only fields
6. Use FORMAT for proper data formatting

```abl
/* Good practice */
DEFINE FRAME frOrder
    HEADER "Order Information"
    SKIP(1)
    Order.OrderNum LABEL "Order #" COLON 15 VIEW-AS FILL-IN READ-ONLY
    Order.OrderDate LABEL "Date" COLON 15 FORMAT "99/99/9999"
    Order.CustNum LABEL "Customer" COLON 15
    Order.Amount LABEL "Amount" COLON 15 FORMAT "$>>>,>>9.99"
    SKIP(1)
    btnProcess btnCancel
    WITH CENTERED SIDE-LABELS
    SIZE 80 BY 10.
```
"""
}

"ui_interaction_best_practices" = {
  title = "UI Interaction Best Practices",
  description = """
When handling UI interactions, follow these best practices:

1. Use ENABLE/DISABLE to control field access
2. Use WAIT-FOR to handle events
3. Use MESSAGE for user feedback
4. Use APPLY for field validation
5. Use UPDATE for user input
6. Handle errors gracefully

```abl
/* Good practice */
PROCEDURE CustomerForm:
    DEFINE INPUT PARAMETER piCustNum AS INTEGER NO-UNDO.
    
    /* Find customer */
    FIND FIRST Customer WHERE Customer.CustNum = piCustNum EXCLUSIVE-LOCK NO-ERROR.
    IF NOT AVAILABLE Customer THEN DO:
        MESSAGE "Customer not found"
            VIEW-AS ALERT-BOX ERROR.
        RETURN.
    END.
    
    /* Display customer */
    DISPLAY
        Customer.CustNum
        Customer.Name
        Customer.Address
        WITH FRAME frCustomer.
    
    /* Enable fields */
    ENABLE
        Customer.Name
        Customer.Address
        btnSave
        btnCancel
        WITH FRAME frCustomer.
    
    /* Wait for user action */
    WAIT-FOR CHOOSE OF btnSave OR CHOOSE OF btnCancel.
    
    /* Process result */
    IF LAST-EVENT:FUNCTION = "CHOOSE" AND
       LAST-EVENT:WIDGET-HANDLE = btnSave:HANDLE THEN DO:
        /* Save changes */
        UPDATE
            Customer.Name
            Customer.Address
            WITH FRAME frCustomer.
        
        /* Validate fields */
        IF Customer.Name = "" THEN
            APPLY "ERROR" TO Customer.Name.
        ELSE
            MESSAGE "Customer saved successfully"
                VIEW-AS ALERT-BOX INFO.
    END.
END PROCEDURE.
```
"""
}

"layout_best_practices" = {
  title = "Layout Best Practices",
  description = """
When designing UI layouts, follow these best practices:

1. Use SKIP and SPACE for proper spacing
2. Use ROW and COLUMN for precise positioning
3. Use SIZE for appropriate dimensions
4. Use FONT for consistent typography
5. Use COLOR for visual emphasis
6. Use TOOLTIP for additional information

```abl
/* Good practice */
DEFINE FRAME frCustomer
    HEADER "Customer Information"
    SKIP(1)
    Customer.CustNum LABEL "Customer ID" COLON 15 ROW 3 COLUMN 5
    Customer.Name LABEL "Name" COLON 15 ROW 4 COLUMN 5 TOOLTIP "Enter customer name"
    Customer.Address LABEL "Address" COLON 15 ROW 5 COLUMN 5
    SKIP(1)
    btnSave LABEL "Save" SIZE 15 BY 1 ROW 7 COLUMN 20
    SPACE(5)
    btnCancel LABEL "Cancel" SIZE 15 BY 1 ROW 7 COLUMN 40
    WITH FONT "Arial, 10"
    COLOR DISPLAY BLUE PROMPT RED
    SIZE 80 BY 10.
```
"""
}

[examples]
# Examples of ABL UI basics

"basic_frame_example" = {
  title = "Basic Frame Example",
  description = "Example of a basic frame in ABL",
  code = """
/* Basic frame example */
PROCEDURE BasicFrame:
    /* Define frame */
    DEFINE FRAME frCustomer
        HEADER "Customer Information"
        SKIP(1)
        Customer.CustNum LABEL "Customer ID" COLON 15
        Customer.Name LABEL "Name" COLON 15
        Customer.Address LABEL "Address" COLON 15
        Customer.City LABEL "City" COLON 15
        Customer.State LABEL "State" COLON 15
        Customer.PostalCode LABEL "Postal Code" COLON 15
        SKIP(1)
        btnSave LABEL "Save" SIZE 15 BY 1
        btnCancel LABEL "Cancel" SIZE 15 BY 1
        WITH CENTERED SIDE-LABELS
        SIZE 80 BY 15.
    
    /* Find customer */
    FIND FIRST Customer WHERE Customer.CustNum = 1001 NO-LOCK NO-ERROR.
    IF NOT AVAILABLE Customer THEN DO:
        MESSAGE "Customer not found"
            VIEW-AS ALERT-BOX ERROR.
        RETURN.
    END.
    
    /* Display customer */
    DISPLAY
        Customer.CustNum
        Customer.Name
        Customer.Address
        Customer.City
        Customer.State
        Customer.PostalCode
        WITH FRAME frCustomer.
    
    /* Enable buttons */
    ENABLE
        btnSave
        btnCancel
        WITH FRAME frCustomer.
    
    /* Wait for user action */
    WAIT-FOR CHOOSE OF btnSave OR CHOOSE OF btnCancel.
    
    /* Process result */
    IF LAST-EVENT:FUNCTION = "CHOOSE" AND
       LAST-EVENT:WIDGET-HANDLE = btnSave:HANDLE THEN
        MESSAGE "Save button clicked"
            VIEW-AS ALERT-BOX INFO.
    ELSE
        MESSAGE "Cancel button clicked"
            VIEW-AS ALERT-BOX INFO.
END PROCEDURE.

/* Usage */
RUN BasicFrame.
"""
}

"interactive_form_example" = {
  title = "Interactive Form Example",
  description = "Example of an interactive form in ABL",
  code = """
/* Interactive form example */
PROCEDURE InteractiveForm:
    DEFINE INPUT PARAMETER piCustNum AS INTEGER NO-UNDO.
    
    /* Local variables */
    var logical lModified = FALSE.
    var logical lSave = FALSE.
    
    /* Define frame */
    DEFINE FRAME frCustomer
        HEADER "Customer Information"
        SKIP(1)
        Customer.CustNum LABEL "Customer ID" COLON 15 VIEW-AS FILL-IN READ-ONLY
        Customer.Name LABEL "Name" COLON 15 TOOLTIP "Enter customer name"
        Customer.Address LABEL "Address" COLON 15
        Customer.City LABEL "City" COLON 15
        Customer.State LABEL "State" COLON 15
        Customer.PostalCode LABEL "Postal Code" COLON 15
        SKIP(1)
        btnSave LABEL "Save" SIZE 15 BY 1 TOOLTIP "Save changes"
        btnCancel LABEL "Cancel" SIZE 15 BY 1 TOOLTIP "Cancel changes"
        WITH CENTERED SIDE-LABELS
        SIZE 80 BY 15
        FONT "Arial, 10".
    
    /* Find customer */
    FIND FIRST Customer WHERE Customer.CustNum = piCustNum EXCLUSIVE-LOCK NO-ERROR.
    IF NOT AVAILABLE Customer THEN DO:
        MESSAGE "Customer not found"
            VIEW-AS ALERT-BOX ERROR.
        RETURN.
    END.
    
    /* Display customer */
    DISPLAY
        Customer.CustNum
        WITH FRAME frCustomer.
    
    /* Enable fields */
    ENABLE
        Customer.Name
        Customer.Address
        Customer.City
        Customer.State
        Customer.PostalCode
        btnSave
        btnCancel
        WITH FRAME frCustomer.
    
    /* Track modifications */
    ON MODIFY OF Customer.Name OR
       MODIFY OF Customer.Address OR
       MODIFY OF Customer.City OR
       MODIFY OF Customer.State OR
       MODIFY OF Customer.PostalCode
       PERSISTENT DO:
        lModified = TRUE.
    END.
    
    /* Button triggers */
    ON CHOOSE OF btnSave PERSISTENT DO:
        lSave = TRUE.
        APPLY "CLOSE" TO FRAME frCustomer.
    END.
    
    ON CHOOSE OF btnCancel PERSISTENT DO:
        lSave = FALSE.
        APPLY "CLOSE" TO FRAME frCustomer.
    END.
    
    /* Wait for user action */
    WAIT-FOR CLOSE OF FRAME frCustomer.
    
    /* Process result */
    IF lSave AND lModified THEN DO:
        /* Update fields */
        UPDATE
            Customer.Name
            Customer.Address
            Customer.City
            Customer.State
            Customer.PostalCode
            WITH FRAME frCustomer.
        
        /* Validate fields */
        IF Customer.Name = "" THEN DO:
            MESSAGE "Name is required"
                VIEW-AS ALERT-BOX ERROR.
            RETURN.
        END.
        
        /* Save changes */
        DO TRANSACTION ON ERROR UNDO, THROW:
            VALIDATE Customer.
            COMMIT.
            MESSAGE "Customer information saved"
                VIEW-AS ALERT-BOX INFORMATION.
        END.
        CATCH eError AS Progress.Lang.Error:
            MESSAGE "Error saving customer: " + eError:GetMessage()
                VIEW-AS ALERT-BOX ERROR.
            UNDO, LEAVE.
        END CATCH.
    END.
    ELSE IF lModified THEN DO:
        /* Discard changes */
        UNDO, LEAVE.
        MESSAGE "Changes discarded"
            VIEW-AS ALERT-BOX INFORMATION.
    END.
END PROCEDURE.

/* Usage */
RUN InteractiveForm (INPUT 1001).
"""
}

"message_example" = {
  title = "Message Example",
  description = "Example of messages in ABL",
  code = """
/* Message example */
PROCEDURE MessageExample:
    /* Information message */
    MESSAGE "This is an information message"
        VIEW-AS ALERT-BOX INFORMATION.
    
    /* Warning message */
    MESSAGE "This is a warning message"
        VIEW-AS ALERT-BOX WARNING.
    
    /* Error message */
    MESSAGE "This is an error message"
        VIEW-AS ALERT-BOX ERROR.
    
    /* Question message */
    MESSAGE "Do you want to continue?"
        VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE lContinue.
    
    /* Process response */
    IF lContinue THEN
        MESSAGE "You chose to continue"
            VIEW-AS ALERT-BOX INFORMATION.
    ELSE
        MESSAGE "You chose to cancel"
            VIEW-AS ALERT-BOX INFORMATION.
END PROCEDURE.

/* Usage */
RUN MessageExample.
"""
}

"layout_example" = {
  title = "Layout Example",
  description = "Example of UI layout in ABL",
  code = """
/* Layout example */
PROCEDURE LayoutExample:
    /* Define frame */
    DEFINE FRAME frLayout
        HEADER "Layout Example"
        SKIP(1)
        
        /* First row */
        lblName LABEL "Name:" ROW 3 COLUMN 5
        edName VIEW-AS FILL-IN SIZE 30 BY 1 ROW 3 COLUMN 15
        
        /* Second row */
        lblAddress LABEL "Address:" ROW 4 COLUMN 5
        edAddress VIEW-AS FILL-IN SIZE 30 BY 1 ROW 4 COLUMN 15
        
        /* Third row */
        lblCity LABEL "City:" ROW 5 COLUMN 5
        edCity VIEW-AS FILL-IN SIZE 15 BY 1 ROW 5 COLUMN 15
        
        lblState LABEL "State:" ROW 5 COLUMN 35
        edState VIEW-AS FILL-IN SIZE 5 BY 1 ROW 5 COLUMN 45
        
        /* Fourth row */
        lblZip LABEL "Zip:" ROW 6 COLUMN 5
        edZip VIEW-AS FILL-IN SIZE 10 BY 1 ROW 6 COLUMN 15
        
        /* Buttons */
        SKIP(2)
        btnOK LABEL "OK" SIZE 10 BY 1 ROW 8 COLUMN 15
        btnCancel LABEL "Cancel" SIZE 10 BY 1 ROW 8 COLUMN 30
        
        WITH SIZE 60 BY 10
        FONT "Arial, 10"
        COLOR DISPLAY BLUE PROMPT RED.
    
    /* Display frame */
    DISPLAY
        lblName
        lblAddress
        lblCity
        lblState
        lblZip
        WITH FRAME frLayout.
    
    /* Enable fields */
    ENABLE
        edName
        edAddress
        edCity
        edState
        edZip
        btnOK
        btnCancel
        WITH FRAME frLayout.
    
    /* Wait for user action */
    WAIT-FOR CHOOSE OF btnOK OR CHOOSE OF btnCancel.
    
    /* Process result */
    IF LAST-EVENT:FUNCTION = "CHOOSE" AND
       LAST-EVENT:WIDGET-HANDLE = btnOK:HANDLE THEN DO:
        /* Get values */
        var character cName = edName:SCREEN-VALUE.
        var character cAddress = edAddress:SCREEN-VALUE.
        var character cCity = edCity:SCREEN-VALUE.
        var character cState = edState:SCREEN-VALUE.
        var character cZip = edZip:SCREEN-VALUE.
        
        /* Display values */
        MESSAGE "Name: " + cName + "~n" +
                "Address: " + cAddress + "~n" +
                "City: " + cCity + "~n" +
                "State: " + cState + "~n" +
                "Zip: " + cZip
            VIEW-AS ALERT-BOX INFORMATION.
    END.
END PROCEDURE.

/* Usage */
RUN LayoutExample.
"""
}
