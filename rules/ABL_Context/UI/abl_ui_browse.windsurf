# ABL UI Browse Reference
# Browse widget for ABL UI - Essential elements only

[metadata]
name = "ABL UI Browse Reference"
version = "1.0.0"
description = "Core reference for ABL UI browse widget"
category = "ui"

[syntax_elements]
# ABL UI browse elements - Core essentials

"BROWSE" = {
  type = "widget",
  description = "Multi-row data display widget",
  syntax = "field VIEW-AS BROWSE [options]",
  example = "Customers VIEW-AS BROWSE."
}

"DISPLAY-COLUMNS" = {
  type = "attribute",
  description = "Specifies columns to display in a browse",
  syntax = "DISPLAY-COLUMNS field1 field2 ...",
  example = "DISPLAY-COLUMNS Customer.CustNum Customer.Name Customer.Address"
}

"ENABLE-COLUMNS" = {
  type = "attribute",
  description = "Enables columns for editing in a browse",
  syntax = "ENABLE-COLUMNS field1 field2 ...",
  example = "ENABLE-COLUMNS Customer.Name Customer.Address"
}

"SIZE" = {
  type = "attribute",
  description = "Specifies the size of a browse",
  syntax = "SIZE width BY height",
  example = "SIZE 60 BY 10"
}

"COLUMN-RESIZABLE" = {
  type = "attribute",
  description = "Allows columns to be resized",
  syntax = "COLUMN-RESIZABLE",
  example = "COLUMN-RESIZABLE"
}

"FIT-LAST-COLUMN" = {
  type = "attribute",
  description = "Makes the last column fill available space",
  syntax = "FIT-LAST-COLUMN",
  example = "FIT-LAST-COLUMN"
}

"ROW-MARKERS" = {
  type = "attribute",
  description = "Displays row markers",
  syntax = "ROW-MARKERS",
  example = "ROW-MARKERS"
}

[best_practices]
# Best practices for ABL UI browse - Core basics

"browse_naming" = {
  title = "Browse Naming Conventions",
  description = """
When naming browse widgets, follow these best practices:

1. Use the 'brw' prefix for browse widgets
2. Use descriptive names that indicate the browse's purpose
3. Use consistent naming conventions across the application

```abl
/* Good practice */
DEFINE VARIABLE brwCustomers AS WIDGET-HANDLE NO-UNDO.
DEFINE VARIABLE brwOrders AS WIDGET-HANDLE NO-UNDO.
```
"""
}

"browse_layout" = {
  title = "Browse Layout Best Practices",
  description = """
When laying out browse widgets, follow these best practices:

1. Set appropriate size for the data being displayed
2. Make columns resizable for better usability
3. Arrange columns in a logical order
4. Use descriptive column labels

```abl
/* Good practice */
DEFINE BROWSE brwCustomers
    DISPLAY 
        Customer.CustNum COLUMN-LABEL "ID"
        Customer.Name COLUMN-LABEL "Name"
        Customer.Address COLUMN-LABEL "Address"
    SIZE 60 BY 10
    COLUMN-RESIZABLE
    FIT-LAST-COLUMN.
```
"""
}

[examples]
# Examples of ABL UI browse - One basic example

"basic_browse_example" = {
  title = "Basic Browse Example",
  description = "Simple example of browse usage in ABL",
  code = """
/* Basic browse example */
PROCEDURE BasicBrowse:
    /* Define frame */
    DEFINE FRAME frBrowse
        HEADER "Customer List"
        SKIP(1)
        brwCustomers
        SKIP(1)
        btnSelect LABEL "Select" SIZE 10 BY 1
        WITH CENTERED
        SIZE 70 BY 15.
    
    /* Define browse */
    DEFINE BROWSE brwCustomers
        DISPLAY 
            Customer.CustNum COLUMN-LABEL "ID"
            Customer.Name COLUMN-LABEL "Name"
            Customer.Address COLUMN-LABEL "Address"
        SIZE 60 BY 10
        COLUMN-RESIZABLE
        ROW-MARKERS
        SEPARATORS
        FIT-LAST-COLUMN.
    
    /* Button trigger */
    ON CHOOSE OF btnSelect DO:
        DEFINE VARIABLE hBrowse AS WIDGET-HANDLE NO-UNDO.
        DEFINE VARIABLE iRow AS INTEGER NO-UNDO.
        
        hBrowse = FRAME frBrowse:HANDLE:FIRST-CHILD.
        iRow = hBrowse:FOCUSED-ROW.
        
        IF iRow > 0 THEN DO:
            hBrowse:SELECT-ROW(iRow).
            hBrowse:FETCH-SELECTED-ROW(1).
            MESSAGE "Selected Customer: " + Customer.Name
                VIEW-AS ALERT-BOX INFO.
        END.
    END.
    
    /* Open query */
    OPEN QUERY brwCustomers FOR EACH Customer NO-LOCK.
    
    /* Display frame */
    DISPLAY WITH FRAME frBrowse.
    
    /* Enable browse and button */
    ENABLE brwCustomers btnSelect WITH FRAME frBrowse.
    
    /* Wait for button click */
    WAIT-FOR CHOOSE OF btnSelect.
END PROCEDURE.

/* Usage */
RUN BasicBrowse.
"""
}
