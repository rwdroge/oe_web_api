# ABL UI Progress Reference
# Progress bars and status indicators for ABL UI

[metadata]
name = "ABL UI Progress Reference"
version = "1.0.0"
description = "Reference for ABL UI progress bars and status indicators"
category = "ui"

[syntax_elements]
# ABL UI progress elements

"PROGRESS" = {
  type = "widget",
  description = "Progress bar widget for indicating completion",
  syntax = "field AS WIDGET-HANDLE VIEW-AS PROGRESS",
  example = "DEFINE VARIABLE prProgress AS WIDGET-HANDLE."
}

"SLIDER" = {
  type = "widget",
  description = "Slider control for selecting a numeric value",
  syntax = "field VIEW-AS SLIDER [options]",
  example = "iVolume VIEW-AS SLIDER SIZE 20 BY 1 MIN-VALUE 0 MAX-VALUE 100 HORIZONTAL"
}

"STATUS-BAR" = {
  type = "function",
  description = "Creates or references the status bar",
  syntax = "STATUS-BAR:parameter",
  example = "STATUS-BAR:MESSAGE = \"Processing...\""
}

"MESSAGE" = {
  type = "attribute",
  description = "Sets the message in a status bar",
  syntax = "STATUS-BAR:MESSAGE = \"message\"",
  example = "STATUS-BAR:MESSAGE = \"Ready\""
}

"GAUGE" = {
  type = "attribute",
  description = "Sets the gauge value in a status bar",
  syntax = "STATUS-BAR:GAUGE = value",
  example = "STATUS-BAR:GAUGE = 75"
}

"PERCENT-TEXT" = {
  type = "attribute",
  description = "Controls the display of percentage text on a progress bar",
  syntax = "PERCENT-TEXT",
  example = "DEFINE VARIABLE prProgress AS WIDGET-HANDLE VIEW-AS PROGRESS PERCENT-TEXT."
}

"HORIZONTAL" = {
  type = "attribute",
  description = "Creates a horizontal progress bar or slider",
  syntax = "HORIZONTAL",
  example = "VIEW-AS PROGRESS HORIZONTAL"
}

"VERTICAL" = {
  type = "attribute",
  description = "Creates a vertical progress bar or slider",
  syntax = "VERTICAL",
  example = "VIEW-AS PROGRESS VERTICAL"
}

"MIN-VALUE" = {
  type = "attribute",
  description = "Sets the minimum value for a slider or progress bar",
  syntax = "MIN-VALUE value",
  example = "MIN-VALUE 0"
}

"MAX-VALUE" = {
  type = "attribute",
  description = "Sets the maximum value for a slider or progress bar",
  syntax = "MAX-VALUE value",
  example = "MAX-VALUE 100"
}

"TIC-MARKS" = {
  type = "attribute",
  description = "Adds tic marks to a slider",
  syntax = "TIC-MARKS",
  example = "VIEW-AS SLIDER TIC-MARKS"
}

"LARGE-TO-SMALL" = {
  type = "attribute",
  description = "Reverses the direction of a slider",
  syntax = "LARGE-TO-SMALL",
  example = "VIEW-AS SLIDER LARGE-TO-SMALL"
}

"CREATE-STATUS-AREA" = {
  type = "attribute",
  description = "Creates a status area in a window",
  syntax = "CREATE-STATUS-AREA = TRUE",
  example = "wMain:CREATE-STATUS-AREA = TRUE."
}

"STATUS-AREA" = {
  type = "attribute",
  description = "Shows or hides the status area in a window",
  syntax = "STATUS-AREA = TRUE | FALSE",
  example = "wMain:STATUS-AREA = TRUE."
}

"PRIVATE-DATA" = {
  type = "attribute",
  description = "Stores data with a widget",
  syntax = "widget-handle:PRIVATE-DATA",
  example = "prProgress:PRIVATE-DATA = STRING(iCurrentFile)."
}

"PROCESS EVENTS" = {
  type = "statement",
  description = "Process pending events to update UI",
  syntax = "PROCESS EVENTS.",
  example = "PROCESS EVENTS."
}

[best_practices]
# Best practices for ABL UI progress indicators

"progress_indicators" = {
  title = "Progress Indicator Best Practices",
  description = """
When using progress indicators, follow these best practices:

1. Show progress for operations that take more than 2 seconds
2. Update progress at regular intervals
3. Include descriptive text explaining the current operation
4. Process events to keep the UI responsive
5. Provide cancel option for long operations

```abl
/* Good practice */
PROCEDURE ProcessFiles:
    DEFINE INPUT PARAMETER pcDirectory AS CHARACTER NO-UNDO.
    DEFINE INPUT PARAMETER piTotalFiles AS INTEGER NO-UNDO.
    
    DEFINE VARIABLE iCurrentFile AS INTEGER INITIAL 0 NO-UNDO.
    DEFINE VARIABLE prProgress AS WIDGET-HANDLE NO-UNDO.
    DEFINE VARIABLE frProgress AS WIDGET-HANDLE NO-UNDO.
    
    /* Create progress window */
    CREATE WINDOW wProgress
        ASSIGN
            TITLE = "Processing Files"
            WIDTH = 60
            HEIGHT = 6
            MESSAGE-AREA = FALSE
            STATUS-AREA = FALSE
            MAX-BUTTON = FALSE
            MIN-BUTTON = FALSE
            RESIZE = FALSE.
    
    /* Create progress frame */
    CREATE FRAME frProgress
        ASSIGN
            FRAME-NAME = "frProgress"
            OVERLAY = TRUE
            PARENT = wProgress.
    
    /* Create progress bar */
    CREATE PROGRESS prProgress
        ASSIGN
            FRAME = frProgress
            X = 2
            Y = 2
            WIDTH-CHARS = 50
            HEIGHT-CHARS = 1
            MAX-VALUE = piTotalFiles
            PERCENT-TEXT = TRUE
            PRIVATE-DATA = "0".
    
    /* Create status label */
    CREATE TEXT txtStatus
        ASSIGN
            FRAME = frProgress
            X = 2
            Y = 3.5
            WIDTH-CHARS = 50
            SCREEN-VALUE = "Initializing...".
    
    /* Display window and frame */
    frProgress:HIDDEN = FALSE.
    wProgress:HIDDEN = FALSE.
    
    /* Process files */
    DO iCurrentFile = 1 TO piTotalFiles:
        /* Update progress bar */
        prProgress:CURRENT-VALUE = iCurrentFile.
        prProgress:PRIVATE-DATA = STRING(iCurrentFile).
        
        /* Update status text */
        txtStatus:SCREEN-VALUE = "Processing file " + 
                                STRING(iCurrentFile) + 
                                " of " + 
                                STRING(piTotalFiles) + 
                                "...".
        
        /* Process events to update UI */
        PROCESS EVENTS.
        
        /* Simulate file processing */
        PAUSE 0.1.
    END.
    
    /* Update completion */
    txtStatus:SCREEN-VALUE = "Processing complete!".
    PROCESS EVENTS.
    
    /* Pause before closing */
    PAUSE 2.
    
    /* Close window */
    DELETE OBJECT wProgress.
END PROCEDURE.
```
"""
}

"status_bar_usage" = {
  title = "Status Bar Usage Best Practices",
  description = """
When using status bars, follow these best practices:

1. Keep status messages brief and informative
2. Use consistent terminology in status messages
3. Show status for all significant actions
4. Clear status after a reasonable timeout
5. Consider using status sections for different information

```abl
/* Good practice - status bar setup */
DEFINE VARIABLE wMain AS WIDGET-HANDLE NO-UNDO.

/* Create window with status bar */
CREATE WINDOW wMain
    ASSIGN
        TITLE = "Main Application"
        WIDTH = 80
        HEIGHT = 25
        STATUS-AREA = TRUE.

/* Status bar sections */
wMain:STATUS-BAR:NUM-PANELS = 3.
wMain:STATUS-BAR:PANEL-WIDTH = "30,20,30".
wMain:STATUS-BAR:PANEL[1]:TEXT = "Ready".
wMain:STATUS-BAR:PANEL[2]:TEXT = "User: Admin".
wMain:STATUS-BAR:PANEL[3]:TEXT = TODAY.

/* Status bar updates */
PROCEDURE UpdateStatus:
    DEFINE INPUT PARAMETER pcStatus AS CHARACTER NO-UNDO.
    DEFINE INPUT PARAMETER piPanel AS INTEGER INITIAL 1 NO-UNDO.
    
    /* Set panel text */
    wMain:STATUS-BAR:PANEL[piPanel]:TEXT = pcStatus.
    
    /* Reset to "Ready" after 5 seconds if panel 1 */
    IF piPanel = 1 THEN DO:
        RUN LATER("ResetStatus").
    END.
END PROCEDURE.

PROCEDURE ResetStatus:
    /* Pause for 5 seconds */
    PAUSE 5 NO-MESSAGE.
    
    /* Reset to ready if not updated since */
    wMain:STATUS-BAR:PANEL[1]:TEXT = "Ready".
END PROCEDURE.

/* Usage examples */
RUN UpdateStatus("Saving data...").
/* ... perform save operation ... */
RUN UpdateStatus("Data saved").
```
"""
}

"progress_for_queries" = {
  title = "Progress Indicators for Queries",
  description = """
When using progress indicators with database queries, follow these best practices:

1. Show progress for queries that might return large result sets
2. Update progress during the query execution
3. Show record count in status messages
4. Allow cancellation of long-running queries
5. Provide feedback on query steps (connecting, fetching, processing)

```abl
/* Good practice - query with progress */
PROCEDURE QueryWithProgress:
    DEFINE VARIABLE prQueryProgress AS WIDGET-HANDLE NO-UNDO.
    DEFINE VARIABLE lCancel AS LOGICAL INITIAL FALSE NO-UNDO.
    DEFINE VARIABLE iRecordCount AS INTEGER INITIAL 0 NO-UNDO.
    DEFINE VARIABLE iEstimatedCount AS INTEGER INITIAL 1000 NO-UNDO.
    
    /* Create progress dialog */
    RUN CreateProgressDialog("Executing Query", OUTPUT prQueryProgress, OUTPUT lCancel).
    
    /* Query with progress updates */
    FOR EACH Customer NO-LOCK:
        /* Check for cancel */
        IF lCancel THEN LEAVE.
        
        /* Update record count */
        iRecordCount = iRecordCount + 1.
        
        /* Update progress every 10 records */
        IF iRecordCount MODULO 10 = 0 THEN DO:
            /* Update progress */
            prQueryProgress:CURRENT-VALUE = MINIMUM(iRecordCount, iEstimatedCount).
            wProgress:STATUS-BAR:MESSAGE = "Processing record " + STRING(iRecordCount).
            
            /* Process events to update UI */
            PROCESS EVENTS.
        END.
        
        /* Process the record... */
        PAUSE 0.01. /* Simulate processing */
    END.
    
    /* Close progress dialog */
    RUN CloseProgressDialog.
    
    /* Show result */
    MESSAGE "Query completed. Processed " + STRING(iRecordCount) + " records."
        VIEW-AS ALERT-BOX INFO.
END PROCEDURE.

/* Create progress dialog */
PROCEDURE CreateProgressDialog:
    DEFINE INPUT PARAMETER pcTitle AS CHARACTER NO-UNDO.
    DEFINE OUTPUT PARAMETER phProgress AS WIDGET-HANDLE NO-UNDO.
    DEFINE OUTPUT PARAMETER plCancel AS LOGICAL NO-UNDO.
    
    /* Create progress window */
    CREATE WINDOW wProgress
        ASSIGN
            TITLE = pcTitle
            WIDTH = 60
            HEIGHT = 8
            MESSAGE-AREA = FALSE
            STATUS-AREA = TRUE
            MAX-BUTTON = FALSE
            MIN-BUTTON = FALSE
            RESIZE = FALSE.
    
    /* Create progress bar */
    CREATE PROGRESS phProgress
        ASSIGN
            PARENT = wProgress
            X = 2
            Y = 2
            WIDTH-CHARS = 50
            HEIGHT-CHARS = 1
            MAX-VALUE = 1000
            PERCENT-TEXT = TRUE.
    
    /* Create cancel button */
    CREATE BUTTON btnCancel
        ASSIGN
            PARENT = wProgress
            LABEL = "Cancel"
            X = 42
            Y = 4
            WIDTH-CHARS = 10
            HEIGHT-CHARS = 1.
    
    /* Cancel button event */
    ON CHOOSE OF btnCancel DO:
        plCancel = TRUE.
        wProgress:STATUS-BAR:MESSAGE = "Cancelling...".
    END.
    
    /* Show window */
    wProgress:HIDDEN = FALSE.
END PROCEDURE.

/* Close progress dialog */
PROCEDURE CloseProgressDialog:
    DELETE OBJECT wProgress.
END PROCEDURE.
```
"""
}

[examples]
# Examples of ABL UI progress indicators

"progress_bar_example" = {
  title = "Progress Bar Example",
  description = "Example of creating and using a progress bar in ABL",
  code = """
/* Progress bar example */
PROCEDURE ProgressBarExample:
    /* Define variables */
    DEFINE VARIABLE prProgress AS WIDGET-HANDLE NO-UNDO.
    DEFINE VARIABLE iStep AS INTEGER INITIAL 0 NO-UNDO.
    DEFINE VARIABLE iTotalSteps AS INTEGER INITIAL 100 NO-UNDO.
    
    /* Define frame */
    DEFINE FRAME frProgress
        HEADER "Progress Example"
        SKIP(1)
        "Progress:" VIEW-AS TEXT SKIP(0)
        prProgress VIEW-AS PROGRESS PERCENT-TEXT
            SIZE 50 BY 1 SKIP(1)
        txtStatus VIEW-AS TEXT
            SIZE 50 BY 1 SKIP(1)
        btnStart LABEL "Start" SIZE 10 BY 1
        btnCancel LABEL "Cancel" SIZE 10 BY 1
        WITH CENTERED
        SIZE 60 BY 8.
    
    /* Initialize progress bar */
    CREATE PROGRESS prProgress
        ASSIGN
            FRAME = FRAME frProgress
            HORIZONTAL = TRUE
            MAX-VALUE = iTotalSteps
            PERCENT-TEXT = TRUE.
    
    /* Start button */
    ON CHOOSE OF btnStart DO:
        DEFINE VARIABLE lCancel AS LOGICAL INITIAL FALSE NO-UNDO.
        
        /* Run the progress operation */
        RUN RunProgressOperation(prProgress, OUTPUT lCancel).
        
        /* Show result */
        IF lCancel THEN
            txtStatus:SCREEN-VALUE = "Operation cancelled!".
        ELSE
            txtStatus:SCREEN-VALUE = "Operation completed successfully!".
    END.
    
    /* Cancel button */
    ON CHOOSE OF btnCancel DO:
        DEFINE VARIABLE lCancel AS LOGICAL INITIAL TRUE NO-UNDO.
        txtStatus:SCREEN-VALUE = "Cancelling...".
    END.
    
    /* Run progress operation */
    PROCEDURE RunProgressOperation:
        DEFINE INPUT PARAMETER phProgress AS WIDGET-HANDLE NO-UNDO.
        DEFINE OUTPUT PARAMETER plCancel AS LOGICAL NO-UNDO.
        
        /* Reset progress */
        phProgress:CURRENT-VALUE = 0.
        txtStatus:SCREEN-VALUE = "Starting operation...".
        PROCESS EVENTS.
        
        /* Process steps */
        DO iStep = 1 TO iTotalSteps WHILE NOT plCancel:
            /* Update progress */
            phProgress:CURRENT-VALUE = iStep.
            txtStatus:SCREEN-VALUE = "Processing step " + STRING(iStep) + " of " + STRING(iTotalSteps) + "...".
            
            /* Process events to update UI */
            PROCESS EVENTS.
            
            /* Simulate processing time */
            PAUSE 0.05.
            
            /* Check for cancel */
            PROCESS EVENTS.
            GET-PROPERTY btnCancel:PRESSED plCancel.
        END.
        
        /* Final update */
        IF NOT plCancel THEN DO:
            phProgress:CURRENT-VALUE = iTotalSteps.
            txtStatus:SCREEN-VALUE = "Operation complete!".
        END.
        
        PROCESS EVENTS.
    END PROCEDURE.
    
    /* Display and enable */
    DISPLAY WITH FRAME frProgress.
    ENABLE btnStart btnCancel WITH FRAME frProgress.
    
    /* Set initial status */
    txtStatus:SCREEN-VALUE = "Ready to start.".
    
    /* Wait for frame close */
    WAIT-FOR CLOSE OF FRAME frProgress.
END PROCEDURE.

/* Usage */
RUN ProgressBarExample.
"""
}

"slider_example" = {
  title = "Slider Control Example",
  description = "Example of creating and using a slider control in ABL",
  code = """
/* Slider control example */
PROCEDURE SliderExample:
    /* Define variables */
    DEFINE VARIABLE iVolume AS INTEGER INITIAL 50 NO-UNDO.
    DEFINE VARIABLE iBrightness AS INTEGER INITIAL 75 NO-UNDO.
    DEFINE VARIABLE iZoom AS INTEGER INITIAL 100 NO-UNDO.
    
    /* Define frame */
    DEFINE FRAME frSliders
        HEADER "Slider Controls"
        SKIP(1)
        "Volume:" VIEW-AS TEXT SKIP(0)
        iVolume VIEW-AS SLIDER 
            MIN-VALUE 0 
            MAX-VALUE 100 
            HORIZONTAL 
            TIC-MARKS
            SIZE 40 BY 1 SKIP(1)
        "Brightness:" VIEW-AS TEXT SKIP(0)
        iBrightness VIEW-AS SLIDER 
            MIN-VALUE 0 
            MAX-VALUE 100 
            HORIZONTAL 
            TIC-MARKS
            SIZE 40 BY 1 SKIP(1)
        "Zoom (%):" VIEW-AS TEXT SKIP(0)
        iZoom VIEW-AS SLIDER 
            MIN-VALUE 50 
            MAX-VALUE 200 
            HORIZONTAL 
            TIC-MARKS
            SIZE 40 BY 1 SKIP(2)
        txtVolume LABEL "Volume: 50%" SIZE 15 BY 1
        txtBrightness LABEL "Brightness: 75%" SIZE 18 BY 1
        txtZoom LABEL "Zoom: 100%" SIZE 15 BY 1 SKIP(1)
        btnDefault LABEL "Defaults" SIZE 12 BY 1
        btnClose LABEL "Close" SIZE 12 BY 1
        WITH CENTERED
        SIZE 60 BY 14.
    
    /* Volume slider events */
    ON VALUE-CHANGED OF iVolume DO:
        DEFINE VARIABLE cValue AS CHARACTER NO-UNDO.
        cValue = "Volume: " + STRING(iVolume) + "%".
        txtVolume:SCREEN-VALUE = cValue.
    END.
    
    /* Brightness slider events */
    ON VALUE-CHANGED OF iBrightness DO:
        DEFINE VARIABLE cValue AS CHARACTER NO-UNDO.
        cValue = "Brightness: " + STRING(iBrightness) + "%".
        txtBrightness:SCREEN-VALUE = cValue.
    END.
    
    /* Zoom slider events */
    ON VALUE-CHANGED OF iZoom DO:
        DEFINE VARIABLE cValue AS CHARACTER NO-UNDO.
        cValue = "Zoom: " + STRING(iZoom) + "%".
        txtZoom:SCREEN-VALUE = cValue.
    END.
    
    /* Default button */
    ON CHOOSE OF btnDefault DO:
        /* Reset to defaults */
        iVolume = 50.
        iBrightness = 75.
        iZoom = 100.
        
        /* Update labels */
        txtVolume:SCREEN-VALUE = "Volume: 50%".
        txtBrightness:SCREEN-VALUE = "Brightness: 75%".
        txtZoom:SCREEN-VALUE = "Zoom: 100%".
        
        /* Display sliders with updated values */
        DISPLAY iVolume iBrightness iZoom WITH FRAME frSliders.
    END.
    
    /* Close button */
    ON CHOOSE OF btnClose DO:
        APPLY "CLOSE" TO FRAME frSliders.
    END.
    
    /* Display and enable */
    DISPLAY 
        iVolume 
        iBrightness 
        iZoom 
        WITH FRAME frSliders.
    
    ENABLE 
        iVolume 
        iBrightness 
        iZoom 
        btnDefault 
        btnClose 
        WITH FRAME frSliders.
    
    /* Wait for frame close */
    WAIT-FOR CLOSE OF FRAME frSliders.
END PROCEDURE.

/* Usage */
RUN SliderExample.
"""
}

"status_bar_example" = {
  title = "Status Bar Example",
  description = "Example of using status bars in ABL",
  code = """
/* Status bar example */
PROCEDURE StatusBarExample:
    /* Define variables */
    DEFINE VARIABLE wMain AS WIDGET-HANDLE NO-UNDO.
    DEFINE VARIABLE hMenu AS WIDGET-HANDLE NO-UNDO.
    
    /* Create main window */
    CREATE WINDOW wMain
        ASSIGN
            TITLE = "Status Bar Example"
            WIDTH = 80
            HEIGHT = 20
            STATUS-AREA = TRUE
            MENU-BAR = TRUE.
    
    /* Create frame */
    DEFINE FRAME frMain
        SKIP(1)
        btnAction1 LABEL "Update Status" SIZE 15 BY 1 SKIP(0.5)
        btnAction2 LABEL "Show Progress" SIZE 15 BY 1 SKIP(0.5)
        btnAction3 LABEL "Reset Status" SIZE 15 BY 1 SKIP(0.5)
        btnClose LABEL "Close" SIZE 15 BY 1 SKIP(0.5)
        WITH CENTERED
        TITLE "Status Bar Operations"
        SIZE 70 BY 14
        NO-BOX
        DEFAULT-BUTTON btnAction1
        CANCEL-BUTTON btnClose
        PARENT wMain.
    
    /* Create menu */
    CREATE MENU hMenu
        ASSIGN
            PARENT = wMain.
    
    /* Create menu items */
    CREATE SUB-MENU mFile
        ASSIGN
            LABEL = "&File"
            PARENT = hMenu.
    
    CREATE MENU-ITEM miExit
        ASSIGN
            LABEL = "E&xit"
            PARENT = mFile.
    
    CREATE SUB-MENU mAction
        ASSIGN
            LABEL = "&Action"
            PARENT = hMenu.
    
    CREATE MENU-ITEM miUpdate
        ASSIGN
            LABEL = "&Update Status"
            PARENT = mAction.
    
    CREATE MENU-ITEM miProgress
        ASSIGN
            LABEL = "Show &Progress"
            PARENT = mAction.
    
    CREATE MENU-ITEM miReset
        ASSIGN
            LABEL = "&Reset Status"
            PARENT = mAction.
    
    /* Set up status bar with panels */
    wMain:STATUS-BAR:NUM-PANELS = 3.
    wMain:STATUS-BAR:PANEL-WIDTH = "30,20,30".
    wMain:STATUS-BAR:PANEL[1]:TEXT = "Ready".
    wMain:STATUS-BAR:PANEL[2]:TEXT = "User: Admin".
    wMain:STATUS-BAR:PANEL[3]:TEXT = STRING(TODAY).
    
    /* Update status function */
    PROCEDURE UpdateStatus:
        DEFINE INPUT PARAMETER pcMessage AS CHARACTER NO-UNDO.
        DEFINE INPUT PARAMETER piPanel AS INTEGER INITIAL 1 NO-UNDO.
        
        /* Update panel text */
        wMain:STATUS-BAR:PANEL[piPanel]:TEXT = pcMessage.
    END PROCEDURE.
    
    /* Show progress function */
    PROCEDURE ShowProgress:
        DEFINE VARIABLE iStep AS INTEGER INITIAL 0 NO-UNDO.
        DEFINE VARIABLE iTotalSteps AS INTEGER INITIAL 100 NO-UNDO.
        
        /* Reset progress */
        wMain:STATUS-BAR:PANEL[1]:TEXT = "Starting operation...".
        wMain:STATUS-BAR:GAUGE:MAX-VALUE = iTotalSteps.
        wMain:STATUS-BAR:GAUGE:CURRENT-VALUE = 0.
        wMain:STATUS-BAR:GAUGE:VISIBLE = TRUE.
        
        /* Process steps */
        DO iStep = 1 TO iTotalSteps:
            /* Update progress */
            wMain:STATUS-BAR:GAUGE:CURRENT-VALUE = iStep.
            wMain:STATUS-BAR:PANEL[1]:TEXT = "Processing step " + 
                                            STRING(iStep) + 
                                            " of " + 
                                            STRING(iTotalSteps) + 
                                            "...".
            
            /* Process events to update UI */
            PROCESS EVENTS.
            
            /* Simulate processing time */
            PAUSE 0.03.
        END.
        
        /* Final update */
        wMain:STATUS-BAR:PANEL[1]:TEXT = "Operation complete!".
        wMain:STATUS-BAR:GAUGE:VISIBLE = FALSE.
    END PROCEDURE.
    
    /* Button events */
    ON CHOOSE OF btnAction1 DO:
        RUN UpdateStatus("Status updated at " + STRING(TIME, "HH:MM:SS")).
    END.
    
    ON CHOOSE OF btnAction2 DO:
        RUN ShowProgress.
    END.
    
    ON CHOOSE OF btnAction3 DO:
        RUN UpdateStatus("Ready").
    END.
    
    ON CHOOSE OF btnClose DO:
        APPLY "CLOSE" TO wMain.
    END.
    
    /* Menu events */
    ON CHOOSE OF miUpdate DO:
        APPLY "CHOOSE" TO btnAction1.
    END.
    
    ON CHOOSE OF miProgress DO:
        APPLY "CHOOSE" TO btnAction2.
    END.
    
    ON CHOOSE OF miReset DO:
        APPLY "CHOOSE" TO btnAction3.
    END.
    
    ON CHOOSE OF miExit DO:
        APPLY "CLOSE" TO wMain.
    END.
    
    /* Display and enable */
    DISPLAY WITH FRAME frMain.
    ENABLE ALL WITH FRAME frMain.
    
    /* View window */
    wMain:HIDDEN = FALSE.
    
    /* Wait for window close */
    WAIT-FOR CLOSE OF wMain.
END PROCEDURE.

/* Usage */
RUN StatusBarExample.
"""
}
