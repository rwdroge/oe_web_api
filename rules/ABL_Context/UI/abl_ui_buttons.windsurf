# ABL UI Buttons Reference
# Button widgets for ABL UI

[metadata]
name = "ABL UI Buttons Reference"
version = "1.0.0"
description = "Reference for ABL UI button widgets and best practices"
category = "ui"

[syntax_elements]
# ABL UI button elements

"DEFINE BUTTON" = {
  type = "statement",
  description = "Define a button widget",
  syntax = "DEFINE BUTTON button-name\n    LABEL \"label\"\n    SIZE width BY height.",
  example = "DEFINE BUTTON btnSave\n    LABEL \"Save\"\n    SIZE 15 BY 1."
}

"BUTTON" = {
  type = "widget",
  description = "Button widget for user interaction",
  syntax = "button-name LABEL \"label\" SIZE width BY height",
  example = "btnSave LABEL \"Save\" SIZE 15 BY 1"
}

"CHOOSE" = {
  type = "event",
  description = "Event triggered when a button is clicked",
  syntax = "ON CHOOSE OF button-name DO:\n    statements\nEND.",
  example = "ON CHOOSE OF btnSave DO:\n    MESSAGE \"Save clicked\".\nEND."
}

"DEFAULT-BUTTON" = {
  type = "attribute",
  description = "Designates a button as the default button",
  syntax = "button-name DEFAULT-BUTTON",
  example = "btnSave DEFAULT-BUTTON"
}

"CANCEL-BUTTON" = {
  type = "attribute",
  description = "Designates a button as the cancel button",
  syntax = "button-name CANCEL-BUTTON",
  example = "btnCancel CANCEL-BUTTON"
}

"AUTO-GO" = {
  type = "attribute",
  description = "Automatically triggers the GO event when clicked",
  syntax = "button-name AUTO-GO",
  example = "btnOK AUTO-GO"
}

"AUTO-END-KEY" = {
  type = "attribute",
  description = "Automatically triggers the END-KEY event when clicked",
  syntax = "button-name AUTO-END-KEY",
  example = "btnCancel AUTO-END-KEY"
}

"IMAGE" = {
  type = "attribute",
  description = "Specifies an image for a button",
  syntax = "button-name IMAGE \"image-file\"",
  example = "btnSave IMAGE \"save.gif\""
}

"IMAGE-UP" = {
  type = "attribute",
  description = "Specifies an image for a button in the up state",
  syntax = "button-name IMAGE-UP \"image-file\"",
  example = "btnSave IMAGE-UP \"save-up.gif\""
}

"IMAGE-DOWN" = {
  type = "attribute",
  description = "Specifies an image for a button in the down state",
  syntax = "button-name IMAGE-DOWN \"image-file\"",
  example = "btnSave IMAGE-DOWN \"save-down.gif\""
}

"IMAGE-INSENSITIVE" = {
  type = "attribute",
  description = "Specifies an image for a button in the insensitive state",
  syntax = "button-name IMAGE-INSENSITIVE \"image-file\"",
  example = "btnSave IMAGE-INSENSITIVE \"save-disabled.gif\""
}

"FLAT-BUTTON" = {
  type = "attribute",
  description = "Creates a flat button without 3D effects",
  syntax = "button-name FLAT-BUTTON",
  example = "btnSave FLAT-BUTTON"
}

"NO-FOCUS" = {
  type = "attribute",
  description = "Prevents a button from receiving focus",
  syntax = "button-name NO-FOCUS",
  example = "btnHelp NO-FOCUS"
}

"SENSITIVE" = {
  type = "attribute",
  description = "Makes a button sensitive to user interaction",
  syntax = "button-name SENSITIVE",
  example = "btnSave SENSITIVE"
}

"TOOLTIP" = {
  type = "attribute",
  description = "Adds a tooltip to a button",
  syntax = "button-name TOOLTIP \"tooltip\"",
  example = "btnSave TOOLTIP \"Save changes\""
}

"TRIGGERS" = {
  type = "block",
  description = "Defines event triggers for a button",
  syntax = "button-name TRIGGERS:\n    ON event PERSISTENT DO:\n        statements\n    END.\nEND TRIGGERS.",
  example = "btnSave TRIGGERS:\n    ON CHOOSE PERSISTENT DO:\n        MESSAGE \"Save clicked\".\n    END.\nEND TRIGGERS."
}

[best_practices]
# Best practices for ABL UI buttons

"button_naming" = {
  title = "Button Naming Conventions",
  description = """
When naming buttons, follow these best practices:

1. Use the 'btn' prefix for button names
2. Use descriptive names that indicate the button's function
3. Use consistent naming conventions across the application
4. Follow camelCase or PascalCase naming

```abl
/* Good practice */
DEFINE BUTTON btnSave LABEL "Save" SIZE 15 BY 1.
DEFINE BUTTON btnCancel LABEL "Cancel" SIZE 15 BY 1.
DEFINE BUTTON btnHelp LABEL "Help" SIZE 15 BY 1.
```
"""
}

"button_layout" = {
  title = "Button Layout Best Practices",
  description = """
When laying out buttons, follow these best practices:

1. Group related buttons together
2. Use consistent sizing for buttons
3. Use consistent spacing between buttons
4. Position buttons at the bottom of forms
5. Place the primary action button first (left to right)
6. Use SPACE to separate buttons

```abl
/* Good practice */
DEFINE FRAME frCustomer
    Customer.Name
    Customer.Address
    SKIP(1)
    btnSave LABEL "Save" SIZE 15 BY 1
    SPACE(2)
    btnCancel LABEL "Cancel" SIZE 15 BY 1
    WITH CENTERED
    SIZE 80 BY 10.
```
"""
}

"button_behavior" = {
  title = "Button Behavior Best Practices",
  description = """
When defining button behavior, follow these best practices:

1. Use TRIGGERS for event handling
2. Use PERSISTENT for event handlers
3. Use DEFAULT-BUTTON for the primary action
4. Use CANCEL-BUTTON for the cancel action
5. Use TOOLTIP for additional information
6. Enable/disable buttons based on context

```abl
/* Good practice */
DEFINE BUTTON btnSave
    LABEL "Save"
    SIZE 15 BY 1
    DEFAULT-BUTTON
    TOOLTIP "Save changes"
    TRIGGERS:
        ON CHOOSE PERSISTENT DO:
            /* Save changes */
            MESSAGE "Changes saved".
        END.
    END TRIGGERS.

DEFINE BUTTON btnCancel
    LABEL "Cancel"
    SIZE 15 BY 1
    CANCEL-BUTTON
    TOOLTIP "Cancel changes"
    TRIGGERS:
        ON CHOOSE PERSISTENT DO:
            /* Cancel changes */
            MESSAGE "Changes canceled".
        END.
    END TRIGGERS.
```
"""
}

"button_appearance" = {
  title = "Button Appearance Best Practices",
  description = """
When defining button appearance, follow these best practices:

1. Use consistent LABEL text
2. Use consistent SIZE for similar buttons
3. Use IMAGE for graphical buttons
4. Use FLAT-BUTTON for modern appearance
5. Use FONT for consistent typography
6. Use COLOR for visual emphasis

```abl
/* Good practice */
DEFINE BUTTON btnSave
    LABEL "Save"
    SIZE 15 BY 1
    FONT "Arial, 10"
    TOOLTIP "Save changes".

DEFINE BUTTON btnDelete
    LABEL "Delete"
    SIZE 15 BY 1
    FONT "Arial, 10"
    TOOLTIP "Delete record".

/* Image button */
DEFINE BUTTON btnHelp
    IMAGE "help.gif"
    SIZE 5 BY 1
    FLAT-BUTTON
    NO-FOCUS
    TOOLTIP "Show help".
```
"""
}

[examples]
# Examples of ABL UI buttons

"basic_buttons_example" = {
  title = "Basic Buttons Example",
  description = "Example of basic button usage in ABL",
  code = """
/* Basic buttons example */
PROCEDURE BasicButtons:
    /* Define frame */
    DEFINE FRAME frButtons
        HEADER "Button Example"
        SKIP(1)
        "Click a button:" SKIP
        btnOK LABEL "OK" SIZE 10 BY 1
        btnCancel LABEL "Cancel" SIZE 10 BY 1
        btnHelp LABEL "Help" SIZE 10 BY 1
        WITH CENTERED
        SIZE 40 BY 8.
    
    /* Button triggers */
    ON CHOOSE OF btnOK DO:
        MESSAGE "OK button clicked"
            VIEW-AS ALERT-BOX INFO.
    END.
    
    ON CHOOSE OF btnCancel DO:
        MESSAGE "Cancel button clicked"
            VIEW-AS ALERT-BOX INFO.
    END.
    
    ON CHOOSE OF btnHelp DO:
        MESSAGE "Help button clicked"
            VIEW-AS ALERT-BOX INFO.
    END.
    
    /* Display frame */
    DISPLAY WITH FRAME frButtons.
    
    /* Enable buttons */
    ENABLE btnOK btnCancel btnHelp WITH FRAME frButtons.
    
    /* Wait for button click */
    WAIT-FOR CHOOSE OF btnOK OR
             CHOOSE OF btnCancel OR
             CHOOSE OF btnHelp.
END PROCEDURE.

/* Usage */
RUN BasicButtons.
"""
}

"button_attributes_example" = {
  title = "Button Attributes Example",
  description = "Example of button attributes in ABL",
  code = """
/* Button attributes example */
PROCEDURE ButtonAttributes:
    /* Define frame */
    DEFINE FRAME frButtons
        HEADER "Button Attributes Example"
        SKIP(1)
        "Default and Cancel buttons:" SKIP
        btnOK LABEL "OK" SIZE 15 BY 1 DEFAULT-BUTTON
        btnCancel LABEL "Cancel" SIZE 15 BY 1 CANCEL-BUTTON
        SKIP(1)
        "Image buttons:" SKIP
        btnCut IMAGE "cut.gif" SIZE 5 BY 1 FLAT-BUTTON
        btnCopy IMAGE "copy.gif" SIZE 5 BY 1 FLAT-BUTTON
        btnPaste IMAGE "paste.gif" SIZE 5 BY 1 FLAT-BUTTON
        SKIP(1)
        "Disabled button:" SKIP
        btnDisabled LABEL "Disabled" SIZE 15 BY 1
        WITH CENTERED
        SIZE 50 BY 12.
    
    /* Button triggers */
    ON CHOOSE OF btnOK DO:
        MESSAGE "OK button clicked"
            VIEW-AS ALERT-BOX INFO.
    END.
    
    ON CHOOSE OF btnCancel DO:
        MESSAGE "Cancel button clicked"
            VIEW-AS ALERT-BOX INFO.
    END.
    
    ON CHOOSE OF btnCut DO:
        MESSAGE "Cut button clicked"
            VIEW-AS ALERT-BOX INFO.
    END.
    
    ON CHOOSE OF btnCopy DO:
        MESSAGE "Copy button clicked"
            VIEW-AS ALERT-BOX INFO.
    END.
    
    ON CHOOSE OF btnPaste DO:
        MESSAGE "Paste button clicked"
            VIEW-AS ALERT-BOX INFO.
    END.
    
    /* Display frame */
    DISPLAY WITH FRAME frButtons.
    
    /* Enable buttons */
    ENABLE btnOK btnCancel btnCut btnCopy btnPaste WITH FRAME frButtons.
    
    /* Wait for button click */
    WAIT-FOR CHOOSE OF btnOK OR
             CHOOSE OF btnCancel OR
             CHOOSE OF btnCut OR
             CHOOSE OF btnCopy OR
             CHOOSE OF btnPaste.
END PROCEDURE.

/* Usage */
RUN ButtonAttributes.
"""
}

"button_triggers_example" = {
  title = "Button Triggers Example",
  description = "Example of button triggers in ABL",
  code = """
/* Button triggers example */
PROCEDURE ButtonTriggers:
    /* Define frame */
    DEFINE FRAME frButtons
        HEADER "Button Triggers Example"
        SKIP(1)
        "Click a button:" SKIP
        btnSave LABEL "Save" SIZE 15 BY 1 TOOLTIP "Save changes"
        btnCancel LABEL "Cancel" SIZE 15 BY 1 TOOLTIP "Cancel changes"
        WITH CENTERED
        SIZE 40 BY 8.
    
    /* Define buttons with triggers */
    DEFINE BUTTON btnSave
        LABEL "Save"
        SIZE 15 BY 1
        TOOLTIP "Save changes"
        TRIGGERS:
            ON CHOOSE PERSISTENT DO:
                MESSAGE "Save button clicked"
                    VIEW-AS ALERT-BOX INFO.
            END.
        END TRIGGERS.
    
    DEFINE BUTTON btnCancel
        LABEL "Cancel"
        SIZE 15 BY 1
        TOOLTIP "Cancel changes"
        TRIGGERS:
            ON CHOOSE PERSISTENT DO:
                MESSAGE "Cancel button clicked"
                    VIEW-AS ALERT-BOX INFO.
            END.
        END TRIGGERS.
    
    /* Display frame */
    DISPLAY WITH FRAME frButtons.
    
    /* Enable buttons */
    ENABLE btnSave btnCancel WITH FRAME frButtons.
    
    /* Wait for button click */
    WAIT-FOR CHOOSE OF btnSave OR CHOOSE OF btnCancel.
END PROCEDURE.

/* Usage */
RUN ButtonTriggers.
"""
}

"dynamic_buttons_example" = {
  title = "Dynamic Buttons Example",
  description = "Example of dynamically enabling/disabling buttons in ABL",
  code = """
/* Dynamic buttons example */
PROCEDURE DynamicButtons:
    /* Local variables */
    var logical lValid = FALSE.
    
    /* Define frame */
    DEFINE FRAME frButtons
        HEADER "Dynamic Buttons Example"
        SKIP(1)
        "Enter your name:" SKIP
        edName VIEW-AS FILL-IN SIZE 30 BY 1 SKIP
        chkAgree LABEL "I agree to the terms" VIEW-AS TOGGLE-BOX SKIP(1)
        btnSubmit LABEL "Submit" SIZE 15 BY 1
        WITH CENTERED
        SIZE 50 BY 10.
    
    /* Button triggers */
    ON CHOOSE OF btnSubmit DO:
        var character cName = edName:SCREEN-VALUE.
        MESSAGE "Thank you, " + cName + "!"
            VIEW-AS ALERT-BOX INFO.
    END.
    
    /* Toggle box trigger */
    ON VALUE-CHANGED OF chkAgree DO:
        IF chkAgree:CHECKED THEN DO:
            btnSubmit:SENSITIVE = TRUE.
        END.
        ELSE DO:
            btnSubmit:SENSITIVE = FALSE.
        END.
    END.
    
    /* Name field trigger */
    ON VALUE-CHANGED OF edName DO:
        var character cName = edName:SCREEN-VALUE.
        IF LENGTH(TRIM(cName)) > 0 THEN
            lValid = TRUE.
        ELSE
            lValid = FALSE.
        
        /* Update button state */
        btnSubmit:SENSITIVE = lValid AND chkAgree:CHECKED.
    END.
    
    /* Display frame */
    DISPLAY WITH FRAME frButtons.
    
    /* Enable fields */
    ENABLE edName chkAgree WITH FRAME frButtons.
    
    /* Initialize button state */
    btnSubmit:SENSITIVE = FALSE.
    ENABLE btnSubmit WITH FRAME frButtons.
    
    /* Wait for button click */
    WAIT-FOR CHOOSE OF btnSubmit.
END PROCEDURE.

/* Usage */
RUN DynamicButtons.
"""
}
