# ABL UI Editor Reference
# Editor widgets and multi-line text fields for ABL UI

[metadata]
name = "ABL UI Editor Reference"
version = "1.0.0"
description = "Reference for ABL UI editor widgets and multi-line text fields"
category = "ui"

[syntax_elements]
# ABL UI editor elements

"EDITOR" = {
  type = "widget",
  description = "Multi-line text editor widget",
  syntax = "field VIEW-AS EDITOR [options]",
  example = "cNotes VIEW-AS EDITOR SIZE 50 BY 10."
}

"SIZE" = {
  type = "attribute",
  description = "Specifies the size of an editor",
  syntax = "SIZE width BY height",
  example = "SIZE 50 BY 10"
}

"LARGE" = {
  type = "attribute",
  description = "Creates a large editor",
  syntax = "LARGE",
  example = "VIEW-AS EDITOR LARGE"
}

"NO-WORD-WRAP" = {
  type = "attribute",
  description = "Disables word wrapping in an editor",
  syntax = "NO-WORD-WRAP",
  example = "VIEW-AS EDITOR NO-WORD-WRAP"
}

"SCROLLBAR-HORIZONTAL" = {
  type = "attribute",
  description = "Adds a horizontal scrollbar to an editor",
  syntax = "SCROLLBAR-HORIZONTAL",
  example = "VIEW-AS EDITOR SCROLLBAR-HORIZONTAL"
}

"SCROLLBAR-VERTICAL" = {
  type = "attribute",
  description = "Adds a vertical scrollbar to an editor",
  syntax = "SCROLLBAR-VERTICAL",
  example = "VIEW-AS EDITOR SCROLLBAR-VERTICAL"
}

"NO-RETURN" = {
  type = "attribute",
  description = "Disables the return key in an editor",
  syntax = "NO-RETURN",
  example = "VIEW-AS EDITOR NO-RETURN"
}

"READ-ONLY" = {
  type = "attribute",
  description = "Makes an editor read-only",
  syntax = "READ-ONLY",
  example = "VIEW-AS EDITOR READ-ONLY"
}

"INSERT-MODE" = {
  type = "attribute",
  description = "Sets the editor to insert mode",
  syntax = "INSERT-MODE",
  example = "VIEW-AS EDITOR INSERT-MODE"
}

"CURSOR-LINE" = {
  type = "property",
  description = "Gets or sets the cursor line in an editor",
  syntax = "widget-handle:CURSOR-LINE",
  example = "iLine = edCode:CURSOR-LINE."
}

"CURSOR-OFFSET" = {
  type = "property",
  description = "Gets or sets the cursor offset in an editor",
  syntax = "widget-handle:CURSOR-OFFSET",
  example = "iOffset = edCode:CURSOR-OFFSET."
}

"NUM-LINES" = {
  type = "property",
  description = "Gets the number of lines in an editor",
  syntax = "widget-handle:NUM-LINES",
  example = "iLines = edCode:NUM-LINES."
}

"TEXT-LINE" = {
  type = "method",
  description = "Gets a specific line of text from an editor",
  syntax = "widget-handle:TEXT-LINE(line-number)",
  example = "cLine = edCode:TEXT-LINE(5)."
}

"INSERT-LINE" = {
  type = "method",
  description = "Inserts a line of text in an editor",
  syntax = "widget-handle:INSERT-LINE(line-number, text)",
  example = "edCode:INSERT-LINE(5, \"New line of text\")."
}

"DELETE-LINE" = {
  type = "method",
  description = "Deletes a line of text from an editor",
  syntax = "widget-handle:DELETE-LINE(line-number)",
  example = "edCode:DELETE-LINE(5)."
}

"SCREEN-VALUE" = {
  type = "property",
  description = "Gets or sets the entire text of an editor",
  syntax = "widget-handle:SCREEN-VALUE",
  example = "cText = edNotes:SCREEN-VALUE."
}

"FONT" = {
  type = "property",
  description = "Gets or sets the font of an editor",
  syntax = "widget-handle:FONT",
  example = "edCode:FONT = \"Courier New, 10\"."
}

"BGCOLOR" = {
  type = "property",
  description = "Gets or sets the background color of an editor",
  syntax = "widget-handle:BGCOLOR",
  example = "edCode:BGCOLOR = 12."
}

"FGCOLOR" = {
  type = "property",
  description = "Gets or sets the foreground color of an editor",
  syntax = "widget-handle:FGCOLOR",
  example = "edCode:FGCOLOR = 1."
}

[best_practices]
# Best practices for ABL UI editors

"editor_usage" = {
  title = "Editor Widget Usage Best Practices",
  description = """
When using editor widgets, follow these best practices:

1. Appropriately size editors based on expected content
2. Use scrollbars for large amounts of text
3. Consider NO-WORD-WRAP for code or structured text
4. Set READ-ONLY for display-only content
5. Use appropriate font for the content type

```abl
/* Good practice - comments/notes editor */
DEFINE VARIABLE edNotes AS CHARACTER
    VIEW-AS EDITOR
    SIZE 50 BY 10
    SCROLLBAR-VERTICAL
    SCROLLBAR-HORIZONTAL.

/* Good practice - code editor */
DEFINE VARIABLE edCode AS CHARACTER
    VIEW-AS EDITOR
    SIZE 80 BY 20
    NO-WORD-WRAP
    SCROLLBAR-VERTICAL
    SCROLLBAR-HORIZONTAL
    FONT "Courier New, 10".
```
"""
}

"editor_performance" = {
  title = "Editor Performance Best Practices",
  description = """
When working with large text in editors, follow these best practices:

1. Limit the amount of text loaded at once
2. Use efficient text manipulation methods
3. Avoid frequent updates to SCREEN-VALUE for large editors
4. Consider line-by-line operations for better performance
5. Use READ-ONLY when editing is not required

```abl
/* Good practice - loading large text */
PROCEDURE LoadLargeFile:
    DEFINE INPUT PARAMETER pcFileName AS CHARACTER NO-UNDO.
    DEFINE VARIABLE edContent AS CHARACTER VIEW-AS EDITOR.
    DEFINE VARIABLE hFile AS HANDLE NO-UNDO.
    DEFINE VARIABLE cLine AS CHARACTER NO-UNDO.
    DEFINE VARIABLE iLine AS INTEGER INITIAL 1 NO-UNDO.
    
    /* Make editor read-only during load for better performance */
    edContent:READ-ONLY = TRUE.
    
    /* Clear editor */
    edContent:SCREEN-VALUE = "".
    
    /* Open file */
    FILE-INFO:FILE-NAME = pcFileName.
    IF FILE-INFO:FULL-PATHNAME = ? THEN
        RETURN.
    
    /* Input file */
    INPUT FROM VALUE(FILE-INFO:FULL-PATHNAME).
    
    /* Read line by line */
    REPEAT:
        IMPORT UNFORMATTED cLine.
        edContent:INSERT-LINE(iLine, cLine).
        iLine = iLine + 1.
    END.
    
    /* Close file */
    INPUT CLOSE.
    
    /* Make editor editable again */
    edContent:READ-ONLY = FALSE.
END PROCEDURE.
```
"""
}

"editor_ui_integration" = {
  title = "Editor UI Integration Best Practices",
  description = """
When integrating editors into your UI, follow these best practices:

1. Provide appropriate context around editors
2. Label editors clearly
3. Consider adding related functionality (search, format, etc.)
4. Validate editor content when appropriate
5. Provide keyboard shortcuts for common operations

```abl
/* Good practice - integrated editor with controls */
PROCEDURE IntegratedEditor:
    /* Define variables */
    DEFINE VARIABLE edDocument AS CHARACTER VIEW-AS EDITOR.
    DEFINE VARIABLE lModified AS LOGICAL INITIAL FALSE NO-UNDO.
    
    /* Define frame */
    DEFINE FRAME frEditor
        HEADER "Document Editor"
        SKIP(1)
        "Document:" VIEW-AS TEXT SKIP(0)
        edDocument VIEW-AS EDITOR
            SIZE 70 BY 15
            SCROLLBAR-VERTICAL
            SCROLLBAR-HORIZONTAL SKIP(1)
        btnLoad LABEL "Load..." SIZE 12 BY 1
        btnSave LABEL "Save..." SIZE 12 BY 1
        btnFind LABEL "Find..." SIZE 12 BY 1
        btnFormat LABEL "Format" SIZE 12 BY 1
        WITH CENTERED
        SIZE 80 BY 20.
    
    /* Load button */
    ON CHOOSE OF btnLoad DO:
        RUN LoadDocument.
    END.
    
    /* Save button */
    ON CHOOSE OF btnSave DO:
        RUN SaveDocument.
    END.
    
    /* Find button */
    ON CHOOSE OF btnFind DO:
        RUN FindText.
    END.
    
    /* Format button */
    ON CHOOSE OF btnFormat DO:
        RUN FormatDocument.
    END.
    
    /* Track modifications */
    ON VALUE-CHANGED OF edDocument DO:
        lModified = TRUE.
    END.
    
    /* Load procedure */
    PROCEDURE LoadDocument:
        DEFINE VARIABLE cFileName AS CHARACTER NO-UNDO.
        
        /* Prompt for file */
        SYSTEM-DIALOG FILE-NAME
            TITLE "Open Document"
            FILTERS "Text Files (*.txt)" "*.txt",
                    "All Files (*.*)" "*.*"
            MUST-EXIST
            UPDATE cFileName.
        
        IF cFileName = "" THEN
            RETURN.
        
        /* Load the file */
        RUN LoadTextFile(cFileName, OUTPUT edDocument:SCREEN-VALUE).
        lModified = FALSE.
    END PROCEDURE.
    
    /* Save procedure */
    PROCEDURE SaveDocument:
        DEFINE VARIABLE cFileName AS CHARACTER NO-UNDO.
        
        /* Prompt for file */
        SYSTEM-DIALOG FILE-NAME
            TITLE "Save Document"
            FILTERS "Text Files (*.txt)" "*.txt",
                    "All Files (*.*)" "*.*"
            SAVE-AS
            UPDATE cFileName.
        
        IF cFileName = "" THEN
            RETURN.
        
        /* Save the file */
        RUN SaveTextFile(cFileName, edDocument:SCREEN-VALUE).
        lModified = FALSE.
    END PROCEDURE.
    
    /* Find procedure */
    PROCEDURE FindText:
        DEFINE VARIABLE cSearchText AS CHARACTER NO-UNDO.
        DEFINE VARIABLE iStartLine AS INTEGER NO-UNDO.
        DEFINE VARIABLE iStartPos AS INTEGER NO-UNDO.
        DEFINE VARIABLE iFoundLine AS INTEGER INITIAL 0 NO-UNDO.
        DEFINE VARIABLE iFoundPos AS INTEGER INITIAL 0 NO-UNDO.
        DEFINE VARIABLE iLine AS INTEGER NO-UNDO.
        DEFINE VARIABLE cLine AS CHARACTER NO-UNDO.
        
        /* Get current position */
        iStartLine = edDocument:CURSOR-LINE.
        iStartPos = edDocument:CURSOR-OFFSET.
        
        /* Get search text */
        cSearchText = "".
        MESSAGE "Enter text to find:"
            UPDATE cSearchText
            VIEW-AS ALERT-BOX QUESTION.
        
        IF cSearchText = "" THEN
            RETURN.
        
        /* Search from current position */
        DO iLine = iStartLine TO edDocument:NUM-LINES:
            cLine = edDocument:TEXT-LINE(iLine).
            
            /* For first line, start from cursor */
            IF iLine = iStartLine THEN
                iFoundPos = INDEX(SUBSTRING(cLine, iStartPos + 1), cSearchText).
            ELSE
                iFoundPos = INDEX(cLine, cSearchText).
            
            /* Found match */
            IF iFoundPos > 0 THEN DO:
                iFoundLine = iLine.
                /* Adjust position for first line */
                IF iLine = iStartLine THEN
                    iFoundPos = iFoundPos + iStartPos.
                LEAVE.
            END.
        END.
        
        /* If not found in remainder, search from beginning */
        IF iFoundLine = 0 THEN DO:
            DO iLine = 1 TO iStartLine - 1:
                cLine = edDocument:TEXT-LINE(iLine).
                iFoundPos = INDEX(cLine, cSearchText).
                
                /* Found match */
                IF iFoundPos > 0 THEN DO:
                    iFoundLine = iLine.
                    LEAVE.
                END.
            END.
        END.
        
        /* Position cursor at found text */
        IF iFoundLine > 0 THEN DO:
            edDocument:CURSOR-LINE = iFoundLine.
            edDocument:CURSOR-OFFSET = iFoundPos - 1.
            MESSAGE "Found at line " + STRING(iFoundLine)
                VIEW-AS ALERT-BOX INFO.
        END ELSE
            MESSAGE "Text not found: " + cSearchText
                VIEW-AS ALERT-BOX INFO.
    END PROCEDURE.
    
    /* Format procedure */
    PROCEDURE FormatDocument:
        /* Simple formatting - capitalize sentences */
        DEFINE VARIABLE cText AS CHARACTER NO-UNDO.
        DEFINE VARIABLE iPos AS INTEGER NO-UNDO.
        DEFINE VARIABLE cChar AS CHARACTER NO-UNDO.
        DEFINE VARIABLE lCapNext AS LOGICAL INITIAL TRUE NO-UNDO.
        DEFINE VARIABLE cFormatted AS CHARACTER NO-UNDO.
        
        /* Get text */
        cText = edDocument:SCREEN-VALUE.
        cFormatted = "".
        
        /* Process each character */
        DO iPos = 1 TO LENGTH(cText):
            cChar = SUBSTRING(cText, iPos, 1).
            
            /* Capitalize first character and after period */
            IF lCapNext AND cChar MATCHES "[a-z]" THEN
                cChar = CAPS(cChar).
            
            /* Add to formatted text */
            cFormatted = cFormatted + cChar.
            
            /* Check for end of sentence */
            IF cChar = "." OR cChar = "!" OR cChar = "?" THEN
                lCapNext = TRUE.
            ELSE IF cChar <> " " AND cChar <> "~n" AND cChar <> "~r" THEN
                lCapNext = FALSE.
        END.
        
        /* Update editor */
        edDocument:SCREEN-VALUE = cFormatted.
    END PROCEDURE.
    
    /* Load text file */
    PROCEDURE LoadTextFile:
        DEFINE INPUT PARAMETER pcFileName AS CHARACTER NO-UNDO.
        DEFINE OUTPUT PARAMETER pcContent AS CHARACTER NO-UNDO.
        
        DEFINE VARIABLE hFile AS HANDLE NO-UNDO.
        DEFINE VARIABLE cLine AS CHARACTER NO-UNDO.
        
        pcContent = "".
        
        /* Open file */
        FILE-INFO:FILE-NAME = pcFileName.
        IF FILE-INFO:FULL-PATHNAME = ? THEN
            RETURN.
        
        /* Input file */
        INPUT FROM VALUE(FILE-INFO:FULL-PATHNAME).
        
        /* Read file */
        REPEAT:
            IMPORT UNFORMATTED cLine.
            pcContent = pcContent + cLine + "~n".
        END.
        
        /* Close file */
        INPUT CLOSE.
    END PROCEDURE.
    
    /* Save text file */
    PROCEDURE SaveTextFile:
        DEFINE INPUT PARAMETER pcFileName AS CHARACTER NO-UNDO.
        DEFINE INPUT PARAMETER pcContent AS CHARACTER NO-UNDO.
        
        /* Output file */
        OUTPUT TO VALUE(pcFileName).
        
        /* Write content */
        PUT UNFORMATTED pcContent.
        
        /* Close file */
        OUTPUT CLOSE.
    END PROCEDURE.
    
    /* Display and enable */
    DISPLAY edDocument WITH FRAME frEditor.
    ENABLE edDocument btnLoad btnSave btnFind btnFormat WITH FRAME frEditor.
    
    /* Wait for frame close */
    WAIT-FOR CLOSE OF FRAME frEditor.
END PROCEDURE.
```
"""
}

[examples]
# Examples of ABL UI editors

"basic_editor_example" = {
  title = "Basic Editor Example",
  description = "Example of a basic editor widget in ABL",
  code = """
/* Basic editor example */
PROCEDURE BasicEditor:
    /* Define variables */
    DEFINE VARIABLE edText AS CHARACTER NO-UNDO.
    
    /* Define frame */
    DEFINE FRAME frEditor
        HEADER "Simple Text Editor"
        SKIP(1)
        "Edit text below:" VIEW-AS TEXT SKIP(0)
        edText VIEW-AS EDITOR
            SIZE 60 BY 15
            SCROLLBAR-VERTICAL
            SCROLLBAR-HORIZONTAL
            LARGE SKIP(1)
        btnClear LABEL "Clear" SIZE 10 BY 1
        btnClose LABEL "Close" SIZE 10 BY 1
        WITH CENTERED
        SIZE 70 BY 20.
    
    /* Button events */
    ON CHOOSE OF btnClear DO:
        edText:SCREEN-VALUE = "".
        APPLY "ENTRY" TO edText.
    END.
    
    ON CHOOSE OF btnClose DO:
        APPLY "CLOSE" TO FRAME frEditor.
    END.
    
    /* Set initial text */
    edText:SCREEN-VALUE = "This is a simple editor widget.~n~n" +
                        "You can enter multiple lines of text.~n~n" +
                        "The editor supports scrolling and word wrapping.".
    
    /* Display and enable */
    DISPLAY edText WITH FRAME frEditor.
    ENABLE edText btnClear btnClose WITH FRAME frEditor.
    
    /* Wait for frame close */
    WAIT-FOR CLOSE OF FRAME frEditor.
END PROCEDURE.

/* Usage */
RUN BasicEditor.
"""
}

"code_editor_example" = {
  title = "Code Editor Example",
  description = "Example of a code editor with syntax highlighting simulation in ABL",
  code = """
/* Code editor example with simulated syntax highlighting */
PROCEDURE CodeEditor:
    /* Define variables */
    DEFINE VARIABLE edCode AS CHARACTER NO-UNDO.
    DEFINE VARIABLE lSyntaxHighlight AS LOGICAL INITIAL TRUE NO-UNDO.
    
    /* Define frame */
    DEFINE FRAME frCodeEditor
        HEADER "ABL Code Editor"
        SKIP(1)
        "Enter ABL code:" VIEW-AS TEXT SKIP(0)
        edCode VIEW-AS EDITOR
            SIZE 70 BY 15
            SCROLLBAR-VERTICAL
            SCROLLBAR-HORIZONTAL
            NO-WORD-WRAP
            FONT "Courier New, 10" SKIP(1)
        chkHighlight LABEL "Syntax Highlighting" SIZE 25 BY 1
            VIEW-AS TOGGLE-BOX CHECKED SKIP(1)
        btnAnalyze LABEL "Analyze Code" SIZE 15 BY 1
        btnFormat LABEL "Format Code" SIZE 15 BY 1
        btnClose LABEL "Close" SIZE 15 BY 1
        WITH CENTERED
        SIZE 80 BY 22.
    
    /* Update syntax highlighting */
    ON VALUE-CHANGED OF chkHighlight DO:
        lSyntaxHighlight = chkHighlight:CHECKED.
        
        /* Apply font based on highlighting */
        IF lSyntaxHighlight THEN
            edCode:FONT = "Courier New, 10, bold".
        ELSE
            edCode:FONT = "Courier New, 10".
    END.
    
    /* Analyze code */
    ON CHOOSE OF btnAnalyze DO:
        DEFINE VARIABLE cCode AS CHARACTER NO-UNDO.
        DEFINE VARIABLE iLines AS INTEGER NO-UNDO.
        DEFINE VARIABLE iProcs AS INTEGER INITIAL 0 NO-UNDO.
        DEFINE VARIABLE iFuncs AS INTEGER INITIAL 0 NO-UNDO.
        DEFINE VARIABLE iLine AS INTEGER NO-UNDO.
        DEFINE VARIABLE cLine AS CHARACTER NO-UNDO.
        
        /* Get code */
        cCode = edCode:SCREEN-VALUE.
        iLines = edCode:NUM-LINES.
        
        /* Count procedures and functions */
        DO iLine = 1 TO iLines:
            cLine = edCode:TEXT-LINE(iLine).
            
            /* Check for procedure */
            IF cLine MATCHES "*PROCEDURE *:*" THEN
                iProcs = iProcs + 1.
            
            /* Check for function */
            IF cLine MATCHES "*FUNCTION *RETURN*:*" THEN
                iFuncs = iFuncs + 1.
        END.
        
        /* Show analysis */
        MESSAGE "Code Analysis:~n" +
                "Lines of code: " + STRING(iLines) + "~n" +
                "Procedures: " + STRING(iProcs) + "~n" +
                "Functions: " + STRING(iFuncs)
            VIEW-AS ALERT-BOX INFO.
    END.
    
    /* Format code */
    ON CHOOSE OF btnFormat DO:
        DEFINE VARIABLE iLine AS INTEGER NO-UNDO.
        DEFINE VARIABLE cLine AS CHARACTER NO-UNDO.
        DEFINE VARIABLE cFormatted AS CHARACTER NO-UNDO.
        DEFINE VARIABLE iIndent AS INTEGER INITIAL 0 NO-UNDO.
        DEFINE VARIABLE cIndent AS CHARACTER NO-UNDO.
        
        /* Process each line */
        DO iLine = 1 TO edCode:NUM-LINES:
            cLine = TRIM(edCode:TEXT-LINE(iLine)).
            
            /* Skip empty lines */
            IF cLine = "" THEN DO:
                cFormatted = cFormatted + "~n".
                NEXT.
            END.
            
            /* Check for block end */
            IF cLine BEGINS "END" OR 
               cLine BEGINS "ELSE" OR 
               cLine BEGINS "END." THEN
                iIndent = MAXIMUM(0, iIndent - 1).
            
            /* Create indent string */
            cIndent = "".
            DO iCount = 1 TO iIndent:
                cIndent = cIndent + "    ".
            END.
            
            /* Add formatted line */
            cFormatted = cFormatted + cIndent + cLine + "~n".
            
            /* Check for block start */
            IF cLine ENDS "DO:" OR 
               cLine ENDS "THEN DO:" OR
               cLine ENDS "ELSE DO:" OR
               cLine MATCHES "*PROCEDURE *:*" OR
               cLine MATCHES "*FUNCTION *:*" THEN
                iIndent = iIndent + 1.
        END.
        
        /* Update editor */
        edCode:SCREEN-VALUE = cFormatted.
    END.
    
    /* Close button */
    ON CHOOSE OF btnClose DO:
        APPLY "CLOSE" TO FRAME frCodeEditor.
    END.
    
    /* Set initial code */
    edCode:SCREEN-VALUE = 
        "/* Example ABL code */~n" +
        "PROCEDURE ExampleProc:~n" +
        "    DEFINE VARIABLE i AS INTEGER NO-UNDO.~n" +
        "    DEFINE VARIABLE cName AS CHARACTER NO-UNDO.~n" +
        "~n" +
        "    DO i = 1 TO 10:~n" +
        "        IF i > 5 THEN DO:~n" +
        "            MESSAGE \"Value: \" + STRING(i).~n" +
        "        END.~n" +
        "    END.~n" +
        "END PROCEDURE.~n" +
        "~n" +
        "FUNCTION CalcTotal RETURNS DECIMAL:~n" +
        "    DEFINE INPUT PARAMETER pdValue AS DECIMAL NO-UNDO.~n" +
        "    DEFINE VARIABLE dTax AS DECIMAL INITIAL 0.1 NO-UNDO.~n" +
        "~n" +
        "    RETURN pdValue * (1 + dTax).~n" +
        "END FUNCTION.".
    
    /* Display and enable */
    DISPLAY edCode chkHighlight WITH FRAME frCodeEditor.
    ENABLE edCode chkHighlight btnAnalyze btnFormat btnClose WITH FRAME frCodeEditor.
    
    /* Set initial font */
    edCode:FONT = "Courier New, 10, bold".
    
    /* Wait for frame close */
    WAIT-FOR CLOSE OF FRAME frCodeEditor.
END PROCEDURE.

/* Usage */
RUN CodeEditor.
"""
}
