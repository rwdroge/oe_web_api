# ABL UI Dialog Reference
# Dialog and message handling for ABL UI

[metadata]
name = "ABL UI Dialog Reference"
version = "1.0.0"
description = "Reference for ABL UI dialog and message handling"
category = "ui"

[syntax_elements]
# ABL UI dialog elements

"MESSAGE" = {
  type = "statement",
  description = "Display a message to the user",
  syntax = "MESSAGE \"message\"\n    VIEW-AS ALERT-BOX [INFO | WARNING | ERROR | QUESTION].",
  example = "MESSAGE \"Operation completed successfully\"\n    VIEW-AS ALERT-BOX INFO."
}

"ALERT-BOX" = {
  type = "widget",
  description = "Alert box for displaying messages",
  syntax = "VIEW-AS ALERT-BOX [INFO | WARNING | ERROR | QUESTION]",
  example = "VIEW-AS ALERT-BOX WARNING"
}

"BUTTONS" = {
  type = "attribute",
  description = "Specifies buttons for an alert box",
  syntax = "BUTTONS [YES-NO | YES-NO-CANCEL | OK-CANCEL | RETRY-CANCEL]",
  example = "VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO"
}

"TITLE" = {
  type = "attribute",
  description = "Specifies a title for a dialog",
  syntax = "TITLE \"title\"",
  example = "TITLE \"Confirmation\""
}

"UPDATE" = {
  type = "attribute",
  description = "Stores the user's response",
  syntax = "UPDATE variable",
  example = "VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE lResponse"
}

"FILE-NAME" = {
  type = "dialog",
  description = "File selection dialog",
  syntax = "SYSTEM-DIALOG FILE-NAME\n    [options]",
  example = "SYSTEM-DIALOG FILE-NAME\n    TITLE \"Open File\"\n    INITIAL-DIR \"c:\\\"\n    FILTERS \"Text Files (*.txt)\" \"*.txt\"\n            \"All Files (*.*)\" \"*.*\"\n    UPDATE cFilename."
}

"GET-DIR" = {
  type = "dialog",
  description = "Directory selection dialog",
  syntax = "SYSTEM-DIALOG GET-DIR\n    [options]",
  example = "SYSTEM-DIALOG GET-DIR\n    TITLE \"Select Directory\"\n    INITIAL-DIR \"c:\\\"\n    UPDATE cDirectory."
}

"COLOR" = {
  type = "dialog",
  description = "Color selection dialog",
  syntax = "SYSTEM-DIALOG COLOR\n    [options]",
  example = "SYSTEM-DIALOG COLOR\n    TITLE \"Select Color\"\n    UPDATE iColor."
}

"FONT" = {
  type = "dialog",
  description = "Font selection dialog",
  syntax = "SYSTEM-DIALOG FONT\n    [options]",
  example = "SYSTEM-DIALOG FONT\n    TITLE \"Select Font\"\n    UPDATE cFont."
}

"PRINTER-SETUP" = {
  type = "dialog",
  description = "Printer setup dialog",
  syntax = "SYSTEM-DIALOG PRINTER-SETUP\n    [options]",
  example = "SYSTEM-DIALOG PRINTER-SETUP\n    TITLE \"Printer Setup\"."
}

"INITIAL-DIR" = {
  type = "attribute",
  description = "Specifies the initial directory for a file dialog",
  syntax = "INITIAL-DIR \"directory\"",
  example = "INITIAL-DIR \"c:\\\""
}

"FILTERS" = {
  type = "attribute",
  description = "Specifies file filters for a file dialog",
  syntax = "FILTERS \"description1\" \"pattern1\"\n        \"description2\" \"pattern2\"",
  example = "FILTERS \"Text Files (*.txt)\" \"*.txt\"\n        \"All Files (*.*)\" \"*.*\""
}

"MUST-EXIST" = {
  type = "attribute",
  description = "Requires that a selected file must exist",
  syntax = "MUST-EXIST",
  example = "MUST-EXIST"
}

"RETURN-TO" = {
  type = "attribute",
  description = "Specifies where to return after a dialog",
  syntax = "RETURN-TO {target}",
  example = "RETURN-TO PROCEDURE"
}

[best_practices]
# Best practices for ABL UI dialogs

"message_best_practices" = {
  title = "Message Dialog Best Practices",
  description = """
When using message dialogs, follow these best practices:

1. Use appropriate alert types:
   - INFO for general information
   - WARNING for potential issues
   - ERROR for errors
   - QUESTION for user decisions

2. Keep messages clear and concise
3. Include specific action information
4. Use consistent terminology
5. Follow a pattern: [What happened] + [Why] + [What to do next]

```abl
/* Good practice */
MESSAGE "Customer record saved successfully."
    VIEW-AS ALERT-BOX INFO.

/* Good error message */
MESSAGE "Unable to save customer record. Database connection lost. Please try again later."
    VIEW-AS ALERT-BOX ERROR.

/* Good question dialog */
MESSAGE "Delete customer record? This action cannot be undone."
    VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE lDelete.
```
"""
}

"dialog_best_practices" = {
  title = "System Dialog Best Practices",
  description = """
When using system dialogs, follow these best practices:

1. Use descriptive titles
2. Set appropriate initial directories
3. Use clear and specific filters for file dialogs
4. Handle cases where no selection was made
5. Validate user selections

```abl
/* Good practice - file selection */
SYSTEM-DIALOG FILE-NAME
    TITLE "Open Customer Data"
    INITIAL-DIR SESSION:TEMP-DIRECTORY
    FILTERS "CSV Files (*.csv)" "*.csv"
            "Excel Files (*.xlsx)" "*.xlsx"
            "All Files (*.*)" "*.*"
    MUST-EXIST
    UPDATE cFilename.

/* Handle no selection */
IF cFilename = "" THEN
    MESSAGE "No file selected. Operation cancelled."
        VIEW-AS ALERT-BOX INFO.
ELSE
    RUN ImportCustomers (INPUT cFilename).
```
"""
}

[examples]
# Examples of ABL UI dialogs

"message_example" = {
  title = "Message Dialog Example",
  description = "Example of different message dialog types in ABL",
  code = """
/* Message dialog example */
PROCEDURE MessageExample:
    /* Local variables */
    DEFINE VARIABLE lResponse AS LOGICAL NO-UNDO.
    DEFINE VARIABLE iResponse AS INTEGER NO-UNDO.
    
    /* Information message */
    MESSAGE "This is an information message."
        VIEW-AS ALERT-BOX INFORMATION.
    
    /* Warning message */
    MESSAGE "This is a warning message."
        VIEW-AS ALERT-BOX WARNING.
    
    /* Error message */
    MESSAGE "This is an error message."
        VIEW-AS ALERT-BOX ERROR.
    
    /* Question message with Yes/No */
    MESSAGE "Would you like to continue?"
        VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE lResponse.
    
    /* Process response */
    IF lResponse THEN
        MESSAGE "You selected Yes."
            VIEW-AS ALERT-BOX INFO.
    ELSE
        MESSAGE "You selected No."
            VIEW-AS ALERT-BOX INFO.
    
    /* Question message with Yes/No/Cancel */
    MESSAGE "Save changes before closing?"
        VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO-CANCEL UPDATE iResponse.
    
    /* Process response */
    CASE iResponse:
        WHEN 1 THEN /* Yes */
            MESSAGE "Saving changes and closing."
                VIEW-AS ALERT-BOX INFO.
        WHEN 0 THEN /* No */
            MESSAGE "Closing without saving."
                VIEW-AS ALERT-BOX INFO.
        WHEN 2 THEN /* Cancel */
            MESSAGE "Operation cancelled."
                VIEW-AS ALERT-BOX INFO.
    END CASE.
END PROCEDURE.

/* Usage */
RUN MessageExample.
"""
}

"file_dialog_example" = {
  title = "File Dialog Example",
  description = "Example of file selection dialogs in ABL",
  code = """
/* File dialog example */
PROCEDURE FileDialogExample:
    /* Local variables */
    DEFINE VARIABLE cFilename AS CHARACTER NO-UNDO.
    DEFINE VARIABLE cDirectory AS CHARACTER NO-UNDO.
    
    /* File open dialog */
    SYSTEM-DIALOG FILE-NAME
        TITLE "Open File"
        INITIAL-DIR SESSION:TEMP-DIRECTORY
        FILTERS "Text Files (*.txt)" "*.txt"
                "CSV Files (*.csv)" "*.csv"
                "All Files (*.*)" "*.*"
        MUST-EXIST
        UPDATE cFilename.
    
    /* Process response */
    IF cFilename = "" THEN
        MESSAGE "No file selected."
            VIEW-AS ALERT-BOX INFO.
    ELSE
        MESSAGE "Selected file: " + cFilename
            VIEW-AS ALERT-BOX INFO.
    
    /* File save dialog */
    SYSTEM-DIALOG FILE-NAME
        TITLE "Save File"
        INITIAL-DIR SESSION:TEMP-DIRECTORY
        FILTERS "Text Files (*.txt)" "*.txt"
                "CSV Files (*.csv)" "*.csv"
                "All Files (*.*)" "*.*"
        DEFAULT-EXTENSION "txt"
        SAVE-AS
        UPDATE cFilename.
    
    /* Process response */
    IF cFilename = "" THEN
        MESSAGE "Save operation cancelled."
            VIEW-AS ALERT-BOX INFO.
    ELSE
        MESSAGE "File will be saved as: " + cFilename
            VIEW-AS ALERT-BOX INFO.
    
    /* Directory selection dialog */
    SYSTEM-DIALOG GET-DIR
        TITLE "Select Directory"
        INITIAL-DIR SESSION:TEMP-DIRECTORY
        UPDATE cDirectory.
    
    /* Process response */
    IF cDirectory = "" THEN
        MESSAGE "No directory selected."
            VIEW-AS ALERT-BOX INFO.
    ELSE
        MESSAGE "Selected directory: " + cDirectory
            VIEW-AS ALERT-BOX INFO.
END PROCEDURE.

/* Usage */
RUN FileDialogExample.
"""
}

"custom_dialog_example" = {
  title = "Custom Dialog Example",
  description = "Example of creating a custom dialog in ABL",
  code = """
/* Custom dialog example */
PROCEDURE CustomDialogExample:
    /* Local variables */
    DEFINE VARIABLE lOK AS LOGICAL INITIAL FALSE NO-UNDO.
    DEFINE VARIABLE cName AS CHARACTER NO-UNDO.
    DEFINE VARIABLE cEmail AS CHARACTER NO-UNDO.
    DEFINE VARIABLE iAge AS INTEGER NO-UNDO.
    DEFINE VARIABLE hDialog AS HANDLE NO-UNDO.
    
    /* Create dialog procedure */
    PROCEDURE CreateDialog:
        /* Create dialog window */
        CREATE WINDOW hDialog
            ASSIGN
                TITLE = "User Information"
                WIDTH = 60
                HEIGHT = 15
                MESSAGE-AREA = FALSE
                STATUS-AREA = FALSE
                MAX-BUTTON = FALSE
                MIN-BUTTON = FALSE
                RESIZE = FALSE
                DIALOG-BOX = TRUE.
        
        /* Form definition */
        FORM
            SKIP(1)
            "Name:" VIEW-AS TEXT SKIP(0)
            cName VIEW-AS FILL-IN SIZE 40 BY 1 SKIP(1)
            "Email:" VIEW-AS TEXT SKIP(0)
            cEmail VIEW-AS FILL-IN SIZE 40 BY 1 SKIP(1)
            "Age:" VIEW-AS TEXT SKIP(0)
            iAge VIEW-AS FILL-IN SIZE 5 BY 1 SKIP(2)
            btnOK LABEL "OK" SIZE 10 BY 1
            btnCancel LABEL "Cancel" SIZE 10 BY 1
            WITH FRAME frDialog
            CENTERED
            VIEW-AS DIALOG-BOX
            DEFAULT-BUTTON btnOK
            CANCEL-BUTTON btnCancel.
        
        /* OK button trigger */
        ON CHOOSE OF btnOK DO:
            /* Validate input */
            IF cName = "" THEN DO:
                MESSAGE "Name is required."
                    VIEW-AS ALERT-BOX ERROR.
                APPLY "ENTRY" TO cName.
                RETURN NO-APPLY.
            END.
            
            IF cEmail = "" OR INDEX(cEmail, "@") = 0 THEN DO:
                MESSAGE "Valid email is required."
                    VIEW-AS ALERT-BOX ERROR.
                APPLY "ENTRY" TO cEmail.
                RETURN NO-APPLY.
            END.
            
            IF iAge = 0 OR iAge < 18 OR iAge > 100 THEN DO:
                MESSAGE "Age must be between 18 and 100."
                    VIEW-AS ALERT-BOX ERROR.
                APPLY "ENTRY" TO iAge.
                RETURN NO-APPLY.
            END.
            
            /* Set result and close */
            lOK = TRUE.
            APPLY "GO" TO FRAME frDialog.
        END.
        
        /* Cancel button trigger */
        ON CHOOSE OF btnCancel DO:
            lOK = FALSE.
            APPLY "GO" TO FRAME frDialog.
        END.
        
        /* Display and wait */
        DISPLAY 
            cName
            cEmail
            iAge
            WITH FRAME frDialog.
        
        ENABLE
            cName
            cEmail
            iAge
            btnOK
            btnCancel
            WITH FRAME frDialog.
        
        WAIT-FOR GO OF FRAME frDialog.
        
        /* Clean up */
        HIDE FRAME frDialog.
        DELETE OBJECT hDialog.
    END PROCEDURE.
    
    /* Run the dialog */
    RUN CreateDialog.
    
    /* Process result */
    IF lOK THEN
        MESSAGE "User information:~n" +
                "Name: " + cName + "~n" +
                "Email: " + cEmail + "~n" +
                "Age: " + STRING(iAge)
            VIEW-AS ALERT-BOX INFO.
    ELSE
        MESSAGE "Dialog cancelled."
            VIEW-AS ALERT-BOX INFO.
END PROCEDURE.

/* Usage */
RUN CustomDialogExample.
"""
}
