# ABL Core Language Elements Reference
# Core language elements, operators, and syntax for ABL

[metadata]
name = "ABL Core Language Elements"
version = "1.0.0"
description = "Reference for ABL core language elements and operators"
category = "core"

[syntax]
# Complete list of ABL operators
operators = [
    # Arithmetic operators
    "+", "-", "*", "/", "^", "**", 
    "+=", "-=", "*=", "/=",
    
    # Comparison operators
    "=", "<>", "<", "<=", ">", ">=", "MATCHES", "BEGINS", "CONTAINS",
    
    # Logical operators
    "AND", "OR", "NOT", "XOR",
    
    # Bitwise operators
    "BITAND", "BITOR", "BITXOR", "BITNOT",
    
    # String operators
    ":", ":=", "+" /* string concatenation */,
    
    # Assignment operators
    "=", ":=", "+=", "-=", "*=", "/=",
    
    # Special operators
    "?", /* safe navigation */
    "?=", /* conditional assignment */
    "?.", /* conditional access */
    "??", /* null coalescing */
    "->", /* method invocation */
    "=>", /* lambda expression */
    "::", /* namespace access */
    "@", /* annotation */
    "...", /* spread operator */
]

# Special symbols
symbols = [
    "{", "}", "[", "]", "(", ")", ".", ",", ":", ";", "?", "!", "&",
    "#", "%", "@", "$", "|", "~", "`", "\\", "<", ">", "="
]

[syntax_elements]

"?" = {
  type = "operator",
  description = "Safe navigation operator",
  syntax = "object?:property",
  example = "cValue = oCustomer?:Name."
}

"{}" = {
  type = "operator",
  description = "Include file/argument reference",
  syntax = "{file-name}",
  example = "{include/customer.i}"
}

"[]" = {
  type = "operator",
  description = "Array reference",
  syntax = "array[index]",
  example = "cValue = cArray[1]."
}

"\"\"" = {
  type = "operator",
  description = "Character-string literal",
  syntax = "\"string\"",
  example = "cName = \"John Doe\"."
}

"<T>" = {
  type = "operator",
  description = "Generic type reference",
  syntax = "Class<Type>",
  example = "List<String>"
}

"+" = {
  type = "operator",
  description = "Addition or string concatenation",
  syntax = "a + b",
  example = "iTotal = iValue1 + iValue2."
}

"-" = {
  type = "operator",
  description = "Subtraction",
  syntax = "a - b",
  example = "iDifference = iValue1 - iValue2."
}

"*" = {
  type = "operator",
  description = "Multiplication",
  syntax = "a * b",
  example = "iProduct = iValue1 * iValue2."
}

"/" = {
  type = "operator",
  description = "Division",
  syntax = "a / b",
  example = "dQuotient = iValue1 / iValue2."
}

"+=" = {
  type = "operator",
  description = "Addition assignment",
  syntax = "a += b",
  example = "iTotal += iValue."
}

"-=" = {
  type = "operator",
  description = "Subtraction assignment",
  syntax = "a -= b",
  example = "iTotal -= iValue."
}

"*=" = {
  type = "operator",
  description = "Multiplication assignment",
  syntax = "a *= b",
  example = "iTotal *= iValue."
}

"/=" = {
  type = "operator",
  description = "Division assignment",
  syntax = "a /= b",
  example = "iTotal /= iValue."
}

"=" = {
  type = "operator",
  description = "Equality comparison or assignment",
  syntax = "a = b",
  example = "IF iValue = 10 THEN"
}

"<>" = {
  type = "operator",
  description = "Inequality comparison",
  syntax = "a <> b",
  example = "IF iValue <> 10 THEN"
}

"<" = {
  type = "operator",
  description = "Less than comparison",
  syntax = "a < b",
  example = "IF iValue < 10 THEN"
}

"<=" = {
  type = "operator",
  description = "Less than or equal comparison",
  syntax = "a <= b",
  example = "IF iValue <= 10 THEN"
}

">" = {
  type = "operator",
  description = "Greater than comparison",
  syntax = "a > b",
  example = "IF iValue > 10 THEN"
}

">=" = {
  type = "operator",
  description = "Greater than or equal comparison",
  syntax = "a >= b",
  example = "IF iValue >= 10 THEN"
}

"/*...*/" = {
  type = "comment",
  description = "Multi-line comment",
  syntax = "/* comment */",
  example = "/* This is a multi-line\n   comment */"
}

"//" = {
  type = "comment",
  description = "Single-line comment",
  syntax = "// comment",
  example = "// This is a single-line comment"
}

"&GLOBAL-DEFINE" = {
  type = "preprocessor",
  description = "Define a global preprocessor variable",
  syntax = "&GLOBAL-DEFINE name value",
  example = "&GLOBAL-DEFINE MAX_CUSTOMERS 1000"
}

"&SCOPED-DEFINE" = {
  type = "preprocessor",
  description = "Define a scoped preprocessor variable",
  syntax = "&SCOPED-DEFINE name value",
  example = "&SCOPED-DEFINE WINDOW_TITLE \"Customer Management\""
}

"&UNDEFINE" = {
  type = "preprocessor",
  description = "Undefine a preprocessor variable",
  syntax = "&UNDEFINE name",
  example = "&UNDEFINE MAX_CUSTOMERS"
}

"&IF" = {
  type = "preprocessor",
  description = "Conditional preprocessor directive",
  syntax = "&IF condition &THEN",
  example = "&IF DEFINED(DEBUG) &THEN"
}

"&THEN" = {
  type = "preprocessor",
  description = "Then clause for conditional preprocessor directive",
  syntax = "&IF condition &THEN",
  example = "&IF DEFINED(DEBUG) &THEN"
}

"&ELSEIF" = {
  type = "preprocessor",
  description = "Else-if clause for conditional preprocessor directive",
  syntax = "&ELSEIF condition &THEN",
  example = "&ELSEIF DEFINED(TEST) &THEN"
}

"&ELSE" = {
  type = "preprocessor",
  description = "Else clause for conditional preprocessor directive",
  syntax = "&ELSE",
  example = "&ELSE"
}

"&ENDIF" = {
  type = "preprocessor",
  description = "End of conditional preprocessor directive",
  syntax = "&ENDIF",
  example = "&ENDIF"
}

"CAST" = {
  type = "function",
  description = "Cast an object to a specific type",
  syntax = "CAST(expression, type)",
  example = "hButton = CAST(hWidget, \"Button\")."
}

"DYNAMIC-CAST" = {
  type = "function",
  description = "Dynamically cast an object to a specific type",
  syntax = "DYNAMIC-CAST(expression, type)",
  example = "oCustomer = DYNAMIC-CAST(oEntity, \"Customer\")."
}

[best_practices]
# Best practices for ABL core language elements

"variable_declaration" = {
  title = "Modern Variable Declaration",
  description = """
Use the modern 'var' keyword for local variable declarations. The 'var' keyword implicitly includes 'no-undo', so you don't need to specify it.

```abl
/* Modern variable declarations - var is implicitly no-undo */
var character cName.
var integer   iCount.
var decimal   dAmount.
var logical   lValid.
var handle    hWidget.
```

For parameters, you still need to explicitly include 'no-undo':

```abl
define input parameter piInput as integer no-undo.
define output parameter poOutput as character no-undo.
```

The old style requires explicit 'no-undo':

```abl
DEFINE VARIABLE cName AS CHARACTER NO-UNDO.
```
"""
}

"variable_naming" = {
  title = "Variable Naming Conventions",
  description = """
Follow these variable naming conventions:
- c prefix for CHARACTER
- i prefix for INTEGER
- d prefix for DECIMAL
- l prefix for LOGICAL
- h prefix for HANDLE
- p prefix for PARAMETERS (pi for input, po for output)

```abl
var character cName.
var integer   iCount.
var decimal   dAmount.
var logical   lValid.
var handle    hWidget.
define input parameter piInput as integer no-undo.
define output parameter poOutput as character no-undo.
```
"""
}

"scope_rules" = {
  title = "Variable Scope Rules",
  description = """
Variables have different scopes depending on where they are declared:

```abl
/* Function scope */
FUNCTION myFunc RETURNS LOGICAL
    (input piParam as integer no-undo):
    var integer iCount.
    RETURN TRUE.
END.

/* Block scope */
DO:
    var character cTemp.
END.
```
"""
}

"comments" = {
  title = "Comment Best Practices",
  description = """
Use comments effectively to document your code:

```abl
/* 
 * Multi-line comment for detailed documentation
 * Provides overview of procedures, functions, or complex logic
 */

// Single-line comment for brief explanations

/* Inline comment */ var integer iCount.
```
"""
}

"operators" = {
  title = "Operator Usage",
  description = """
Use operators consistently:

```abl
// Arithmetic operators
iSum = iValue1 + iValue2.
iDifference = iValue1 - iValue2.
iProduct = iValue1 * iValue2.
dQuotient = iValue1 / iValue2.

// Compound assignment
iTotal += iValue.
iTotal -= iValue.
iTotal *= iValue.
iTotal /= iValue.

// Comparison operators
IF iValue = 10 THEN // Equality
IF iValue <> 10 THEN // Inequality
IF iValue < 10 THEN // Less than
IF iValue <= 10 THEN // Less than or equal
IF iValue > 10 THEN // Greater than
IF iValue >= 10 THEN // Greater than or equal

// String concatenation
cFullName = cFirstName + " " + cLastName.
```
"""
}

[examples]
# Examples of ABL core language elements

"variable_declaration_example" = {
  title = "Variable Declaration Examples",
  description = "Examples of variable declarations in ABL",
  code = """
/* Modern variable declarations with var */
var character cName = "John Doe".
var integer   iAge = 30.
var decimal   dSalary = 50000.50.
var logical   lActive = TRUE.
var date      dtHireDate = TODAY.
var datetime  dtTimestamp = NOW.

/* Parameters with explicit no-undo */
PROCEDURE CalculateSalary:
    DEFINE INPUT  PARAMETER piEmployeeId AS INTEGER   NO-UNDO.
    DEFINE INPUT  PARAMETER piMonths     AS INTEGER   NO-UNDO.
    DEFINE OUTPUT PARAMETER poSalary     AS DECIMAL   NO-UNDO.
    
    /* Local variables */
    var decimal dMonthlyRate.
    var decimal dBonus.
    
    /* Calculation logic */
    FIND FIRST Employee WHERE Employee.EmployeeId = piEmployeeId NO-LOCK NO-ERROR.
    IF AVAILABLE Employee THEN DO:
        dMonthlyRate = Employee.AnnualSalary / 12.
        dBonus = Employee.PerformanceRating * 1000.
        poSalary = dMonthlyRate * piMonths + dBonus.
    END.
    ELSE DO:
        poSalary = 0.
    END.
END PROCEDURE.
"""
}

"operators_example" = {
  title = "Operator Usage Examples",
  description = "Examples of operator usage in ABL",
  code = """
PROCEDURE DemonstrateOperators:
    /* Variable declarations */
    var integer iValue1 = 10.
    var integer iValue2 = 5.
    var character cText1 = "Hello".
    var character cText2 = "World".
    var logical lCondition1 = TRUE.
    var logical lCondition2 = FALSE.
    
    /* Arithmetic operators */
    var integer iSum = iValue1 + iValue2.        /* 15 */
    var integer iDifference = iValue1 - iValue2. /* 5 */
    var integer iProduct = iValue1 * iValue2.    /* 50 */
    var decimal dQuotient = iValue1 / iValue2.   /* 2.0 */
    
    /* Compound assignment */
    var integer iTotal = 0.
    iTotal += iValue1.  /* iTotal = 10 */
    iTotal -= iValue2.  /* iTotal = 5 */
    iTotal *= iValue2.  /* iTotal = 25 */
    iTotal /= iValue2.  /* iTotal = 5 */
    
    /* String concatenation */
    var character cFullText = cText1 + " " + cText2.  /* "Hello World" */
    
    /* Comparison operators */
    var logical lEqual = (iValue1 = iValue2).        /* FALSE */
    var logical lNotEqual = (iValue1 <> iValue2).    /* TRUE */
    var logical lLessThan = (iValue1 < iValue2).     /* FALSE */
    var logical lGreaterThan = (iValue1 > iValue2).  /* TRUE */
    var logical lLessEqual = (iValue1 <= iValue2).   /* FALSE */
    var logical lGreaterEqual = (iValue1 >= iValue2)./* TRUE */
    
    /* Logical operators */
    var logical lAnd = lCondition1 AND lCondition2.  /* FALSE */
    var logical lOr = lCondition1 OR lCondition2.    /* TRUE */
    var logical lNot = NOT lCondition1.              /* FALSE */
    
    /* Display results */
    DISPLAY 
        iSum iDifference iProduct dQuotient
        iTotal cFullText
        lEqual lNotEqual lLessThan lGreaterThan
        lAnd lOr lNot.
END PROCEDURE.
"""
}

"preprocessor_example" = {
  title = "Preprocessor Examples",
  description = "Examples of preprocessor directives in ABL",
  code = """
/* Define preprocessor variables */
&GLOBAL-DEFINE MAX_RECORDS 1000
&SCOPED-DEFINE APP_TITLE "Customer Management System"
&SCOPED-DEFINE DEBUG_MODE

/* Using preprocessor variables */
MESSAGE "{&APP_TITLE} - Maximum Records: {&MAX_RECORDS}"
    VIEW-AS ALERT-BOX INFORMATION.

/* Conditional compilation */
&IF DEFINED(DEBUG_MODE) &THEN
    MESSAGE "Running in DEBUG mode"
        VIEW-AS ALERT-BOX INFORMATION.
&ELSE
    MESSAGE "Running in PRODUCTION mode"
        VIEW-AS ALERT-BOX INFORMATION.
&ENDIF

/* Nested conditionals */
&IF DEFINED(WINDOWS) &THEN
    &SCOPED-DEFINE OS_TYPE "Windows"
&ELSEIF DEFINED(UNIX) &THEN
    &SCOPED-DEFINE OS_TYPE "Unix"
&ELSE
    &SCOPED-DEFINE OS_TYPE "Unknown"
&ENDIF

MESSAGE "Operating System: {&OS_TYPE}"
    VIEW-AS ALERT-BOX INFORMATION.

/* Undefine a variable */
&UNDEFINE DEBUG_MODE

/* Check if undefined */
&IF DEFINED(DEBUG_MODE) &THEN
    MESSAGE "DEBUG_MODE is still defined"
        VIEW-AS ALERT-BOX INFORMATION.
&ELSE
    MESSAGE "DEBUG_MODE is now undefined"
        VIEW-AS ALERT-BOX INFORMATION.
&ENDIF
"""
}
