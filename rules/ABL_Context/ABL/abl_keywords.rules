# ABL Keywords Rules
# Contains all ABL keywords and syntax elements

[syntax]
# Complete list of ABL keywords extracted from the reference
keywords = [
    # Core language keywords
    "PROCEDURE", "FUNCTION", "END", "SUPER", "DEFINE", "VAR", "AS", "NO-UNDO",
    "CHARACTER", "INTEGER", "DECIMAL", "LOGICAL", "DATE", "DATETIME", "HANDLE",
    "MEMPTR", "RAW", "LONGCHAR", "INT64", "BUFFER", "FOR", "EACH", "WHERE",
    "NO-LOCK", "EXCLUSIVE-LOCK", "SHARE-LOCK", "INPUT", "OUTPUT", "INPUT-OUTPUT",
    "RETURN", "IF", "THEN", "ELSE", "DO", "REPEAT", "WHILE", "UNTIL", "NEXT",
    "LEAVE", "BREAK", "TRANSACTION", "UNDO", "TRIGGER", "VALIDATE", "DISPLAY",
    "UPDATE", "CREATE", "DELETE", "FIND", "FIRST", "LAST", "NEXT", "PREV",
    "PARAMETER", "TEMP-TABLE", "LIKE", "USING", "BY", "OF", "IN", "FROM", "TO",
    "ASSIGN", "DYNAMIC-FUNCTION", "DYNAMIC-INVOKE", "APPLY", "ACCUMULATE", "CAN-DO",
    "CAN-FIND", "AVAILABLE", "NEW", "THIS-OBJECT", "SUPER", "CAST", "DYNAMIC-CAST",
    "SUBSCRIBE", "UNSUBSCRIBE", "PUBLISH", "MESSAGE", "WAIT-FOR", "RUN", "STOP",
    
    # Database-related keywords
    "DATABASE", "DICTIONARY", "CONNECT", "DISCONNECT", "COMMIT", "ROLLBACK",
    "REPOSITION", "CURRENT", "QUERY", "PRESELECT", "BROWSE", "JOIN", "OUTER",
    "INNER", "LEFT", "RIGHT", "FULL", "ON", "FIELDS", "KEYS", "UNIQUE", "PRIMARY",
    "FOREIGN", "REFERENCE", "CASCADE", "VALIDATE", "TRIGGERS", "SCHEMA", "DUMP",
    "LOAD", "IMPORT", "EXPORT", "BEFORE", "AFTER", "COLUMN", "TABLE", "INDEX",
    
    # UI-related keywords
    "FRAME", "BUTTON", "MENU", "SUB-MENU", "RADIO-SET", "COMBO-BOX", "EDITOR",
    "FILL-IN", "SELECTION-LIST", "SLIDER", "TOGGLE-BOX", "IMAGE", "RECTANGLE",
    "TEXT", "VIEW-AS", "WITH", "DOWN", "SIDE-LABELS", "TOP-ONLY", "TITLE",
    "CENTERED", "FONT", "COLOR", "BGCOLOR", "FGCOLOR", "SIZE", "SCROLLBAR",
    "SENSITIVE", "ENABLE", "DISABLE", "CHOOSE", "FOCUS", "LABEL", "TOOLTIP",
    
    # Dataset and data-handling keywords
    "DATASET", "DATA-SOURCE", "DATA-RELATION", "RELATION-FIELDS", "NESTED",
    "BUFFER-COPY", "BUFFER-COMPARE", "SERIALIZE-NAME", "SERIALIZE-HIDDEN",
    "BEFORE-TABLE", "AFTER-TABLE", "PARENT-ID-FIELD", "PARENT-ID-RELATION",
    "PARENT-FIELDS", "CHILD-FIELDS", "APPEND", "MERGE", "FILL", "EMPTY",
    
    # OO-related keywords
    "CLASS", "INTERFACE", "ABSTRACT", "IMPLEMENTS", "INHERITS", "PUBLIC",
    "PROTECTED", "PRIVATE", "STATIC", "FINAL", "OVERRIDE", "PROPERTY", "GET",
    "SET", "CONSTRUCTOR", "DESTRUCTOR", "METHOD", "VOID", "THROW", "CATCH",
    "FINALLY", "TRY", "EXTENT", "INSTANCE", "ENUM", "FLAGS", "EVENT", "DELEGATE",
    
    # Preprocessor keywords
    "ANALYZE-SUSPEND", "ANALYZE-RESUME", "GLOBAL-DEFINE", "SCOPED-DEFINE",
    "UNDEFINE", "MESSAGE", "IF-DEFINED", "ELSEIF-DEFINED", "ELSE", "ENDIF",
    
    # Miscellaneous keywords
    "UNIX", "DOS", "WINDOWS", "OS-COMMAND", "OS-ERROR", "OS-GETENV", "OS-DIR",
    "SYSTEM-DIALOG", "PRINTER-SETUP", "PAGE", "STREAM", "PUT", "GET", "SEEK",
    "WORKFILE", "WORK-TABLE", "COMPILE", "SAVE", "RESTORE", "UNDERLINE", "BELL",
    "PAUSE", "CLEAR", "CLOSE", "OPEN", "CASE", "OTHERWISE", "WHEN", "USE",
    "RELEASE", "SESSION", "PERSISTENT", "STREAM", "BINARY", "TEXT", "APPEND",
    "OUTPUT", "INPUT", "REPLACE", "CONVERT", "TRIM", "SUBSTRING", "ENTRY",
    "NUM-ENTRIES", "LOOKUP", "R-INDEX", "INDEX", "LENGTH", "RANDOM", "TODAY",
    "NOW", "INTERVAL", "ADD-INTERVAL", "WEEKDAY", "MONTH", "YEAR", "DAY",
    "MTIME", "TIME", "ETIME", "ABSOLUTE", "TIMEZONE", "UTC", "LOCAL", "USERID",
    "TERMINAL", "PROGRAM-NAME", "PROPATH", "PROVERSION", "LOG-MANAGER", "ERROR",
    "WARNING", "INFO", "DEBUG", "TRACE", "AUDIT", "LOG", "SECURITY", "AES",
    "MD5", "SHA1", "ENCRYPT", "DECRYPT", "ENCODE", "DECODE", "BASE64", "GUID"
]

# Special preprocessor directives
preprocessor = [
    "&GLOBAL-DEFINE", "&SCOPED-DEFINE", "&UNDEFINE", 
    "&IF", "&THEN", "&ELSEIF", "&ELSE", "&ENDIF",
    "&MESSAGE", "&ANALYZE-SUSPEND", "&ANALYZE-RESUME",
    "&IF-DEFINED", "&ELSEIF-DEFINED"
]
