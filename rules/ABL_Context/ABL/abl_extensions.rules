Wh
# Maps file extensions to ABL language

[file_extensions]
# Core ABL file extensions
".p" = "abl"      # Procedure files
".w" = "abl"      # Window files
".i" = "abl"      # Include files
".cls" = "abl"    # Class files

# Additional ABL-related extensions
".df" = "abl"     # Data definition files
".d" = "abl"     # Data files

