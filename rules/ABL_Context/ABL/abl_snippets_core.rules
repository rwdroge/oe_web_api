# ABL Core Snippets Rules
# Contains code snippets for core ABL language features

[snippets]
# Variable declarations (based on memory about modern ABL variable declarations)
"var_declaration" = {
    title = "Variable Declaration",
    description = "Modern variable declaration using var keyword",
    code = """
/* Modern variable declarations - var is implicitly no-undo */
var ${1:character} ${2:cName}.
"""
}

"var_declarations_group" = {
    title = "Variable Declarations Group",
    description = "Group of aligned variable declarations using modern syntax",
    code = """
/* Modern variable declarations - var is implicitly no-undo */
var character ${1:cName}.
var integer   ${2:iCount}.
var decimal   ${3:dAmount}.
var logical   ${4:lValid}.
var handle    ${5:hWidget}.
"""
}

"parameter_declaration" = {
    title = "Parameter Declaration",
    description = "Parameter declaration with explicit no-undo",
    code = """
/* Parameters still need explicit NO-UNDO */
define ${1:input} parameter ${2:piInput} as ${3:integer} no-undo.
"""
}

"function_definition" = {
    title = "Function Definition",
    description = "Define a function with parameters and return value",
    code = """
FUNCTION ${1:functionName} RETURNS ${2:LOGICAL}
    (input ${3:piParam} as ${4:integer} no-undo):
    
    var ${5:logical} ${6:lResult} = ${7:TRUE}.
    
    /* Function body */
    ${8:// Your code here}
    
    RETURN ${6:lResult}.
END FUNCTION.
"""
}

"procedure_definition" = {
    title = "Procedure Definition",
    description = "Define a procedure with parameters",
    code = """
PROCEDURE ${1:procedureName}:
    DEFINE INPUT  PARAMETER ${2:piParam1} AS ${3:CHARACTER} NO-UNDO.
    DEFINE OUTPUT PARAMETER ${4:poResult} AS ${5:LOGICAL}   NO-UNDO.
    
    /* Procedure body */
    ${6:// Your code here}
    
    ASSIGN ${4:poResult} = TRUE.
END PROCEDURE.
"""
}

"class_definition" = {
    title = "Class Definition",
    description = "Define a class with properties and methods",
    code = """
CLASS ${1:ClassName} ${2:INHERITS ${3:BaseClass}}:
    /* Properties */
    DEFINE PUBLIC PROPERTY ${4:PropertyName} AS ${5:CHARACTER} NO-UNDO
        GET.
        SET.
    
    /* Constructor */
    CONSTRUCTOR ${1:ClassName} ():
        SUPER().
        /* Initialize */
    END CONSTRUCTOR.
    
    /* Methods */
    METHOD PUBLIC ${6:VOID} ${7:MethodName} ():
        /* Method implementation */
    END METHOD.
    
END CLASS.
"""
}

# Control structures
"if_statement" = {
    title = "If Statement",
    description = "If-then-else statement",
    code = """
IF ${1:condition} THEN DO:
    ${2:// True branch}
END.
ELSE DO:
    ${3:// False branch}
END.
"""
}

"for_each" = {
    title = "For Each Loop",
    description = "Iterate over records in a table",
    code = """
FOR EACH ${1:TableName} WHERE ${2:condition} ${3:NO-LOCK}:
    ${4:// Loop body}
END.
"""
}

"do_while" = {
    title = "Do While Loop",
    description = "Loop while a condition is true",
    code = """
DO WHILE ${1:condition}:
    ${2:// Loop body}
END.
"""
}

"do_until" = {
    title = "Do Until Loop",
    description = "Loop until a condition is true",
    code = """
DO UNTIL ${1:condition}:
    ${2:// Loop body}
END.
"""
}

"case_statement" = {
    title = "Case Statement",
    description = "Case statement for multiple conditions",
    code = """
CASE ${1:expression}:
    WHEN ${2:value1} THEN DO:
        ${3:// Action 1}
    END.
    WHEN ${4:value2} THEN DO:
        ${5:// Action 2}
    END.
    OTHERWISE DO:
        ${6:// Default action}
    END.
END CASE.
"""
}

# Exception handling
"try_catch" = {
    title = "Try-Catch Block",
    description = "Exception handling with try-catch",
    code = """
DO ON ERROR UNDO, THROW:
    TRY:
        ${1:// Code that might throw an error}
    CATCH ${2:eError} AS Progress.Lang.Error:
        ${3:// Error handling}
    END TRY.
END.
"""
}

# Preprocessor directives
"scoped_define" = {
    title = "Scoped Define",
    description = "Define a scoped preprocessor variable",
    code = """
&SCOPED-DEFINE ${1:VariableName} ${2:Value}
"""
}

"global_define" = {
    title = "Global Define",
    description = "Define a global preprocessor variable",
    code = """
&GLOBAL-DEFINE ${1:VariableName} ${2:Value}
"""
}

"preprocessor_if" = {
    title = "Preprocessor If",
    description = "Conditional compilation with preprocessor",
    code = """
&IF DEFINED(${1:VariableName}) &THEN
    ${2:// Code to include if defined}
&ELSE
    ${3:// Code to include if not defined}
&ENDIF
"""
}
