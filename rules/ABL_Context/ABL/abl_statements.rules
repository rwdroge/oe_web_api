# ABL Statements Reference
# Comprehensive reference for ABL statements

[metadata]
name = "ABL Statements Reference"
version = "1.0.0"
description = "Reference for ABL statements and control structures"
category = "statements"

[syntax_elements]
# ABL statements from the reference document

"PROCEDURE" = {
  type = "statement",
  description = "Defines a procedure",
  syntax = "PROCEDURE procedure-name:\n    statements\nEND PROCEDURE.",
  example = "PROCEDURE CalculateTotal:\n    DEFINE INPUT PARAMETER piValue AS INTEGER NO-UNDO.\n    DISPLAY piValue.\nEND PROCEDURE."
}

"FUNCTION" = {
  type = "statement",
  description = "Defines a function",
  syntax = "FUNCTION function-name RETURNS return-type:\n    statements\n    RETURN value.\nEND FUNCTION.",
  example = "FUNCTION GetCustomerName RETURNS CHARACTER:\n    RETURN \"John Doe\".\nEND FUNCTION."
}

"IF" = {
  type = "statement",
  description = "Conditional statement",
  syntax = "IF condition THEN statement [ELSE statement]",
  example = "IF iCount > 10 THEN\n    DISPLAY \"Greater than 10\".\nELSE\n    DISPLAY \"Less than or equal to 10\"."
}

"DO" = {
  type = "statement",
  description = "Block statement",
  syntax = "DO [WHILE condition | UNTIL condition]:\n    statements\nEND.",
  example = "DO:\n    var integer i = 1.\n    DISPLAY i.\nEND."
}

"FOR" = {
  type = "statement",
  description = "Loop through records",
  syntax = "FOR EACH record [WHERE condition] [NO-LOCK | EXCLUSIVE-LOCK | SHARE-LOCK]:\n    statements\nEND.",
  example = "FOR EACH Customer WHERE Customer.State = \"CA\" NO-LOCK:\n    DISPLAY Customer.Name.\nEND."
}

"REPEAT" = {
  type = "statement",
  description = "Repeat a block of statements",
  syntax = "REPEAT [count]:\n    statements\nEND.",
  example = "REPEAT 5:\n    DISPLAY \"Hello\".\nEND."
}

"ASSIGN" = {
  type = "statement",
  description = "Assign values to variables",
  syntax = "ASSIGN variable1 = value1\n       variable2 = value2.",
  example = "ASSIGN\n    cName = \"John\"\n    iAge = 30."
}

"DISPLAY" = {
  type = "statement",
  description = "Display values",
  syntax = "DISPLAY [expression1] [expression2] ...",
  example = "DISPLAY Customer.Name Customer.Address."
}

"CREATE" = {
  type = "statement",
  description = "Create a new record",
  syntax = "CREATE record.",
  example = "CREATE Customer.\nASSIGN\n    Customer.CustNum = 1001\n    Customer.Name = \"ABC Corp\"."
}

"FIND" = {
  type = "statement",
  description = "Find a record",
  syntax = "FIND [FIRST | LAST | NEXT | PREV] record [WHERE condition] [NO-LOCK | EXCLUSIVE-LOCK | SHARE-LOCK] [NO-ERROR].",
  example = "FIND FIRST Customer WHERE Customer.CustNum = 1001 NO-LOCK NO-ERROR."
}

"DELETE" = {
  type = "statement",
  description = "Delete a record",
  syntax = "DELETE record.",
  example = "FIND FIRST Customer WHERE Customer.CustNum = 1001.\nDELETE Customer."
}

"UPDATE" = {
  type = "statement",
  description = "Update values with user input",
  syntax = "UPDATE field1 field2 ...",
  example = "UPDATE Customer.Name Customer.Address."
}

"DEFINE VARIABLE" = {
  type = "statement",
  description = "Define a variable",
  syntax = "DEFINE VARIABLE name AS type [INITIAL value] [NO-UNDO].",
  example = "DEFINE VARIABLE cName AS CHARACTER INITIAL \"John\" NO-UNDO."
}

"DEFINE BUFFER" = {
  type = "statement",
  description = "Define a buffer for a table",
  syntax = "DEFINE BUFFER buffer-name FOR table-name.",
  example = "DEFINE BUFFER bCustomer FOR Customer."
}

"DEFINE TEMP-TABLE" = {
  type = "statement",
  description = "Define a temporary table",
  syntax = "DEFINE TEMP-TABLE name\n    FIELD field1 AS type1\n    FIELD field2 AS type2\n    INDEX index-name field1.",
  example = "DEFINE TEMP-TABLE ttCustomer\n    FIELD CustNum AS INTEGER\n    FIELD Name AS CHARACTER\n    INDEX CustIdx CustNum."
}

"DEFINE DATASET" = {
  type = "statement",
  description = "Define a dataset",
  syntax = "DEFINE DATASET name FOR table1, table2\n    DATA-RELATION relation-name FOR table1, table2 RELATION-FIELDS(field1, field2).",
  example = "DEFINE DATASET dsCustomerOrders\n    FOR Customer, Order\n    DATA-RELATION relCustOrder\n    FOR Customer, Order RELATION-FIELDS(CustNum, CustNum)."
}

"DEFINE QUERY" = {
  type = "statement",
  description = "Define a query",
  syntax = "DEFINE QUERY query-name FOR table-name.",
  example = "DEFINE QUERY qCustomer FOR Customer."
}

"DEFINE FRAME" = {
  type = "statement",
  description = "Define a frame for UI elements",
  syntax = "DEFINE FRAME frame-name\n    field1 field2 ...\n    WITH TITLE \"title\".",
  example = "DEFINE FRAME frCustomer\n    Customer.Name Customer.Address\n    WITH TITLE \"Customer Information\"."
}

"DEFINE BROWSE" = {
  type = "statement",
  description = "Define a browse widget",
  syntax = "DEFINE BROWSE browse-name\n    DISPLAY field1 field2 ...\n    WITH size DOWN lines.",
  example = "DEFINE BROWSE brCustomers\n    DISPLAY Customer.CustNum Customer.Name\n    WITH 15 DOWN 10."
}

"DEFINE BUTTON" = {
  type = "statement",
  description = "Define a button widget",
  syntax = "DEFINE BUTTON button-name\n    LABEL \"label\"\n    SIZE width BY height.",
  example = "DEFINE BUTTON btnSave\n    LABEL \"Save\"\n    SIZE 15 BY 1."
}

"DEFINE MENU" = {
  type = "statement",
  description = "Define a menu",
  syntax = "DEFINE MENU menu-name\n    MENUBAR\n    TITLE \"title\".",
  example = "DEFINE MENU mMain\n    MENUBAR\n    TITLE \"Main Menu\"."
}

"DEFINE PARAMETER" = {
  type = "statement",
  description = "Define a parameter",
  syntax = "DEFINE [INPUT | OUTPUT | INPUT-OUTPUT] PARAMETER parameter-name AS type [NO-UNDO].",
  example = "DEFINE INPUT PARAMETER piCustomerId AS INTEGER NO-UNDO."
}

"DEFINE PROPERTY" = {
  type = "statement",
  description = "Define a property for a class",
  syntax = "DEFINE [PUBLIC | PROTECTED | PRIVATE] PROPERTY property-name AS type\n    GET.\n    SET.",
  example = "DEFINE PUBLIC PROPERTY Name AS CHARACTER\n    GET.\n    SET."
}

"DEFINE STREAM" = {
  type = "statement",
  description = "Define a stream for input/output",
  syntax = "DEFINE STREAM stream-name.",
  example = "DEFINE STREAM sOutput."
}

"RETURN" = {
  type = "statement",
  description = "Return from a function or procedure",
  syntax = "RETURN [value].",
  example = "RETURN TRUE."
}

"RUN" = {
  type = "statement",
  description = "Run a procedure",
  syntax = "RUN procedure-name [(parameter-list)].",
  example = "RUN CalculateTotal (INPUT 100)."
}

"APPLY" = {
  type = "statement",
  description = "Apply changes to fields",
  syntax = "APPLY \"message\" TO field1 field2 ...",
  example = "APPLY \"Changes will be saved\" TO Customer.Name Customer.Address."
}

"MESSAGE" = {
  type = "statement",
  description = "Display a message",
  syntax = "MESSAGE \"message\"\n    VIEW-AS ALERT-BOX [INFO | WARNING | ERROR | QUESTION].",
  example = "MESSAGE \"Operation completed successfully\"\n    VIEW-AS ALERT-BOX INFO."
}

"WAIT-FOR" = {
  type = "statement",
  description = "Wait for an event",
  syntax = "WAIT-FOR event OF widget.",
  example = "WAIT-FOR CHOOSE OF btnSave."
}

"ENABLE" = {
  type = "statement",
  description = "Enable widgets",
  syntax = "ENABLE widget1 widget2 ... WITH FRAME frame-name.",
  example = "ENABLE btnSave btnCancel WITH FRAME frCustomer."
}

"DISABLE" = {
  type = "statement",
  description = "Disable widgets",
  syntax = "DISABLE widget1 widget2 ... WITH FRAME frame-name.",
  example = "DISABLE btnSave btnCancel WITH FRAME frCustomer."
}

"CASE" = {
  type = "statement",
  description = "Case statement",
  syntax = "CASE expression:\n    WHEN value1 THEN statement1\n    WHEN value2 THEN statement2\n    OTHERWISE statement3\nEND CASE.",
  example = "CASE iStatus:\n    WHEN 1 THEN DISPLAY \"Active\".\n    WHEN 2 THEN DISPLAY \"Inactive\".\n    OTHERWISE DISPLAY \"Unknown\".\nEND CASE."
}

"BUFFER-COPY" = {
  type = "statement",
  description = "Copy data between buffers",
  syntax = "BUFFER-COPY source TO target.",
  example = "BUFFER-COPY bCustomer1 TO bCustomer2."
}

"PUBLISH" = {
  type = "statement",
  description = "Publish an event",
  syntax = "PUBLISH event-name (parameter-list).",
  example = "PUBLISH \"CustomerUpdated\" (INPUT iCustomerId)."
}

"SUBSCRIBE" = {
  type = "statement",
  description = "Subscribe to an event",
  syntax = "SUBSCRIBE TO event-name ANYWHERE RUN-PROCEDURE procedure-name.",
  example = "SUBSCRIBE TO \"CustomerUpdated\" ANYWHERE RUN-PROCEDURE HandleCustomerUpdate."
}

"UNSUBSCRIBE" = {
  type = "statement",
  description = "Unsubscribe from an event",
  syntax = "UNSUBSCRIBE TO event-name ANYWHERE.",
  example = "UNSUBSCRIBE TO \"CustomerUpdated\" ANYWHERE."
}

"THROW" = {
  type = "statement",
  description = "Throw an exception",
  syntax = "THROW NEW error-type(parameters).",
  example = "THROW NEW Progress.Lang.AppError(\"Customer not found\", 1001)."
}

"TRANSACTION" = {
  type = "statement",
  description = "Start a transaction",
  syntax = "DO TRANSACTION:\n    statements\n    COMMIT.\nEND.",
  example = "DO TRANSACTION:\n    CREATE Customer.\n    ASSIGN Customer.Name = \"ABC Corp\".\n    COMMIT.\nEND."
}

"COMMIT" = {
  type = "statement",
  description = "Commit a transaction",
  syntax = "COMMIT.",
  example = "COMMIT."
}

"UNDO" = {
  type = "statement",
  description = "Undo a transaction",
  syntax = "UNDO, [LEAVE | NEXT | RETRY].",
  example = "UNDO, LEAVE."
}

"VALIDATE" = {
  type = "statement",
  description = "Validate a record",
  syntax = "VALIDATE record.",
  example = "VALIDATE Customer."
}

"OPEN QUERY" = {
  type = "statement",
  description = "Open a query",
  syntax = "OPEN QUERY query-name FOR EACH record [WHERE condition].",
  example = "OPEN QUERY qCustomer FOR EACH Customer WHERE Customer.State = \"CA\"."
}

"GET" = {
  type = "statement",
  description = "Get a record from a query",
  syntax = "GET query-name.",
  example = "GET qCustomer."
}

"PUT" = {
  type = "statement",
  description = "Put data to a stream",
  syntax = "PUT STREAM stream-name UNFORMATTED data.",
  example = "PUT STREAM sOutput UNFORMATTED \"Data\"."
}

"INPUT" = {
  type = "statement",
  description = "Input data from a file",
  syntax = "INPUT FROM file-name.",
  example = "INPUT FROM \"data.txt\"."
}

"OUTPUT" = {
  type = "statement",
  description = "Output data to a file",
  syntax = "OUTPUT TO file-name.",
  example = "OUTPUT TO \"report.txt\"."
}

"IMPORT" = {
  type = "statement",
  description = "Import data",
  syntax = "IMPORT table.",
  example = "IMPORT Customer."
}

"EXPORT" = {
  type = "statement",
  description = "Export data",
  syntax = "EXPORT table.",
  example = "EXPORT Customer."
}

"CLASS" = {
  type = "statement",
  description = "Define a class",
  syntax = "CLASS class-name [INHERITS base-class] [IMPLEMENTS interface]:\n    class-body\nEND CLASS.",
  example = "CLASS Customer INHERITS Person:\n    DEFINE PUBLIC PROPERTY CustomerId AS INTEGER NO-UNDO\n        GET.\n        SET.\nEND CLASS."
}

"INTERFACE" = {
  type = "statement",
  description = "Define an interface",
  syntax = "INTERFACE interface-name [INHERITS base-interface]:\n    interface-body\nEND INTERFACE.",
  example = "INTERFACE ICustomer:\n    DEFINE PUBLIC PROPERTY CustomerId AS INTEGER NO-UNDO\n        GET.\n        SET.\nEND INTERFACE."
}

"METHOD" = {
  type = "statement",
  description = "Define a method",
  syntax = "METHOD [PUBLIC | PROTECTED | PRIVATE] return-type method-name(parameters):\n    method-body\nEND METHOD.",
  example = "METHOD PUBLIC CHARACTER GetFullName():\n    RETURN FirstName + \" \" + LastName.\nEND METHOD."
}

"CONSTRUCTOR" = {
  type = "statement",
  description = "Define a constructor",
  syntax = "CONSTRUCTOR class-name(parameters):\n    constructor-body\nEND CONSTRUCTOR.",
  example = "CONSTRUCTOR Customer(INPUT piCustomerId AS INTEGER):\n    SUPER().\n    THIS-OBJECT:CustomerId = piCustomerId.\nEND CONSTRUCTOR."
}

"DESTRUCTOR" = {
  type = "statement",
  description = "Define a destructor",
  syntax = "DESTRUCTOR class-name():\n    destructor-body\nEND DESTRUCTOR.",
  example = "DESTRUCTOR Customer():\n    /* Cleanup code */\nEND DESTRUCTOR."
}

[best_practices]
# Best practices for ABL statements

"for_each_best_practices" = {
  title = "FOR EACH Best Practices",
  description = """
When using FOR EACH statements, follow these best practices:

1. Always specify a lock mode (NO-LOCK, EXCLUSIVE-LOCK, SHARE-LOCK)
2. Use buffer references when accessing multiple tables
3. Use WHERE clauses to limit the records processed
4. Use indexes to optimize performance

```abl
/* Good practice */
FOR EACH Customer WHERE Customer.State = "CA" NO-LOCK,
    EACH Order OF Customer NO-LOCK:
    /* Process records */
END.

/* Using buffer references */
DEFINE BUFFER bCustomer FOR Customer.
DEFINE BUFFER bOrder FOR Order.

FOR EACH bCustomer WHERE bCustomer.State = "CA" NO-LOCK,
    EACH bOrder WHERE bOrder.CustNum = bCustomer.CustNum NO-LOCK:
    /* Process records */
END.
```
"""
}

"transaction_best_practices" = {
  title = "Transaction Best Practices",
  description = """
When working with transactions, follow these best practices:

1. Use explicit transaction blocks
2. Include error handling
3. Keep transactions as short as possible
4. Always include UNDO handling

```abl
/* Good practice */
DO TRANSACTION ON ERROR UNDO, THROW:
    /* Transaction operations */
    CREATE Customer.
    ASSIGN
        Customer.CustNum = NEXT-VALUE(CustNum)
        Customer.Name = cName.
    
    CREATE Order.
    ASSIGN
        Order.OrderNum = NEXT-VALUE(OrderNum)
        Order.CustNum = Customer.CustNum.
    
    /* Commit if all operations succeed */
    COMMIT.
END.
```
"""
}

"error_handling_best_practices" = {
  title = "Error Handling Best Practices",
  description = """
For effective error handling, follow these best practices:

1. Use TRY-CATCH blocks for structured error handling
2. Include specific error types when possible
3. Provide meaningful error messages
4. Clean up resources in FINALLY blocks

```abl
/* Good practice */
TRY:
    FIND FIRST Customer WHERE Customer.CustNum = piCustNum NO-LOCK NO-ERROR.
    IF NOT AVAILABLE Customer THEN
        THROW NEW Progress.Lang.AppError("Customer not found", 1001).
    
    /* Process customer */
CATCH eNotFound AS Progress.Lang.AppError:
    /* Handle application error */
    MESSAGE "Application Error: " + eNotFound:GetMessage()
        VIEW-AS ALERT-BOX ERROR.
CATCH eOther AS Progress.Lang.Error:
    /* Handle other errors */
    MESSAGE "Unexpected Error: " + eOther:GetMessage()
        VIEW-AS ALERT-BOX ERROR.
FINALLY:
    /* Clean up resources */
END TRY.
```
"""
}

"ui_best_practices" = {
  title = "UI Statement Best Practices",
  description = """
When working with UI statements, follow these best practices:

1. Group related UI elements in frames
2. Use consistent naming conventions for widgets
3. Include labels and tooltips for better usability
4. Handle events appropriately

```abl
/* Good practice */
DEFINE FRAME frCustomer
    HEADER "Customer Information"
    SKIP(1)
    Customer.CustNum LABEL "Customer ID" COLON 15
    Customer.Name LABEL "Name" COLON 15
    Customer.Address LABEL "Address" COLON 15
    SKIP(1)
    btnSave btnCancel
    WITH CENTERED SIDE-LABELS
    SIZE 80 BY 10.

DEFINE BUTTON btnSave
    LABEL "Save"
    SIZE 15 BY 1
    TOOLTIP "Save changes"
    TRIGGERS:
        ON CHOOSE PERSISTENT RUN SaveCustomer.
    END TRIGGERS.

DEFINE BUTTON btnCancel
    LABEL "Cancel"
    SIZE 15 BY 1
    TOOLTIP "Cancel changes"
    TRIGGERS:
        ON CHOOSE PERSISTENT RUN CancelChanges.
    END TRIGGERS.

ENABLE Customer.Name Customer.Address btnSave btnCancel WITH FRAME frCustomer.
WAIT-FOR CLOSE OF FRAME frCustomer.
```
"""
}

[examples]
# Examples of ABL statements

"procedure_example" = {
  title = "Procedure Example",
  description = "Example of a procedure definition and usage",
  code = """
/* Procedure definition */
PROCEDURE ProcessCustomer:
    DEFINE INPUT PARAMETER piCustNum AS INTEGER NO-UNDO.
    DEFINE OUTPUT PARAMETER poSuccess AS LOGICAL NO-UNDO.
    
    /* Local variables */
    var character cName.
    var character cState.
    var integer iOrderCount = 0.
    
    /* Find the customer */
    FIND FIRST Customer WHERE Customer.CustNum = piCustNum NO-LOCK NO-ERROR.
    IF NOT AVAILABLE Customer THEN DO:
        poSuccess = FALSE.
        RETURN.
    END.
    
    /* Get customer information */
    ASSIGN
        cName = Customer.Name
        cState = Customer.State.
    
    /* Count orders */
    FOR EACH Order WHERE Order.CustNum = piCustNum NO-LOCK:
        iOrderCount = iOrderCount + 1.
    END.
    
    /* Display customer information */
    DISPLAY
        "Customer:" cName
        "State:" cState
        "Order Count:" iOrderCount.
    
    /* Set success flag */
    poSuccess = TRUE.
END PROCEDURE.

/* Procedure usage */
var logical lSuccess.
RUN ProcessCustomer (INPUT 1001, OUTPUT lSuccess).

IF lSuccess THEN
    MESSAGE "Customer processed successfully"
        VIEW-AS ALERT-BOX INFORMATION.
ELSE
    MESSAGE "Customer not found"
        VIEW-AS ALERT-BOX ERROR.
"""
}

"transaction_example" = {
  title = "Transaction Example",
  description = "Example of a transaction with error handling",
  code = """
/* Transaction with error handling */
PROCEDURE CreateOrder:
    DEFINE INPUT PARAMETER piCustNum AS INTEGER NO-UNDO.
    DEFINE INPUT PARAMETER piOrderDate AS DATE NO-UNDO.
    DEFINE INPUT PARAMETER piAmount AS DECIMAL NO-UNDO.
    DEFINE OUTPUT PARAMETER poOrderNum AS INTEGER NO-UNDO.
    DEFINE OUTPUT PARAMETER poSuccess AS LOGICAL NO-UNDO.
    
    /* Default values */
    ASSIGN
        poOrderNum = 0
        poSuccess = FALSE.
    
    /* Transaction block */
    DO TRANSACTION ON ERROR UNDO, THROW:
        /* Validate customer */
        FIND FIRST Customer WHERE Customer.CustNum = piCustNum NO-LOCK NO-ERROR.
        IF NOT AVAILABLE Customer THEN DO:
            MESSAGE "Customer not found"
                VIEW-AS ALERT-BOX ERROR.
            RETURN.
        END.
        
        /* Create order header */
        CREATE Order.
        ASSIGN
            Order.OrderNum = NEXT-VALUE(OrderNum)
            Order.CustNum = piCustNum
            Order.OrderDate = piOrderDate
            Order.Amount = piAmount
            Order.Status = "New".
        
        /* Create order details */
        CREATE OrderDetail.
        ASSIGN
            OrderDetail.OrderNum = Order.OrderNum
            OrderDetail.LineNum = 1
            OrderDetail.ItemNum = 1001
            OrderDetail.Quantity = 1
            OrderDetail.Price = piAmount.
        
        /* Set return values */
        ASSIGN
            poOrderNum = Order.OrderNum
            poSuccess = TRUE.
        
        /* Commit the transaction */
        COMMIT.
    END.
    
    CATCH eError AS Progress.Lang.Error:
        /* Handle error */
        MESSAGE "Error creating order: " + eError:GetMessage()
            VIEW-AS ALERT-BOX ERROR.
        UNDO, LEAVE.
    END CATCH.
END PROCEDURE.

/* Usage */
var integer iOrderNum.
var logical lSuccess.

RUN CreateOrder (
    INPUT 1001,
    INPUT TODAY,
    INPUT 1000.00,
    OUTPUT iOrderNum,
    OUTPUT lSuccess
).

IF lSuccess THEN
    MESSAGE "Order created successfully. Order #: " + STRING(iOrderNum)
        VIEW-AS ALERT-BOX INFORMATION.
"""
}

"ui_example" = {
  title = "UI Example",
  description = "Example of UI statements for a customer form",
  code = """
/* Customer form */
PROCEDURE CustomerForm:
    DEFINE INPUT PARAMETER piCustNum AS INTEGER NO-UNDO.
    
    /* Local variables */
    var logical lModified = FALSE.
    var logical lSave = FALSE.
    
    /* Find customer */
    FIND FIRST Customer WHERE Customer.CustNum = piCustNum EXCLUSIVE-LOCK NO-ERROR.
    IF NOT AVAILABLE Customer THEN DO:
        MESSAGE "Customer not found"
            VIEW-AS ALERT-BOX ERROR.
        RETURN.
    END.
    
    /* Define UI */
    DEFINE FRAME frCustomer
        HEADER "Customer Information"
        SKIP(1)
        Customer.CustNum LABEL "Customer ID" COLON 15 VIEW-AS FILL-IN READ-ONLY
        Customer.Name LABEL "Name" COLON 15
        Customer.Address LABEL "Address" COLON 15
        Customer.City LABEL "City" COLON 15
        Customer.State LABEL "State" COLON 15
        Customer.PostalCode LABEL "Postal Code" COLON 15
        SKIP(1)
        btnSave btnCancel
        WITH CENTERED SIDE-LABELS
        SIZE 80 BY 15.
    
    DEFINE BUTTON btnSave
        LABEL "Save"
        SIZE 15 BY 1
        TOOLTIP "Save changes"
        TRIGGERS:
            ON CHOOSE PERSISTENT DO:
                lSave = TRUE.
                APPLY "CLOSE" TO FRAME frCustomer.
            END.
        END TRIGGERS.
    
    DEFINE BUTTON btnCancel
        LABEL "Cancel"
        SIZE 15 BY 1
        TOOLTIP "Cancel changes"
        TRIGGERS:
            ON CHOOSE PERSISTENT DO:
                lSave = FALSE.
                APPLY "CLOSE" TO FRAME frCustomer.
            END.
        END TRIGGERS.
    
    /* Display form */
    DISPLAY
        Customer.CustNum
        WITH FRAME frCustomer.
    
    ENABLE
        Customer.Name
        Customer.Address
        Customer.City
        Customer.State
        Customer.PostalCode
        btnSave
        btnCancel
        WITH FRAME frCustomer.
    
    /* Track modifications */
    ON MODIFY OF Customer.Name OR
       MODIFY OF Customer.Address OR
       MODIFY OF Customer.City OR
       MODIFY OF Customer.State OR
       MODIFY OF Customer.PostalCode
       PERSISTENT DO:
        lModified = TRUE.
    END.
    
    /* Wait for user action */
    WAIT-FOR CLOSE OF FRAME frCustomer.
    
    /* Process result */
    IF lSave AND lModified THEN DO:
        DO TRANSACTION ON ERROR UNDO, THROW:
            /* Save changes */
            VALIDATE Customer.
            COMMIT.
            MESSAGE "Customer information saved"
                VIEW-AS ALERT-BOX INFORMATION.
        END.
        CATCH eError AS Progress.Lang.Error:
            MESSAGE "Error saving customer: " + eError:GetMessage()
                VIEW-AS ALERT-BOX ERROR.
            UNDO, LEAVE.
        END CATCH.
    END.
    ELSE IF lModified THEN DO:
        /* Discard changes */
        UNDO, LEAVE.
        MESSAGE "Changes discarded"
            VIEW-AS ALERT-BOX INFORMATION.
    END.
END PROCEDURE.

/* Usage */
RUN CustomerForm (INPUT 1001).
"""
}

# ABL Missing Statements Reference
# Additional reference for ABL statements not covered in other files

[metadata]
name = "ABL Missing Statements Reference"
version = "1.0.0"
description = "Reference for additional ABL statements not covered in other files"
category = "statements"

[syntax_elements]
# Additional ABL statements not covered elsewhere

"ENCODE" = {
  type = "function",
  description = "Encodes a source character string, useful for password encryption",
  syntax = "ENCODE(expression)",
  example = "var character cPassword = \"secret\".\nvar character cEncrypted = ENCODE(cPassword)."
}

"DROP-TARGET" = {
  type = "attribute",
  description = "Indicates whether you want to be able to drop a file onto the object",
  syntax = "DROP-TARGET",
  example = "DEFINE BROWSE brFiles\n  DROP-TARGET."
}

"DYNAMIC-FUNCTION" = {
  type = "function",
  description = "Calls a function dynamically at runtime by name",
  syntax = "DYNAMIC-FUNCTION(function-name [, parameter, ...]) [IN handle]",
  example = "var character cResult = DYNAMIC-FUNCTION(\"GetCustomerName\", iCustNum)."
}

"DYNAMIC-INVOKE" = {
  type = "function",
  description = "Invokes a method on an object dynamically at runtime",
  syntax = "DYNAMIC-INVOKE(object-handle, method-name [, parameter, ...])",
  example = "var handle hObj = NEW MyClass().\nDYNAMIC-INVOKE(hObj, \"ProcessData\", cDataValue)."
}

"BASE64-ENCODE" = {
  type = "function",
  description = "Encodes binary data to Base64 format",
  syntax = "BASE64-ENCODE(expression)",
  example = "var character cEncoded = BASE64-ENCODE(FILL-IN)."
}

"BASE64-DECODE" = {
  type = "function",
  description = "Decodes Base64 data to binary format",
  syntax = "BASE64-DECODE(expression)",
  example = "var memptr mBinary = BASE64-DECODE(cEncodedString)."
}

"MD5-DIGEST" = {
  type = "function",
  description = "Calculates the MD5 message digest of a string",
  syntax = "MD5-DIGEST(expression)",
  example = "var character cHash = MD5-DIGEST(cPassword)."
}

"SHA1-DIGEST" = {
  type = "function",
  description = "Calculates the SHA-1 message digest of a string",
  syntax = "SHA1-DIGEST(expression)",
  example = "var character cHash = SHA1-DIGEST(cPassword)."
}

"GET-POINTER-VALUE" = {
  type = "function",
  description = "Gets a value from a memory location specified by a pointer",
  syntax = "GET-POINTER-VALUE(pointer-value, data-type, byte-offset, convert-bytes)",
  example = "var int64 iValue = GET-POINTER-VALUE(iPointer, \"int64\", 0, TRUE)."
}

"SET-POINTER-VALUE" = {
  type = "statement",
  description = "Sets a value at a memory location specified by a pointer",
  syntax = "SET-POINTER-VALUE(pointer-value, data-type, byte-offset, value, convert-bytes).",
  example = "SET-POINTER-VALUE(iPointer, \"int64\", 0, 12345, TRUE)."
}

"GENERATE-UUID" = {
  type = "function",
  description = "Generates a universally unique identifier (UUID)",
  syntax = "GENERATE-UUID",
  example = "var character cUUID = GENERATE-UUID()."
}

"SOCKET" = {
  type = "statement",
  description = "Creates and manages network socket connections",
  syntax = "CREATE SOCKET hSocket.\nhSocket:CONNECT(host, port).",
  example = "DEFINE VARIABLE hSocket AS HANDLE NO-UNDO.\nCREATE SOCKET hSocket.\nhSocket:CONNECT(\"localhost\", 8080)."
}

"DDE" = {
  type = "statement",
  description = "Dynamic Data Exchange communication in Windows",
  syntax = "DDE INITIATE hDDE application topic.\nDDE REQUEST hDDE item var.\nDDE TERMINATE hDDE.",
  example = "DEFINE VARIABLE hDDE AS HANDLE NO-UNDO.\nDDE INITIATE hDDE \"Excel\" \"Sheet1\".\nDDE REQUEST hDDE \"R1C1\" cValue.\nDDE TERMINATE hDDE."
}

"BACKGROUND-COLOR" = {
  type = "attribute",
  description = "Sets the background color of a widget",
  syntax = "BACKGROUND-COLOR = expression",
  example = "btnOK:BACKGROUND-COLOR = 12."
}

"XMLSCHEMA" = {
  type = "statement",
  description = "XML Schema operations for validating XML documents",
  syntax = "LOAD-XMLSCHEMA(schema-file, handle).",
  example = "DEFINE VARIABLE hSchema AS HANDLE NO-UNDO.\nLOAD-XMLSCHEMA(\"customer.xsd\", hSchema)."
}

"SERIALIZE-NAME" = {
  type = "attribute",
  description = "Specifies the name for serialization in JSON or XML",
  syntax = "SERIALIZE-NAME = \"name\"",
  example = "DEFINE TEMP-TABLE ttCustomer\n  FIELD CustNum AS INTEGER\n  SERIALIZE-NAME \"customerNumber\"."
}

"NAMESPACE-URI" = {
  type = "attribute", 
  description = "Specifies the URI for a namespace",
  syntax = "NAMESPACE-URI = \"uri\"",
  example = "DEFINE DATASET dsCustomer\n  NAMESPACE-URI \"http://example.com/schema\"\n  NAMESPACE-PREFIX \"ex\"."
}

