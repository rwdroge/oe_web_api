# ABL Database Reference
# Comprehensive reference for ABL database operations

[metadata]
name = "ABL Database Reference"
version = "1.0.0"
description = "Reference for ABL database operations, buffers, and data access"
category = "database"

[syntax_elements]
# ABL database elements

"DEFINE BUFFER" = {
  type = "statement",
  description = "Define a buffer for a table",
  syntax = "DEFINE BUFFER buffer-name FOR table-name.",
  example = "DEFINE BUFFER bCustomer FOR Customer."
}

"DEFINE TEMP-TABLE" = {
  type = "statement",
  description = "Define a temporary table",
  syntax = "DEFINE TEMP-TABLE name\n    FIELD field1 AS type1\n    FIELD field2 AS type2\n    INDEX index-name field1.",
  example = "DEFINE TEMP-TABLE ttCustomer\n    FIELD CustNum AS INTEGER\n    FIELD Name AS CHARACTER\n    INDEX CustIdx CustNum."
}

"DEFINE DATASET" = {
  type = "statement",
  description = "Define a dataset",
  syntax = "DEFINE DATASET name FOR table1, table2\n    DATA-RELATION relation-name FOR table1, table2 RELATION-FIELDS(field1, field2).",
  example = "DEFINE DATASET dsCustomerOrders\n    FOR Customer, Order\n    DATA-RELATION relCustOrder\n    FOR Customer, Order RELATION-FIELDS(CustNum, CustNum)."
}

"DATA-RELATION" = {
  type = "statement",
  description = "Define a relation between tables in a dataset",
  syntax = "DATA-RELATION name FOR table1, table2 RELATION-FIELDS(field1, field2) [NESTED].",
  example = "DATA-RELATION relCustOrder\n    FOR Customer, Order RELATION-FIELDS(CustNum, CustNum)\n    NESTED."
}

"BUFFER-COPY" = {
  type = "statement",
  description = "Copy data between buffers",
  syntax = "BUFFER-COPY source TO target.",
  example = "BUFFER-COPY bCustomer1 TO bCustomer2."
}

"BUFFER-COMPARE" = {
  type = "function",
  description = "Compare two buffer records",
  syntax = "BUFFER-COMPARE(buffer1, buffer2)",
  example = "IF BUFFER-COMPARE(bCustomer1, bCustomer2) THEN"
}

"FOR EACH" = {
  type = "statement",
  description = "Iterate through records",
  syntax = "FOR EACH record [WHERE condition] [NO-LOCK | EXCLUSIVE-LOCK | SHARE-LOCK]:\n    statements\nEND.",
  example = "FOR EACH Customer WHERE Customer.State = \"CA\" NO-LOCK:\n    DISPLAY Customer.Name.\nEND."
}

"FIND" = {
  type = "statement",
  description = "Find a record",
  syntax = "FIND [FIRST | LAST | NEXT | PREV] record [WHERE condition] [NO-LOCK | EXCLUSIVE-LOCK | SHARE-LOCK] [NO-ERROR].",
  example = "FIND FIRST Customer WHERE Customer.CustNum = 1001 NO-LOCK NO-ERROR."
}

"CREATE" = {
  type = "statement",
  description = "Create a new record",
  syntax = "CREATE record.",
  example = "CREATE Customer.\nASSIGN\n    Customer.CustNum = 1001\n    Customer.Name = \"ABC Corp\"."
}

"DELETE" = {
  type = "statement",
  description = "Delete a record",
  syntax = "DELETE record.",
  example = "FIND FIRST Customer WHERE Customer.CustNum = 1001.\nDELETE Customer."
}

"CAN-FIND" = {
  type = "function",
  description = "Check if a record exists",
  syntax = "CAN-FIND(FIRST record WHERE condition)",
  example = "IF CAN-FIND(FIRST Customer WHERE Customer.CustNum = 1001) THEN"
}

"AVAILABLE" = {
  type = "function",
  description = "Check if a record is available",
  syntax = "AVAILABLE record",
  example = "IF AVAILABLE Customer THEN"
}

"TRANSACTION" = {
  type = "statement",
  description = "Start a transaction",
  syntax = "DO TRANSACTION:\n    statements\n    COMMIT.\nEND.",
  example = "DO TRANSACTION:\n    CREATE Customer.\n    ASSIGN Customer.Name = \"ABC Corp\".\n    COMMIT.\nEND."
}

"COMMIT" = {
  type = "statement",
  description = "Commit a transaction",
  syntax = "COMMIT.",
  example = "COMMIT."
}

"UNDO" = {
  type = "statement",
  description = "Undo a transaction",
  syntax = "UNDO, [LEAVE | NEXT | RETRY].",
  example = "UNDO, LEAVE."
}

"VALIDATE" = {
  type = "statement",
  description = "Validate a record",
  syntax = "VALIDATE record.",
  example = "VALIDATE Customer."
}

"DEFINE QUERY" = {
  type = "statement",
  description = "Define a query",
  syntax = "DEFINE QUERY query-name FOR table-name.",
  example = "DEFINE QUERY qCustomer FOR Customer."
}

"OPEN QUERY" = {
  type = "statement",
  description = "Open a query",
  syntax = "OPEN QUERY query-name FOR EACH record [WHERE condition].",
  example = "OPEN QUERY qCustomer FOR EACH Customer WHERE Customer.State = \"CA\"."
}

"GET" = {
  type = "statement",
  description = "Get a record from a query",
  syntax = "GET query-name.",
  example = "GET qCustomer."
}

"REPOSITION" = {
  type = "statement",
  description = "Reposition a query",
  syntax = "REPOSITION query-name TO [ROWID rowid | RECID recid].",
  example = "REPOSITION qCustomer TO ROWID rCustomer."
}

"IMPORT" = {
  type = "statement",
  description = "Import data",
  syntax = "IMPORT table.",
  example = "IMPORT Customer."
}

"EXPORT" = {
  type = "statement",
  description = "Export data",
  syntax = "EXPORT table.",
  example = "EXPORT Customer."
}

"DUMP" = {
  type = "statement",
  description = "Dump data to a file",
  syntax = "DUMP table TO file-name.",
  example = "DUMP Customer TO \"customer.d\"."
}

"LOAD" = {
  type = "statement",
  description = "Load data from a file",
  syntax = "LOAD table FROM file-name.",
  example = "LOAD Customer FROM \"customer.d\"."
}

"CONNECT" = {
  type = "statement",
  description = "Connect to a database",
  syntax = "CONNECT -db database-name -ld logical-name -dt database-type -U username -P password.",
  example = "CONNECT -db customer.db -ld custdb -dt PROGRESS -U admin -P password."
}

"DISCONNECT" = {
  type = "statement",
  description = "Disconnect from a database",
  syntax = "DISCONNECT database-name.",
  example = "DISCONNECT custdb."
}

"OF" = {
  type = "keyword",
  description = "Specifies a relationship between records",
  syntax = "record2 OF record1",
  example = "FOR EACH Order OF Customer:"
}

"NO-LOCK" = {
  type = "keyword",
  description = "Specifies read-only access to a record",
  syntax = "record NO-LOCK",
  example = "FIND FIRST Customer NO-LOCK."
}

"EXCLUSIVE-LOCK" = {
  type = "keyword",
  description = "Specifies exclusive access to a record",
  syntax = "record EXCLUSIVE-LOCK",
  example = "FIND FIRST Customer EXCLUSIVE-LOCK."
}

"SHARE-LOCK" = {
  type = "keyword",
  description = "Specifies shared access to a record",
  syntax = "record SHARE-LOCK",
  example = "FIND FIRST Customer SHARE-LOCK."
}

"NO-ERROR" = {
  type = "keyword",
  description = "Suppresses error messages",
  syntax = "statement NO-ERROR",
  example = "FIND FIRST Customer WHERE Customer.CustNum = 1001 NO-LOCK NO-ERROR."
}

"NESTED" = {
  type = "keyword",
  description = "Specifies a nested relationship in a dataset",
  syntax = "DATA-RELATION ... NESTED",
  example = "DATA-RELATION relCustOrder FOR Customer, Order RELATION-FIELDS(CustNum, CustNum) NESTED."
}

"RELATION-FIELDS" = {
  type = "keyword",
  description = "Specifies the fields that relate tables in a dataset",
  syntax = "RELATION-FIELDS(field1, field2)",
  example = "DATA-RELATION relCustOrder FOR Customer, Order RELATION-FIELDS(CustNum, CustNum)."
}

[best_practices]
# Best practices for ABL database operations, with emphasis on buffer usage

"buffer_definition" = {
  title = "Buffer Definition Best Practices",
  description = """
When defining buffers, follow these best practices:

1. Use the 'b' prefix for buffer handles
2. Match the buffer name to the table name
3. Keep names descriptive and clear
4. Follow consistent casing
5. Group buffer definitions together at the beginning of procedures

```abl
/* Buffer Definitions */
DEFINE BUFFER bOrder     FOR Order.      /* Main table buffer */
DEFINE BUFFER bOrderLine FOR OrderLine.  /* Related table buffer */
DEFINE BUFFER bItem      FOR Item.       /* Related table buffer */
```
"""
}

"buffer_usage" = {
  title = "Buffer Usage Rules",
  description = """
When using buffers, follow these rules:

1. Always define buffers for database access
2. Use buffer references in queries
3. Define buffers at procedure/program level
4. Group buffer definitions together
5. Use default buffers for consistent access
6. Include buffer definitions in file header
7. Document buffer relationships
8. Maintain NO-LOCK and other attributes

```abl
/* Using buffers in queries */
FOR EACH bOrder WHERE bOrder.CustNum = piCustNum NO-LOCK,
    EACH bOrderLine OF bOrder NO-LOCK:
    /* Use buffer references */
    dTotal += bOrderLine.Qty * bOrderLine.Price.
END.
```
"""
}

"buffer_relationships" = {
  title = "Buffer Relationship Patterns",
  description = """
Common patterns for buffer relationships:

1. Main table buffer with related buffers
2. Buffer references in FOR EACH
3. Buffer references in field access
4. Buffer-to-buffer relationships (OF)

```abl
/* Main table with related buffers */
DEFINE BUFFER bCustomer FOR Customer.
DEFINE BUFFER bOrder FOR Order.
DEFINE BUFFER bOrderLine FOR OrderLine.

/* Buffer-to-buffer relationships */
FOR EACH bCustomer WHERE bCustomer.State = "CA" NO-LOCK:
    DISPLAY bCustomer.Name.
    
    FOR EACH bOrder OF bCustomer NO-LOCK:
        DISPLAY bOrder.OrderNum bOrder.OrderDate.
        
        FOR EACH bOrderLine OF bOrder NO-LOCK:
            DISPLAY bOrderLine.ItemNum bOrderLine.Qty bOrderLine.Price.
        END.
    END.
END.
```
"""
}

"temp_table_best_practices" = {
  title = "Temp-Table Best Practices",
  description = """
When working with temp-tables, follow these best practices:

1. Use the 'tt' prefix for temp-table names
2. Define indexes for performance
3. Use LIKE for consistent field definitions
4. Include appropriate data types and initial values

```abl
/* Temp-table definition */
DEFINE TEMP-TABLE ttCustomer
    FIELD CustNum AS INTEGER
    FIELD Name AS CHARACTER
    FIELD State AS CHARACTER
    FIELD Status AS CHARACTER INITIAL "Active"
    INDEX CustIdx CustNum
    INDEX StateIdx State.

/* Temp-table based on database table */
DEFINE TEMP-TABLE ttOrder LIKE Order
    FIELD Status AS CHARACTER INITIAL "New"
    INDEX OrderIdx OrderNum.
```
"""
}

"dataset_best_practices" = {
  title = "Dataset Best Practices",
  description = """
When working with datasets, follow these best practices:

1. Use the 'ds' prefix for dataset names
2. Use the 'rel' prefix for data-relation names
3. Define clear relationships between tables
4. Use NESTED for parent-child relationships
5. Use appropriate RELATION-FIELDS

```abl
/* Dataset definition */
DEFINE DATASET dsCustomerOrders
    FOR ttCustomer, ttOrder
    DATA-RELATION relCustOrder
    FOR ttCustomer, ttOrder RELATION-FIELDS(CustNum, CustNum)
    NESTED.

/* Using datasets */
BUFFER-COPY DATASET dsCustomerOrders TO DATASET dsCustomerOrders.
```
"""
}

"transaction_best_practices" = {
  title = "Transaction Best Practices",
  description = """
When working with transactions, follow these best practices:

1. Use explicit transaction blocks
2. Include error handling
3. Keep transactions as short as possible
4. Always include UNDO handling
5. Use appropriate lock modes

```abl
/* Transaction with error handling */
DO TRANSACTION ON ERROR UNDO, THROW:
    /* Create customer */
    CREATE Customer.
    ASSIGN
        Customer.CustNum = NEXT-VALUE(CustNum)
        Customer.Name = cName
        Customer.State = cState.
    
    /* Create order */
    CREATE Order.
    ASSIGN
        Order.OrderNum = NEXT-VALUE(OrderNum)
        Order.CustNum = Customer.CustNum
        Order.OrderDate = TODAY.
    
    /* Commit if all operations succeed */
    COMMIT.
END.
CATCH eError AS Progress.Lang.Error:
    /* Handle error */
    MESSAGE "Error: " + eError:GetMessage()
        VIEW-AS ALERT-BOX ERROR.
END CATCH.
```
"""
}

"query_best_practices" = {
  title = "Query Best Practices",
  description = """
When working with queries, follow these best practices:

1. Use the 'q' prefix for query names
2. Use appropriate lock modes
3. Include error handling
4. Close queries when done
5. Use WHERE clauses to limit records

```abl
/* Query definition and usage */
DEFINE QUERY qCustomer FOR Customer.
OPEN QUERY qCustomer FOR EACH Customer WHERE Customer.State = "CA" NO-LOCK.

GET FIRST qCustomer.
DO WHILE AVAILABLE Customer:
    DISPLAY Customer.Name.
    GET NEXT qCustomer.
END.

CLOSE QUERY qCustomer.
```
"""
}

[examples]
# Examples of ABL database operations

"buffer_example" = {
  title = "Buffer Usage Example",
  description = "Example of buffer usage in ABL",
  code = """
/* Buffer Definitions */
DEFINE BUFFER bCustomer FOR Customer.
DEFINE BUFFER bOrder FOR Order.
DEFINE BUFFER bOrderLine FOR OrderLine.

/* Procedure using buffers */
PROCEDURE ProcessCustomerOrders:
    DEFINE INPUT PARAMETER piCustNum AS INTEGER NO-UNDO.
    DEFINE OUTPUT PARAMETER poTotal AS DECIMAL NO-UNDO.
    
    /* Initialize total */
    ASSIGN poTotal = 0.
    
    /* Find the customer */
    FIND FIRST bCustomer WHERE bCustomer.CustNum = piCustNum NO-LOCK NO-ERROR.
    IF NOT AVAILABLE bCustomer THEN RETURN.
    
    /* Process orders */
    FOR EACH bOrder WHERE bOrder.CustNum = bCustomer.CustNum NO-LOCK:
        /* Display order header */
        DISPLAY
            bOrder.OrderNum
            bOrder.OrderDate
            bOrder.Status.
        
        /* Process order lines */
        FOR EACH bOrderLine WHERE bOrderLine.OrderNum = bOrder.OrderNum NO-LOCK:
            /* Calculate line total */
            var decimal dLineTotal = bOrderLine.Qty * bOrderLine.Price.
            
            /* Display order line */
            DISPLAY
                bOrderLine.LineNum
                bOrderLine.ItemNum
                bOrderLine.Qty
                bOrderLine.Price
                dLineTotal.
            
            /* Add to total */
            ASSIGN poTotal = poTotal + dLineTotal.
        END.
    END.
END PROCEDURE.

/* Usage */
var decimal dTotal.
RUN ProcessCustomerOrders (INPUT 1001, OUTPUT dTotal).
DISPLAY "Total:" dTotal.
"""
}

"temp_table_example" = {
  title = "Temp-Table Example",
  description = "Example of temp-table usage in ABL",
  code = """
/* Define temp-tables */
DEFINE TEMP-TABLE ttCustomer
    FIELD CustNum AS INTEGER
    FIELD Name AS CHARACTER
    FIELD State AS CHARACTER
    INDEX CustIdx CustNum.

DEFINE TEMP-TABLE ttOrder
    FIELD OrderNum AS INTEGER
    FIELD CustNum AS INTEGER
    FIELD OrderDate AS DATE
    FIELD Amount AS DECIMAL
    INDEX OrderIdx OrderNum
    INDEX CustIdx CustNum.

/* Procedure using temp-tables */
PROCEDURE LoadCustomerData:
    DEFINE INPUT PARAMETER piState AS CHARACTER NO-UNDO.
    
    /* Clear temp-tables */
    EMPTY TEMP-TABLE ttCustomer.
    EMPTY TEMP-TABLE ttOrder.
    
    /* Load customers */
    FOR EACH Customer WHERE Customer.State = piState NO-LOCK:
        /* Create temp-table record */
        CREATE ttCustomer.
        BUFFER-COPY Customer TO ttCustomer.
        
        /* Load orders for this customer */
        FOR EACH Order WHERE Order.CustNum = Customer.CustNum NO-LOCK:
            /* Create temp-table record */
            CREATE ttOrder.
            BUFFER-COPY Order TO ttOrder.
        END.
    END.
    
    /* Display summary */
    DISPLAY
        "Customers loaded:" SKIP
        COUNT(ttCustomer) "customers" SKIP
        COUNT(ttOrder) "orders".
END PROCEDURE.

/* Usage */
RUN LoadCustomerData (INPUT "CA").

/* Process loaded data */
FOR EACH ttCustomer:
    DISPLAY ttCustomer.Name.
    
    FOR EACH ttOrder WHERE ttOrder.CustNum = ttCustomer.CustNum:
        DISPLAY "  " ttOrder.OrderNum ttOrder.OrderDate ttOrder.Amount.
    END.
END.
"""
}

"dataset_example" = {
  title = "Dataset Example",
  description = "Example of dataset usage in ABL",
  code = """
/* Define temp-tables */
DEFINE TEMP-TABLE ttCustomer
    FIELD CustNum AS INTEGER
    FIELD Name AS CHARACTER
    FIELD State AS CHARACTER
    INDEX CustIdx CustNum.

DEFINE TEMP-TABLE ttOrder
    FIELD OrderNum AS INTEGER
    FIELD CustNum AS INTEGER
    FIELD OrderDate AS DATE
    FIELD Amount AS DECIMAL
    INDEX OrderIdx OrderNum
    INDEX CustIdx CustNum.

DEFINE TEMP-TABLE ttOrderLine
    FIELD OrderNum AS INTEGER
    FIELD LineNum AS INTEGER
    FIELD ItemNum AS INTEGER
    FIELD Qty AS INTEGER
    FIELD Price AS DECIMAL
    INDEX OrderIdx OrderNum LineNum.

/* Define dataset */
DEFINE DATASET dsCustomerOrders
    FOR ttCustomer, ttOrder, ttOrderLine
    DATA-RELATION relCustOrder
    FOR ttCustomer, ttOrder RELATION-FIELDS(CustNum, CustNum)
    NESTED
    DATA-RELATION relOrderLine
    FOR ttOrder, ttOrderLine RELATION-FIELDS(OrderNum, OrderNum)
    NESTED.

/* Procedure using dataset */
PROCEDURE LoadCustomerDataset:
    DEFINE INPUT PARAMETER piState AS CHARACTER NO-UNDO.
    
    /* Clear temp-tables */
    EMPTY TEMP-TABLE ttCustomer.
    EMPTY TEMP-TABLE ttOrder.
    EMPTY TEMP-TABLE ttOrderLine.
    
    /* Load customers */
    FOR EACH Customer WHERE Customer.State = piState NO-LOCK:
        /* Create customer record */
        CREATE ttCustomer.
        ASSIGN
            ttCustomer.CustNum = Customer.CustNum
            ttCustomer.Name = Customer.Name
            ttCustomer.State = Customer.State.
        
        /* Load orders */
        FOR EACH Order WHERE Order.CustNum = Customer.CustNum NO-LOCK:
            /* Create order record */
            CREATE ttOrder.
            ASSIGN
                ttOrder.OrderNum = Order.OrderNum
                ttOrder.CustNum = Order.CustNum
                ttOrder.OrderDate = Order.OrderDate
                ttOrder.Amount = Order.Amount.
            
            /* Load order lines */
            FOR EACH OrderLine WHERE OrderLine.OrderNum = Order.OrderNum NO-LOCK:
                /* Create order line record */
                CREATE ttOrderLine.
                ASSIGN
                    ttOrderLine.OrderNum = OrderLine.OrderNum
                    ttOrderLine.LineNum = OrderLine.LineNum
                    ttOrderLine.ItemNum = OrderLine.ItemNum
                    ttOrderLine.Qty = OrderLine.Qty
                    ttOrderLine.Price = OrderLine.Price.
            END.
        END.
    END.
    
    /* Display summary */
    DISPLAY
        "Dataset loaded:" SKIP
        COUNT(ttCustomer) "customers" SKIP
        COUNT(ttOrder) "orders" SKIP
        COUNT(ttOrderLine) "order lines".
END PROCEDURE.

/* Usage */
RUN LoadCustomerDataset (INPUT "CA").

/* Navigate the dataset */
FOR EACH ttCustomer:
    DISPLAY ttCustomer.Name.
    
    FOR EACH ttOrder OF ttCustomer:
        DISPLAY "  Order:" ttOrder.OrderNum ttOrder.OrderDate ttOrder.Amount.
        
        FOR EACH ttOrderLine OF ttOrder:
            var decimal dLineTotal = ttOrderLine.Qty * ttOrderLine.Price.
            DISPLAY "    Line:" ttOrderLine.LineNum ttOrderLine.ItemNum ttOrderLine.Qty ttOrderLine.Price dLineTotal.
        END.
    END.
END.
"""
}

"transaction_example" = {
  title = "Transaction Example",
  description = "Example of transaction handling in ABL",
  code = """
/* Transaction procedure */
PROCEDURE CreateCustomerOrder:
    DEFINE INPUT PARAMETER piCustNum AS INTEGER NO-UNDO.
    DEFINE INPUT PARAMETER pcItems AS CHARACTER NO-UNDO.  /* Comma-separated list of item numbers */
    DEFINE INPUT PARAMETER pcQtys AS CHARACTER NO-UNDO.   /* Comma-separated list of quantities */
    DEFINE OUTPUT PARAMETER poOrderNum AS INTEGER NO-UNDO.
    DEFINE OUTPUT PARAMETER poSuccess AS LOGICAL NO-UNDO.
    
    /* Local variables */
    var integer iOrderNum.
    var integer i.
    var integer iNumItems.
    var character cItem.
    var integer iQty.
    var decimal dPrice.
    var decimal dTotal = 0.
    
    /* Initialize output parameters */
    ASSIGN
        poOrderNum = 0
        poSuccess = FALSE.
    
    /* Count items */
    ASSIGN iNumItems = NUM-ENTRIES(pcItems).
    IF iNumItems <> NUM-ENTRIES(pcQtys) THEN DO:
        MESSAGE "Number of items and quantities must match"
            VIEW-AS ALERT-BOX ERROR.
        RETURN.
    END.
    
    /* Transaction block */
    DO TRANSACTION ON ERROR UNDO, THROW:
        /* Validate customer */
        FIND FIRST Customer WHERE Customer.CustNum = piCustNum NO-LOCK NO-ERROR.
        IF NOT AVAILABLE Customer THEN DO:
            MESSAGE "Customer not found"
                VIEW-AS ALERT-BOX ERROR.
            RETURN.
        END.
        
        /* Get next order number */
        ASSIGN iOrderNum = NEXT-VALUE(OrderNum).
        
        /* Create order header */
        CREATE Order.
        ASSIGN
            Order.OrderNum = iOrderNum
            Order.CustNum = piCustNum
            Order.OrderDate = TODAY
            Order.Status = "New".
        
        /* Create order lines */
        DO i = 1 TO iNumItems:
            /* Get item and quantity */
            ASSIGN
                cItem = ENTRY(i, pcItems)
                iQty = INTEGER(ENTRY(i, pcQtys)).
            
            /* Find item */
            FIND FIRST Item WHERE Item.ItemNum = INTEGER(cItem) NO-LOCK NO-ERROR.
            IF NOT AVAILABLE Item THEN DO:
                MESSAGE "Item not found: " + cItem
                    VIEW-AS ALERT-BOX ERROR.
                UNDO, LEAVE.
            END.
            
            /* Get price */
            ASSIGN dPrice = Item.Price.
            
            /* Create order line */
            CREATE OrderLine.
            ASSIGN
                OrderLine.OrderNum = iOrderNum
                OrderLine.LineNum = i
                OrderLine.ItemNum = INTEGER(cItem)
                OrderLine.Qty = iQty
                OrderLine.Price = dPrice.
            
            /* Add to total */
            ASSIGN dTotal = dTotal + (iQty * dPrice).
        END.
        
        /* Update order total */
        FIND Order WHERE Order.OrderNum = iOrderNum EXCLUSIVE-LOCK.
        ASSIGN Order.Amount = dTotal.
        
        /* Set output parameters */
        ASSIGN
            poOrderNum = iOrderNum
            poSuccess = TRUE.
        
        /* Commit the transaction */
        COMMIT.
    END.
    CATCH eError AS Progress.Lang.Error:
        /* Handle error */
        MESSAGE "Error creating order: " + eError:GetMessage()
            VIEW-AS ALERT-BOX ERROR.
        UNDO, LEAVE.
    END CATCH.
END PROCEDURE.

/* Usage */
var integer iOrderNum.
var logical lSuccess.

RUN CreateCustomerOrder (
    INPUT 1001,
    INPUT "1001,1002,1003",
    INPUT "2,3,1",
    OUTPUT iOrderNum,
    OUTPUT lSuccess
).

IF lSuccess THEN
    MESSAGE "Order created successfully. Order #: " + STRING(iOrderNum)
        VIEW-AS ALERT-BOX INFORMATION.
"""
}
