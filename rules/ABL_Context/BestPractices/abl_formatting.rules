# ABL Formatting Rules
# Contains formatting rules for ABL code

[formatting]
# Indentation rules
indent_size = 4
indent_style = "space"
indent_case_statements = true
indent_preprocessor = false

# Line length
max_line_length = 100

# Spacing rules
space_after_comma = true
space_after_semicolon = true
space_around_operators = true
space_before_blocks = true
space_before_parentheses = false
space_in_parentheses = false
space_in_brackets = false
space_in_braces = false

# Newline rules
newline_after_procedure = true
newline_after_function = true
newline_after_class = true
newline_after_method = true
newline_after_block = true
newline_after_statement = false

# Brace/block style
brace_style = "end_of_line"
block_style = "end_of_line"

# Case rules
keyword_case = "upper"
function_case = "lower"
variable_case = "lower"
property_case = "lower"
class_case = "pascal"
constant_case = "upper"
